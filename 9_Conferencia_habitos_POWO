base_powo <- taxon_powo_filtrado %>%
  
  select(
    
    nome_powo_normalizado,
    
    Nome_POWO =
      scientfiicname,
    
    Status_POWO =
      taxonomicstatus,
    
    LifeForm_POWO_original,
    
    LifeForm_POWO
  )


# ============================================================
# 20. PRIORIZAR O MELHOR REGISTRO
# ============================================================

# Se houver mais de um registro com o mesmo nome:
#
# 1. prioriza aquele com lifeform;
# 2. depois prioriza nome aceito;
# 3. depois sinônimo.

base_powo <- base_powo %>%
  
  mutate(
    
    possui_lifeform =
      !is.na(LifeForm_POWO),
    
    prioridade_status = case_when(
      
      str_to_lower(
        Status_POWO
      ) == "accepted" ~
        1L,
      
      str_to_lower(
        Status_POWO
      ) == "synonym" ~
        2L,
      
      TRUE ~
        3L
    )
  ) %>%
  
  arrange(
    
    nome_powo_normalizado,
    
    desc(
      possui_lifeform
    ),
    
    prioridade_status
  ) %>%
  
  distinct(
    nome_powo_normalizado,
    .keep_all = TRUE
  ) %>%
  
  select(
    -possui_lifeform,
    -prioridade_status
  )


