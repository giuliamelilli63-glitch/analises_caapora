# ============================================================
# 4. FUNÇÃO PARA NORMALIZAR NOMES BOTÂNICOS
# ============================================================

normalizar_nome <- function(nome) {
  
  nome %>%
    as.character() %>%
    str_replace_all("\u00A0", " ") %>%
    str_squish() %>%
    str_to_lower() %>%
    str_replace_all("×", "x") %>%
    str_replace_all("[[:punct:]]+$", "") %>%
    str_squish()
}


# ============================================================
# 5. FUNÇÃO PARA EXTRAIR O JSON DO POWO
# ============================================================

extrair_json_powo <- function(texto, campo) {
  
  if (
    is.na(texto) ||
      texto == "" ||
      str_trim(texto) == ""
  ) {
    return(NA_character_)
  }
  
  tryCatch(
    {
      
      objeto <- jsonlite::fromJSON(
        texto
      )
      
      valor <- objeto[[campo]]
      
      if (
        is.null(valor) ||
          length(valor) == 0
      ) {
        
        return(NA_character_)
      }
      
      valor <- as.character(valor)
      
      valor <- valor[
        !is.na(valor) &
          valor != ""
      ]
      
      if (length(valor) == 0) {
        
        return(NA_character_)
        
      } else {
        
        return(
          paste(
            unique(valor),
            collapse = "; "
          )
        )
      }
    },
    
    error = function(e) {
      
      NA_character_
    }
  )
}


# ============================================================
# 6. FUNÇÃO PARA PADRONIZAR A FORMA DE VIDA DO POWO
# ============================================================

# Converte a terminologia inglesa do POWO para o mesmo
# vocabulário usado pelo REFLORA.
#
# Exemplos:
#
# tree
#     -> Árvore
#
# shrub or tree
#     -> Arbusto; Árvore
#
# liana
#     -> Liana/volúvel/trepadeira
#
# shrub, tree, climber
#     -> Arbusto; Árvore; Liana/volúvel/trepadeira


padronizar_lifeform_powo <- function(x) {
  
  if (
    is.na(x) ||
      x == "" ||
      str_trim(x) == ""
  ) {
    return(NA_character_)
  }
  
  
  # ----------------------------------------------------------
  # Padronizar texto
  # ----------------------------------------------------------
  
  x <- x %>%
    str_to_lower() %>%
    str_replace_all("/", ",") %>%
    str_replace_all(";", ",") %>%
    str_replace_all("\\band\\b", ",") %>%
    str_replace_all("\\bor\\b", ",") %>%
    str_squish()
  
  
  # ----------------------------------------------------------
  # Separar diferentes formas de vida
  # ----------------------------------------------------------
  
  partes <- unlist(
    str_split(
      x,
      ","
    )
  )
  
  partes <- str_squish(
    partes
  )
  
  partes <- partes[
    partes != ""
  ]
  
  
  # ----------------------------------------------------------
  # Traduzir
  # ----------------------------------------------------------
  
  traduzidas <- map_chr(
    partes,
    
    function(valor) {
      
      case_when(
        
        # ----------------------------------------------------
        # SUBARBUSTO
        # Deve vir antes de shrub,
        # pois "subshrub" contém "shrub".
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "subshrub|sub-shrub|suffrutex|suffruticose"
        ) ~
          "Subarbusto",
        
        
        # ----------------------------------------------------
        # ÁRVORE
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "tree|arborescent"
        ) ~
          "Árvore",
        
        
        # ----------------------------------------------------
        # ARBUSTO
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "shrub|shrubby"
        ) ~
          "Arbusto",
        
        
        # ----------------------------------------------------
        # LIANA / VOLÚVEL / TREPADEIRA
        # ----------------------------------------------------
        
        str_detect(
          valor,
          paste0(
            "liana|",
            "climber|climbing|",
            "vine|vining|",
            "scandent|",
            "twiner|twining|",
            "voluble"
          )
        ) ~
          "Liana/volúvel/trepadeira",
        
        
        # ----------------------------------------------------
        # HEMIEPÍFITA
        # Deve vir antes de epiphyte.
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "hemiepiphyte|hemi-epiphyte|hemiepiphytic"
        ) ~
          "Hemiepífita",
        
        
        # ----------------------------------------------------
        # EPÍFITA
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "epiphyte|epiphytic"
        ) ~
          "Epífita",
        
        
        # ----------------------------------------------------
        # PALMEIRA
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "palm"
        ) ~
          "Palmeira",
        
        
        # ----------------------------------------------------
        # ERVA
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "herb|herbaceous|forb"
        ) ~
          "Erva",
        
        
        # ----------------------------------------------------
        # AQUÁTICA
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "aquatic"
        ) ~
          "Erva aquática",
        
        
        # ----------------------------------------------------
        # PARASITA
        # ----------------------------------------------------
        
        str_detect(
          valor,
          "parasite|parasitic"
        ) ~
          "Parasita",
        
        
        # ----------------------------------------------------
        # NÃO RECONHECIDO
        # ----------------------------------------------------
        
        TRUE ~
          NA_character_
      )
    }
  )
  
  
  # ----------------------------------------------------------
  # Remover categorias vazias
  # ----------------------------------------------------------
  
  traduzidas <- traduzidas[
    !is.na(traduzidas) &
      traduzidas != ""
  ]
  
  
  # ----------------------------------------------------------
  # Remover duplicatas
  # ----------------------------------------------------------
  
  traduzidas <- unique(
    traduzidas
  )
  
  
  # ----------------------------------------------------------
  # Resultado final
  # ----------------------------------------------------------
  
  if (length(traduzidas) == 0) {
    
    return(NA_character_)
    
  } else {
    
    return(
      paste(
        sort(traduzidas),
        collapse = "; "
      )
    )
  }
}


