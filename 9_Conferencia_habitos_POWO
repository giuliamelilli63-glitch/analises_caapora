      wb,
      aba,
      cols = 1:numero_colunas,
      widths = "auto"
    )
  }
}


# ============================================================
# 31. SALVAR
# ============================================================

saveWorkbook(
  wb,
  arquivo_saida,
  overwrite = TRUE
)


# ============================================================
# 32. MENSAGEM FINAL
# ============================================================

cat(
  "\nArquivo criado em:\n",
  arquivo_saida,
  "\n"
)

cat(
  "\nProcessamento concluído.\n"
)
