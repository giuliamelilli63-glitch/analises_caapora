# ============================================================
# PROJETO CAAPORÃ
# VARIÁVEIS TOPOGRÁFICAS
#
# ETAPA 1 - HYDROSHEDS CONDEM
#
# Objetivos:
# 1. Baixar HydroSHEDS v1.1 CONDEM 3s - América do Sul
# 2. Descompactar
# 3. Conferir o raster
# 4. Recortar para o Brasil
# 5. Agregar de 3s (~90 m) para 30s (~1 km)
# 6. Salvar DEM topográfico de referência
#
# Fonte:
# HydroSHEDS v1.1
# Hydrologically Conditioned DEM
# ============================================================


# ------------------------------------------------------------
# 0. Pacotes
# ------------------------------------------------------------

pacotes <- c(
  "terra",
  "geodata"
)

instalar <- pacotes[
  !pacotes %in% installed.packages()[, "Package"]
]

if (length(instalar) > 0) {
  install.packages(instalar)
}

library(terra)
library(geodata)


# ------------------------------------------------------------
# 1. Pastas
# ------------------------------------------------------------

pasta_base <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis/topografia/HydroSHEDS"
)

pasta_download <- file.path(
  pasta_base,
  "01_download"
)

pasta_extraido <- file.path(
  pasta_base,
  "02_extraido"
)

pasta_brasil_3s <- file.path(
  pasta_base,
  "03_brasil_3s"
)

pasta_brasil_30s <- file.path(
  pasta_base,
  "04_brasil_30s"
)

pasta_limite <- file.path(
  pasta_base,
  "limite_brasil"
)


dir.create(
  pasta_download,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  pasta_extraido,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  pasta_brasil_3s,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  pasta_brasil_30s,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  pasta_limite,
  recursive = TRUE,
  showWarnings = FALSE
)


# ------------------------------------------------------------
# 2. Pasta temporária do terra
# ------------------------------------------------------------

pasta_temp <- "C:/temp_terra"

dir.create(
  pasta_temp,
  recursive = TRUE,
  showWarnings = FALSE
)

terraOptions(
  tempdir = pasta_temp,
  memfrac = 0.6,
  progress = 1
)

terraOptions()


# ------------------------------------------------------------
# 3. URL oficial HydroSHEDS
# ------------------------------------------------------------

url_hydrosheds <- paste0(
  "https://data.hydrosheds.org/file/",
  "hydrosheds-v1-con/",
  "sa_con_3s.zip"
)


arquivo_zip <- file.path(
  pasta_download,
  "sa_con_3s.zip"
)


# ------------------------------------------------------------
# 4. Baixar HydroSHEDS CONDEM
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "HYDROSHEDS CONDEM 3s\n",
  "========================================\n",
  "Arquivo: sa_con_3s.zip\n",
  "Região: América do Sul\n",
  "Resolução: 3 arc-seconds (~90 m)\n",
  "========================================\n"
)


if (!file.exists(arquivo_zip)) {
  
  cat(
    "\nIniciando download...\n"
  )
  
  download.file(
    url = url_hydrosheds,
    destfile = arquivo_zip,
    mode = "wb",
    method = "libcurl",
    quiet = FALSE
  )
  
} else {
  
  cat(
    "\nArquivo ZIP já existe. Download ignorado.\n"
  )
  
}


# ------------------------------------------------------------
# 5. Conferir tamanho do download
# ------------------------------------------------------------

tamanho_zip <- file.info(
  arquivo_zip
)$size / 1024^3


cat(
  "\nTamanho do arquivo ZIP:",
  round(tamanho_zip, 2),
  "GB\n"
)


# ------------------------------------------------------------
# 6. Descompactar
# ------------------------------------------------------------

cat(
  "\nDescompactando HydroSHEDS...\n"
)

unzip(
  arquivo_zip,
  exdir = pasta_extraido
)


# ------------------------------------------------------------
# 7. Procurar raster extraído
# ------------------------------------------------------------

arquivos_raster <- list.files(
  pasta_extraido,
  pattern = "\\.(tif|tiff)$",
  full.names = TRUE,
  recursive = TRUE,
  ignore.case = TRUE
)


cat(
  "\nRasters encontrados:",
  length(arquivos_raster),
  "\n"
)

print(
  basename(arquivos_raster)
)


if (length(arquivos_raster) == 0) {
  
  stop(
    "Nenhum GeoTIFF foi encontrado após a descompactação."
  )
  
}


# ------------------------------------------------------------
# 8. Abrir DEM
# ------------------------------------------------------------

dem_3s <- rast(
  arquivos_raster[1]
)

names(dem_3s) <- "elevation"


# ------------------------------------------------------------
# 9. Conferir DEM original
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "HYDROSHEDS ORIGINAL\n",
  "========================================\n"
)

print(
  dem_3s
)

cat(
  "\nResolução:\n"
)

print(
  res(dem_3s)
)

cat(
  "\nCRS:\n"
)

print(
  crs(dem_3s)
)

cat(
  "\nExtensão:\n"
)

print(
  ext(dem_3s)
)


# ------------------------------------------------------------
# 10. Limite do Brasil
# ------------------------------------------------------------

brasil <- geodata::gadm(
  country = "BRA",
  level = 0,
  path = pasta_limite
)


# ------------------------------------------------------------
# 11. Mesmo CRS
# ------------------------------------------------------------

brasil_hydro <- project(
  brasil,
  crs(dem_3s)
)


# ------------------------------------------------------------
# 12. Recortar primeiro pela extensão
# ------------------------------------------------------------

cat(
  "\nRecortando HydroSHEDS para a extensão do Brasil...\n"
)


arquivo_crop <- file.path(
  pasta_brasil_3s,
  "HydroSHEDS_CONDEM_3s_Brasil_crop.tif"
)


dem_crop <- crop(
  dem_3s,
  brasil_hydro,
  filename = arquivo_crop,
  overwrite = TRUE
)


# ------------------------------------------------------------
# 13. Máscara Brasil
# ------------------------------------------------------------

cat(
  "\nAplicando máscara territorial...\n"
)


arquivo_dem_3s <- file.path(
  pasta_brasil_3s,
  "HydroSHEDS_CONDEM_3s_Brasil.tif"
)


dem_brasil_3s <- mask(
  dem_crop,
  brasil_hydro,
  filename = arquivo_dem_3s,
  overwrite = TRUE
)

names(
  dem_brasil_3s
) <- "elevation"


# ------------------------------------------------------------
# 14. Conferir resolução do raster recortado
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "CONDEM BRASIL 3s\n",
  "========================================\n"
)

print(
  dem_brasil_3s
)

cat(
  "\nResolução:\n"
)

print(
  res(dem_brasil_3s)
)


# ------------------------------------------------------------
# 15. Agregar 3s -> 30s
# ------------------------------------------------------------
#
# 30 arc-seconds / 3 arc-seconds = fator 10
#
# Cada nova célula representa aproximadamente
# 10 x 10 = 100 células originais.
#
# Para elevação utilizamos a média.
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "AGREGANDO 3s -> 30s\n",
  "========================================\n"
)


arquivo_dem_30s <- file.path(
  pasta_brasil_30s,
  "HydroSHEDS_CONDEM_30s_Brasil.tif"
)


dem_brasil_30s <- aggregate(
  dem_brasil_3s,
  fact = 10,
  fun = mean,
  na.rm = TRUE,
  filename = arquivo_dem_30s,
  overwrite = TRUE
)

names(
  dem_brasil_30s
) <- "elevation"


# ------------------------------------------------------------
# 16. Conferência final
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "HYDROSHEDS 30s - BRASIL\n",
  "========================================\n"
)

print(
  dem_brasil_30s
)


cat(
  "\nResolução final:\n"
)

print(
  res(dem_brasil_30s)
)


cat(
  "\nCRS:\n"
)

print(
  crs(dem_brasil_30s)
)


cat(
  "\nExtensão:\n"
)

print(
  ext(dem_brasil_30s)
)


cat(
  "\nElevação mínima e máxima:\n"
)

print(
  minmax(
    dem_brasil_30s
  )
)


# ------------------------------------------------------------
# 17. Visualização
# ------------------------------------------------------------

plot(
  dem_brasil_30s,
  main = "HydroSHEDS CONDEM 30s - Brasil"
)

lines(
  brasil_hydro,
  lwd = 0.5
)


# ------------------------------------------------------------
# 18. Resultado
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "PROCESSAMENTO CONCLUÍDO\n",
  "========================================\n",
  "\nDEM original:",
  "\nHydroSHEDS CONDEM v1.1 - 3 arc-seconds",
  "\n\nDEM Brasil 3s:\n",
  arquivo_dem_3s,
  "\n\nDEM Brasil 30s:\n",
  arquivo_dem_30s,
  "\n",
  sep = ""
)

