# Se qualquer nome original consolidado estiver na lista
# de sem correspondência, a linha é marcada para conferência.
#
# Como a harmonização consolidou somente nomes válidos em
# "especie", em princípio esses casos devem ser poucos ou zero.
# ============================================================

ids_sem_correspondencia <- nomes_originais_longos %>%
  
  filter(
    
    chave_original %in%
      sem_correspondencia_anterior$
      chave_sem_correspondencia
    
  ) %>%
  
  distinct(
    id_linha
  )


