      row_number()
    
  )


nomes_originais_longos <- matriz_completas %>%
  
  select(
    id_linha,
    especie_original
  ) %>%
  
  tidyr::separate_rows(
    especie_original,
    sep = "\\s*\\|\\s*"
  ) %>%
  
  mutate(
    
    chave_original =
      normalizar_nome(
        especie_original
      )
    
  )


# ============================================================
# 13. IDENTIFICAR LINHAS QUE CONTÊM NOME SEM CORRESPONDÊNCIA
