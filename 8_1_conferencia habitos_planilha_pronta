normalizar_nome <- function(x) {
  
  x <- as.character(x)
  
  x <- iconv(
    x,
    from = "",
    to = "ASCII//TRANSLIT",
    sub = ""
  )
  
  x <- tolower(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "[[:space:]]+",
    " ",
    x
  )
  
  x <- trimws(x)
  
  x[x == ""] <- NA_character_
  
  x
}


sem_correspondencia_anterior <-
  sem_correspondencia_anterior %>%
  
  mutate(
    
    chave_sem_correspondencia =
      normalizar_nome(
        especie_original
      )
    
  )


# ============================================================
# 12. EXPLODIR nomes originais consolidados
#
# A matriz final pode ter:
#
# especie_original =
# "vismia_macrophyla | vismia_macrophylla"
#
# Precisamos verificar cada nome original separadamente.
# ============================================================

matriz_completas <- matriz_completas %>%
  
