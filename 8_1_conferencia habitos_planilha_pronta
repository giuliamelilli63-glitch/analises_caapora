            )
          ) != "" ~

          as.character(
            Genero_REFLORA
          ),

        TRUE ~

          word(
            as.character(
              Nome_POWO
            ),
            1
          )

      ),

    LifeForm =
      as.character(
        LifeForm_FINAL
      ),

    fonte_cruzamento =
      "POWO_nome_encontrado"

  )


# ============================================================
# 13. UNIR OS TRÊS LOOKUPS
# ============================================================

lookup_taxonomia <- bind_rows(

  lookup_reflora,

  lookup_powo_aceito,

  lookup_powo_nome

) %>%

  filter(

    !is.na(
      chave_taxonomica
    ),

    chave_taxonomica != ""

  )


# ============================================================
# 14. LIMPAR CAMPOS VAZIOS
# ============================================================

lookup_taxonomia <- lookup_taxonomia %>%

  mutate(

    familia =
      na_if(
        str_squish(
          familia
        ),
        ""
      ),

    genero =
      na_if(
        str_squish(
          genero
        ),
        ""
      ),

    LifeForm =
      na_if(
        str_squish(
          LifeForm
        ),
        ""
      )

  )


# ============================================================
# 15. CRIAR PRIORIDADE
#
# Primeiro:
# registro com mais informações
#
# Em caso de empate:
#
# REFLORA
# POWO nome aceito
# POWO nome encontrado
# ============================================================

lookup_taxonomia <- lookup_taxonomia %>%

  mutate(

    completude =

      as.integer(
        !is.na(
          familia
        )
      ) +

      as.integer(
        !is.na(
          genero
        )
      ) +

      as.integer(
        !is.na(
          LifeForm
        )
      ),

    prioridade_fonte =
      case_when(

        fonte_cruzamento ==
          "REFLORA" ~

          1L,

        fonte_cruzamento ==
          "POWO_nome_aceito" ~

          2L,

        fonte_cruzamento ==
          "POWO_nome_encontrado" ~

          3L,

        TRUE ~

          4L

      )

  )


# ============================================================
# 16. CONFERIR CONFLITOS ANTES DE REDUZIR
#
# Mesmo nome apontando para:
# - famílias diferentes
# - gêneros diferentes
# - LifeForms diferentes
# ============================================================

conflitos <- lookup_taxonomia %>%

  group_by(
    chave_taxonomica
  ) %>%

  summarise(

    numero_registros =
      n(),

    numero_familias =
      n_distinct(
        familia,
        na.rm = TRUE
      ),

    familias =
      paste(
        sort(
          unique(
            na.omit(
              familia
            )
          )
        ),
        collapse = " | "
      ),

    numero_generos =
      n_distinct(
        genero,
        na.rm = TRUE
      ),

    generos =
      paste(
        sort(
          unique(
            na.omit(
              genero
            )
          )
        ),
        collapse = " | "
      ),

    numero_lifeforms =
      n_distinct(
        LifeForm,
        na.rm = TRUE
      ),

    lifeforms =
      paste(
        sort(
          unique(
            na.omit(
              LifeForm
            )
          )
        ),
        collapse = " | "
      ),

    fontes =
      paste(
        sort(
          unique(
            fonte_cruzamento
          )
        ),
        collapse = " | "
      ),

    .groups = "drop"

  ) %>%

  filter(

    numero_familias > 1 |

      numero_generos > 1 |

      numero_lifeforms > 1

  )


cat(
  "\nChaves com informações conflitantes:",
  nrow(
    conflitos
  ),
  "\n"
)


# ============================================================
# 17. DEIXAR UMA LINHA POR CHAVE
# ============================================================

lookup_taxonomia_final <- lookup_taxonomia %>%

  arrange(

    chave_taxonomica,

    desc(
      completude
    ),

    prioridade_fonte

  ) %>%

  distinct(

    chave_taxonomica,

    .keep_all = TRUE

  ) %>%

  select(

    chave_taxonomica,

    familia,

    genero,

    LifeForm,

    fonte_cruzamento

  )


# ============================================================
# 18. CRUZAR MATRIZ + TAXONOMIA
# ============================================================

matriz_cruzada <- matriz %>%

  left_join(

    lookup_taxonomia_final,

    by =
      "chave_taxonomica"

  )


# ============================================================
# 19. RESULTADO DO CRUZAMENTO
# ============================================================

matriz_cruzada <- matriz_cruzada %>%

  mutate(

    encontrou_taxonomia =

      !is.na(
        familia
      ) |

      !is.na(
        genero
      ) |

      !is.na(
        LifeForm
      ),

    encontrou_familia =
      !is.na(
        familia
      ),

    encontrou_genero =
      !is.na(
        genero
      ),

    encontrou_lifeform =
      !is.na(
        LifeForm
      )

  )


# ============================================================
# 20. ESPÉCIES SEM CRUZAMENTO
# ============================================================

nao_cruzaram <- matriz_cruzada %>%

  filter(
    !encontrou_taxonomia
  ) %>%

  select(

    especie_original,

    especie,

    identificacao,

    chave_taxonomica

  ) %>%

  arrange(
    especie
  )


# ============================================================
# 21. ESPÉCIES SEM FAMÍLIA
# ============================================================

sem_familia <- matriz_cruzada %>%

  filter(
    !encontrou_familia
  ) %>%

  select(

    especie_original,

    especie,

    genero,

    LifeForm,

    fonte_cruzamento

  ) %>%

  arrange(
    especie
  )


# ============================================================
# 22. ESPÉCIES SEM GÊNERO
# ============================================================

sem_genero <- matriz_cruzada %>%

  filter(
    !encontrou_genero
  ) %>%

  select(

    especie_original,

    especie,

    familia,

    LifeForm,

    fonte_cruzamento

  ) %>%

  arrange(
    especie
  )


# ============================================================
# 23. ESPÉCIES SEM LIFEFORM
# ============================================================

sem_lifeform <- matriz_cruzada %>%

  filter(
    !encontrou_lifeform
  ) %>%

  select(

    especie_original,

    especie,

    familia,

    genero,

    fonte_cruzamento

  ) %>%

  arrange(
    especie
  )


# ============================================================
# 24. CASOS CRUZADOS VIA POWO
#
# Útil para verificar casos como Alchornea floribunda
# ============================================================

cruzados_powo <- matriz_cruzada %>%

  filter(

    fonte_cruzamento %in%
      c(
        "POWO_nome_aceito",
        "POWO_nome_encontrado"
      )

  ) %>%

  select(

    especie_original,

    especie,

    familia,

    genero,

    LifeForm,

    fonte_cruzamento

  ) %>%

  arrange(
    especie
  )


# ============================================================
# 25. MATRIZ FINAL
#
# Fonte do cruzamento NÃO entra.
#
# Ordem:
#
# especie_original
# familia
# genero
# especie
# identificacao
# LifeForm
# inventários
# ============================================================

matriz_final <- matriz_cruzada %>%

  select(

    especie_original,

    familia,

    genero,

    especie,

    identificacao,

    LifeForm,

    all_of(
      colunas_inventarios
    )

  )


# ============================================================
# 26. CONFERIR DUPLICAÇÕES FINAIS
# ============================================================

duplicacoes_finais <- matriz_final %>%

  count(

    especie,

    name =
      "numero_linhas"

  ) %>%

  filter(
    numero_linhas > 1
  )


cat(
  "\nDuplicações na matriz final:",
  nrow(
    duplicacoes_finais
  ),
  "\n"
)


# ============================================================
# 27. CONFERIR VALORES DA MATRIZ DE OCORRÊNCIA
# ============================================================

valores_inventarios <- unlist(

  matriz_final[
    ,
    colunas_inventarios,
    drop = FALSE
  ],

  use.names = FALSE

)


valores_invalidos <- valores_inventarios[

  !is.na(
    valores_inventarios
  ) &

    !(
      valores_inventarios %in%
        c(
          0,
          1
        )
    )

]


cat(
  "Valores diferentes de 0 e 1:",
  length(
    valores_invalidos
  ),
  "\n"
)


if (
  length(
    valores_invalidos
  ) > 0
) {

  stop(
    "Existem valores diferentes de 0 ou 1 nos inventários."
  )
}


# ============================================================
# 28. RESUMO
# ============================================================

resumo <- data.frame(

