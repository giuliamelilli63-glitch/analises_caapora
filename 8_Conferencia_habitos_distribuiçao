# ------------------------------------------------------------
# 25. FUNÇÃO PARA ESCREVER AS ABAS DO EXCEL
# ------------------------------------------------------------

adicionar_aba <- function(
    workbook,
  nome_aba,
  dados,
  estilo = "TableStyleMedium2"
) {
  
  addWorksheet(
    workbook,
    nome_aba
  )
  
  if (nrow(dados) > 0) {
    
    writeDataTable(
      workbook,
      nome_aba,
      dados,
      tableStyle = estilo
    )
    
  } else {
    
    writeData(
      workbook,
      nome_aba,
      "Nenhum registro encontrado."
    )
  }
  
  freezePane(
    workbook,
    nome_aba,
    firstRow = TRUE
  )
  
  if (ncol(dados) > 0) {
    
    setColWidths(
      workbook,
      nome_aba,
      cols = 1:ncol(dados),
      widths = "auto"
    )
  }
}


