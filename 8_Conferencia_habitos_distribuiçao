# ------------------------------------------------------------
# 4. FUNÇÃO PARA NORMALIZAR NOMES BOTÂNICOS
# ------------------------------------------------------------

normalizar_nome <- function(nome) {
  
  nome %>%
    as.character() %>%
    str_replace_all("\u00A0", " ") %>%
    str_squish() %>%
    str_to_lower() %>%
    str_replace_all("×", "x") %>%
    str_replace_all("[[:punct:]]+$", "") %>%
    str_squish()
}


# ------------------------------------------------------------
# 5. FUNÇÃO PARA EXTRAIR CAMPOS JSON
# ------------------------------------------------------------

extrair_json <- function(texto_json, campo) {
  
  if (
    is.na(texto_json) ||
      texto_json == "" ||
      str_trim(texto_json) == ""
  ) {
    return(NA_character_)
  }
  
  resultado <- tryCatch(
    
    {
      
      objeto <- jsonlite::fromJSON(texto_json)
      
      valores <- objeto[[campo]]
      
      if (
        is.null(valores) ||
          length(valores) == 0
      ) {
        
        NA_character_
        
      } else {
        
        valores <- as.character(valores)
        
        valores <- valores[
          !is.na(valores) &
            valores != ""
        ]
        
        if (length(valores) == 0) {
          
          NA_character_
          
        } else {
          
          paste(
            unique(valores),
            collapse = "; "
          )
        }
      }
    },
    
    error = function(e) {
      NA_character_
    }
  )
  
  return(resultado)
}


# ------------------------------------------------------------
# 6. FUNÇÃO PARA JUNTAR VALORES ÚNICOS
# ------------------------------------------------------------

juntar_valores <- function(x) {
  
  x <- as.character(x)
  
  x <- x[
    !is.na(x) &
      x != "" &
      str_trim(x) != ""
  ]
  
  if (length(x) == 0) {
    
    return(NA_character_)
    
  } else {
    
    return(
      paste(
        sort(unique(x)),
        collapse = "; "
      )
    )
  }
}


