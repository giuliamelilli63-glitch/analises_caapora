# ============================================================
# 1. CARREGAR PACOTE
# ============================================================

library(readxl)

# ============================================================
# 2. DEFINIR CAMINHOS
# ============================================================

arquivo_inventario <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "filtragem_riqueza/inventario_completo_sem_indeterminadas.csv"
)

arquivo_metadados <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "filtragem_riqueza/caapora.xlsx"
)

pasta_saida <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "filtragem_riqueza"
)

# ============================================================
# 3. LER OS ARQUIVOS
# ============================================================

dados <- read.csv2(
  arquivo_inventario,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)

caapora <- read_excel(
  arquivo_metadados
)

caapora <- as.data.frame(
  caapora,
  check.names = FALSE
)

# ============================================================
# 4. PADRONIZAR NOMES
# ============================================================

names(dados) <- trimws(names(dados))

caapora$ponto <- trimws(
  as.character(caapora$ponto)
)

# Localizar a coluna especie pelo nome
col_especie <- which(
  tolower(trimws(names(dados))) == "especie"
)

if (length(col_especie) != 1) {
  stop(
    "A coluna 'especie' não foi encontrada ou está duplicada."
  )
}

cat(
  "Coluna de espécies encontrada:",
  names(dados)[col_especie],
  "\n"
)

# ============================================================
# 5. IDENTIFICAR SOMENTE AS COLUNAS DOS INVENTÁRIOS
# ============================================================

# As colunas de inventários são aquelas cujos nomes aparecem
# na coluna ponto da tabela caapora
colunas_inventarios <- which(
  names(dados) %in% caapora$ponto
)

if (length(colunas_inventarios) == 0) {
  stop(
    "Nenhuma coluna de inventário foi encontrada na matriz."
  )
}

nomes_inventarios <- names(dados)[colunas_inventarios]

cat(
  "Número de inventários encontrados na matriz:",
  length(nomes_inventarios),
  "\n"
)

# ============================================================
# 6. CONVERTER ÁREA AMOSTRADA PARA NÚMERO
# ============================================================

caapora$`area-amostrada-ha` <- suppressWarnings(
  as.numeric(
    gsub(
      ",",
      ".",
      as.character(caapora$`area-amostrada-ha`),
      fixed = TRUE
    )
  )
)

# ============================================================
# 7. ASSOCIAR ÁREA A CADA INVENTÁRIO
# ============================================================

areas <- caapora$`area-amostrada-ha`[
  match(
    nomes_inventarios,
    caapora$ponto
  )
]

cat("\nÁreas encontradas:\n")
print(sort(unique(areas)))

inventarios_sem_area <- nomes_inventarios[
  is.na(areas)
]

cat(
  "\nNúmero de inventários sem área encontrada:",
  length(inventarios_sem_area),
  "\n"
)

if (length(inventarios_sem_area) > 0) {
  print(inventarios_sem_area)
}

# ============================================================
# 8. SELECIONAR PARCELAS DE 1 HECTARE
# ============================================================

parcelas_1ha <- which(
  !is.na(areas) &
  abs(areas - 1) < 0.0001
)

cat(
  "\nNúmero de parcelas de 1 ha:",
  length(parcelas_1ha),
  "\n"
)

if (length(parcelas_1ha) == 0) {
  stop("Nenhuma parcela de 1 ha foi encontrada.")
}

if (length(parcelas_1ha) < 10) {
  stop("Existem menos de 10 parcelas de 1 ha.")
}

nomes_parcelas_1ha <- nomes_inventarios[
  parcelas_1ha
]

cat("\nParcelas de 1 ha:\n")
print(nomes_parcelas_1ha)

# ============================================================
# 9. EXTRAIR E CONVERTER OS DADOS DAS PARCELAS DE 1 HA
# ============================================================

dados_1ha <- dados[
  ,
  nomes_parcelas_1ha,
  drop = FALSE
]

dados_1ha[] <- lapply(
  dados_1ha,
  function(x) {
    suppressWarnings(
      as.numeric(
        gsub(
          ",",
          ".",
          as.character(x),
          fixed = TRUE
        )
      )
    )
  }
)

dados_1ha[is.na(dados_1ha)] <- 0

# ============================================================
# 10. CALCULAR RIQUEZA DAS PARCELAS DE 1 HA
# ============================================================

riqueza_1ha <- colSums(
  dados_1ha > 0,
  na.rm = TRUE
)

resultado_1ha <- data.frame(
  Parcela = names(riqueza_1ha),
  Riqueza = as.numeric(riqueza_1ha),
  stringsAsFactors = FALSE
)

resultado_1ha <- resultado_1ha[
  order(resultado_1ha$Riqueza),
  ,
  drop = FALSE
]

cat("\nRiqueza das parcelas de 1 ha:\n")
print(resultado_1ha)

# ============================================================
# 11. CALCULAR A MÉDIA DAS 10 MENORES E 10 MAIORES
# ============================================================

dez_menores <- head(
  resultado_1ha,
  10
)

dez_maiores <- tail(
  resultado_1ha,
  10
)

media_10_menores <- mean(
  dez_menores$Riqueza,
  na.rm = TRUE
)

media_10_maiores <- mean(
  dez_maiores$Riqueza,
  na.rm = TRUE
)

cat(
  "\nMédia das 10 menores riquezas:",
  media_10_menores,
  "espécies\n"
)

cat(
  "Média das 10 maiores riquezas:",
  media_10_maiores,
  "espécies\n"
)

cat("\nDez menores riquezas:\n")
print(dez_menores)

cat("\nDez maiores riquezas:\n")
print(dez_maiores)

# ============================================================
# 12. CALCULAR A RIQUEZA DE TODOS OS INVENTÁRIOS
# ============================================================

todos_inventarios <- dados[
  ,
  colunas_inventarios,
  drop = FALSE
]

todos_inventarios[] <- lapply(
  todos_inventarios,
  function(x) {
    suppressWarnings(
      as.numeric(
        gsub(
          ",",
          ".",
          as.character(x),
          fixed = TRUE
        )
      )
    )
  }
)

todos_inventarios[is.na(todos_inventarios)] <- 0

riqueza_todos <- colSums(
  todos_inventarios > 0,
  na.rm = TRUE
)

resultado_todos <- data.frame(
  Parcela = names(riqueza_todos),
  Riqueza = as.numeric(riqueza_todos),
  stringsAsFactors = FALSE
)

resultado_todos <- resultado_todos[
  order(resultado_todos$Riqueza),
  ,
  drop = FALSE
]

# ============================================================
# 13. APLICAR A FAIXA DE RIQUEZA A TODOS OS INVENTÁRIOS
# ============================================================

inventarios_selecionados <- resultado_todos[
  resultado_todos$Riqueza >= media_10_menores &
  resultado_todos$Riqueza <= media_10_maiores,
  ,
  drop = FALSE
]

inventarios_excluidos <- resultado_todos[
  resultado_todos$Riqueza < media_10_menores |
  resultado_todos$Riqueza > media_10_maiores,
  ,
  drop = FALSE
]

cat(
  "\nTotal de inventários:",
  nrow(resultado_todos),
  "\n"
)

cat(
  "Inventários selecionados:",
  nrow(inventarios_selecionados),
  "\n"
)

cat(
  "Inventários excluídos:",
  nrow(inventarios_excluidos),
  "\n"
)

if (nrow(inventarios_selecionados) == 0) {
  stop(
    "Nenhum inventário ficou dentro da faixa de riqueza."
  )
}

cat("\nInventários selecionados:\n")
print(inventarios_selecionados)

cat("\nInventários excluídos:\n")
print(inventarios_excluidos)

# ============================================================
# 14. CRIAR A MATRIZ COM ESPÉCIES E INVENTÁRIOS SELECIONADOS
# ============================================================

nomes_selecionados <- inventarios_selecionados$Parcela

posicoes_selecionadas <- match(
  nomes_selecionados,
  names(dados)
)

if (any(is.na(posicoes_selecionadas))) {
  stop(
    "Alguns inventários selecionados não foram encontrados na matriz."
  )
}

# Manter a coluna especie e os inventários selecionados
matriz_selecionada <- dados[
  ,
  c(col_especie, posicoes_selecionadas),
  drop = FALSE
]

# Garantir que a primeira coluna tenha o nome especie
names(matriz_selecionada)[1] <- "especie"

# ============================================================
# 15. REMOVER ESPÉCIES SEM OCORRÊNCIA APÓS O FILTRO
# ============================================================

matriz_ocorrencias <- matriz_selecionada[
  ,
  -1,
  drop = FALSE
]

matriz_ocorrencias[] <- lapply(
  matriz_ocorrencias,
  function(x) {
    suppressWarnings(
      as.numeric(
        gsub(
          ",",
          ".",
          as.character(x),
          fixed = TRUE
        )
      )
    )
  }
)

matriz_ocorrencias[is.na(matriz_ocorrencias)] <- 0

manter_especie <- rowSums(
  matriz_ocorrencias > 0,
  na.rm = TRUE
) > 0

especies_excluidas <- matriz_selecionada[
  !manter_especie,
  ,
  drop = FALSE
]

matriz_final <- matriz_selecionada[
  manter_especie,
  ,
  drop = FALSE
]

cat(
  "\nNúmero de espécies antes da remoção das linhas vazias:",
  nrow(matriz_selecionada),
  "\n"
)

cat(
  "Espécies removidas por ausência nos inventários selecionados:",
  nrow(especies_excluidas),
  "\n"
)

cat(
  "Número final de espécies:",
  nrow(matriz_final),
  "\n"
)

cat(
  "Número final de inventários:",
  ncol(matriz_final) - 1,
  "\n"
)

# Conferir as primeiras linhas da matriz final
cat("\nPrimeiras linhas da matriz final:\n")
print(
  head(
    matriz_final[, 1:min(6, ncol(matriz_final))]
  )
)

# ============================================================
# 16. SALVAR OS RESULTADOS
# ============================================================

write.csv2(
  resultado_1ha,
  file.path(
    pasta_saida,
    "riqueza_parcelas_1ha.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv2(
  dez_menores,
  file.path(
    pasta_saida,
    "dez_menores_riquezas_1ha.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv2(
  dez_maiores,
  file.path(
    pasta_saida,
    "dez_maiores_riquezas_1ha.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv2(
  resultado_todos,
  file.path(
    pasta_saida,
    "riqueza_todos_inventarios.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv2(
  inventarios_selecionados,
  file.path(
    pasta_saida,
    "inventarios_selecionados_por_riqueza.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv2(
  inventarios_excluidos,
  file.path(
    pasta_saida,
    "inventarios_excluidos_por_riqueza.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

write.csv2(
  especies_excluidas,
  file.path(
    pasta_saida,
    "especies_sem_ocorrencia_apos_filtro.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

# Tabela principal: espécie + inventários selecionados
write.csv2(
  matriz_final,
  file.path(
    pasta_saida,
    "matriz_filtrada_por_faixa_de_riqueza.csv"
  ),
  row.names = FALSE,
  fileEncoding = "UTF-8"
)

cat(
  "\nArquivos salvos em:\n",
  pasta_saida,
  "\n"
)

cat(
  "\nA tabela principal foi salva como:\n",
  "matriz_filtrada_por_faixa_de_riqueza.csv\n"
)

cat(
  "A primeira coluna dessa tabela é 'especie'.\n"
)
