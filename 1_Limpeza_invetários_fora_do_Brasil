# ============================================================
# SCRIPT 01
# FILTRO ESPACIAL DOS INVENTÁRIOS DO BRASIL
# MATRIZ DE OCORRÊNCIA
#
# Critério:
#   - usar longitude e latitude da base de referências
#   - manter somente inventários localizados dentro do Brasil
#
# Após o filtro:
#   - remover espécies sem ocorrência
#   - remover temporariamente:
#       familia
#       genero
#       identificacao
#
# Resultado:
#   especie + inventários brasileiros
# ============================================================


# ============================================================
# 0. PACOTES
# ============================================================

library(sf)
library(readxl)


# ============================================================
# 1. CAMINHOS
# ============================================================

pasta_caapora <- "C:/Users/giuli/OneDrive/Documentos/Caapora"


# ------------------------------------------------------------
# Matriz original de ocorrência
# ------------------------------------------------------------

arquivo_matriz <- file.path(
  pasta_caapora,
  "Matrizes_ocorrência",
  "Matriz_original_ocorrencia.csv"
)


# ------------------------------------------------------------
# Base de referência dos inventários
# ------------------------------------------------------------

arquivo_metadados <- file.path(
  pasta_caapora,
  "Matriz_refencia",
  "caapora_base_referencias.xlsx"
)


# ------------------------------------------------------------
# Pasta do shapefile do Brasil
# ------------------------------------------------------------

pasta_shape_brasil <- file.path(
  pasta_caapora,
  "shapefiles",
  "BR_Pais_2025"
)


# ------------------------------------------------------------
# Arquivo de saída
# ------------------------------------------------------------

arquivo_saida <- file.path(
  pasta_caapora,
  "Matrizes_ocorrência",
  "Matriz_original_ocorrencia_brasil.csv"
)


# ============================================================
# 2. CONFERIR ARQUIVOS
# ============================================================

if (!file.exists(arquivo_matriz)) {
  
  stop(
    paste0(
      "Matriz não encontrada:\n",
      arquivo_matriz
    )
  )
}


if (!file.exists(arquivo_metadados)) {
  
  stop(
    paste0(
      "Base de referências não encontrada:\n",
      arquivo_metadados
    )
  )
}


if (!dir.exists(pasta_shape_brasil)) {
  
  stop(
    paste0(
      "Pasta do shapefile do Brasil não encontrada:\n",
      pasta_shape_brasil
    )
  )
}


# ============================================================
# 3. LOCALIZAR AUTOMATICAMENTE O SHAPEFILE DO BRASIL
# ============================================================

arquivos_shp <- list.files(
  pasta_shape_brasil,
  pattern = "\\.shp$",
  full.names = TRUE,
  ignore.case = TRUE
)


if (length(arquivos_shp) == 0) {
  
  stop(
    paste0(
      "Nenhum arquivo .shp encontrado em:\n",
      pasta_shape_brasil
    )
  )
}


if (length(arquivos_shp) > 1) {
  
  cat(
    "\nATENÇÃO: mais de um shapefile encontrado:\n"
  )
  
  print(
    arquivos_shp
  )
  
  stop(
    "Existe mais de um .shp na pasta. Verifique qual representa o Brasil."
  )
}


arquivo_brasil <- arquivos_shp[1]


cat(
  "\nShapefile utilizado:\n",
  arquivo_brasil,
  "\n"
)


# ============================================================
# 4. LER MATRIZ DE OCORRÊNCIA
# ============================================================

dados <- read.csv2(
  arquivo_matriz,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)


names(dados) <- trimws(
  names(dados)
)


cat(
  "\n============================================\n"
)

cat(
  "MATRIZ ORIGINAL\n"
)

cat(
  "============================================\n"
)

cat(
  "Linhas:",
  nrow(dados),
  "\n"
)

cat(
  "Colunas:",
  ncol(dados),
  "\n"
)


# ============================================================
# 5. CONFERIR COLUNAS TAXONÔMICAS
# ============================================================

colunas_taxonomicas <- c(
  "familia",
  "genero",
  "especie",
  "identificacao"
)


faltando <- setdiff(
  colunas_taxonomicas,
  names(dados)
)


if (length(faltando) > 0) {
  
  stop(
    paste0(
      "Colunas não encontradas na matriz: ",
      paste(
        faltando,
        collapse = ", "
      )
    )
  )
}


# ============================================================
# 6. IDENTIFICAR INVENTÁRIOS NA MATRIZ
# ============================================================

inventarios_matriz <- grep(
  "^t[0-9]+$",
  names(dados),
  value = TRUE
)


if (length(inventarios_matriz) == 0) {
  
  stop(
    "Nenhuma coluna de inventário foi encontrada."
  )
}


cat(
  "\nInventários encontrados na matriz:",
  length(inventarios_matriz),
  "\n"
)


# ============================================================
# 7. LER BASE DE REFERÊNCIAS
# ============================================================

metadados <- read_excel(
  arquivo_metadados
)


metadados <- as.data.frame(
  metadados,
  check.names = FALSE
)


names(metadados) <- trimws(
  names(metadados)
)


# ============================================================
# 8. CONFERIR COLUNAS NECESSÁRIAS NOS METADADOS
# ============================================================

colunas_metadados <- c(
  "ponto",
  "longitude",
  "latitude"
)


faltando_metadados <- setdiff(
  colunas_metadados,
  names(metadados)
)


if (length(faltando_metadados) > 0) {
  
  stop(
    paste0(
      "Colunas ausentes na base de referências: ",
      paste(
        faltando_metadados,
        collapse = ", "
      )
    )
  )
}


# ============================================================
# 9. PADRONIZAR CÓDIGOS DOS INVENTÁRIOS
# ============================================================

metadados$ponto <- trimws(
  as.character(
    metadados$ponto
  )
)


# ============================================================
# 10. CONVERTER COORDENADAS PARA NÚMERO
# ============================================================

metadados$longitude <- suppressWarnings(
  as.numeric(
    gsub(
      ",",
      ".",
      as.character(
        metadados$longitude
      ),
      fixed = TRUE
    )
  )
)


metadados$latitude <- suppressWarnings(
  as.numeric(
    gsub(
      ",",
      ".",
      as.character(
        metadados$latitude
      ),
      fixed = TRUE
    )
  )
)


# ============================================================
# 11. SELECIONAR NOS METADADOS SOMENTE INVENTÁRIOS
#     PRESENTES NA MATRIZ
# ============================================================

pontos <- metadados[
  metadados$ponto %in% inventarios_matriz,
  ,
  drop = FALSE
]


# Evitar duplicação do mesmo inventário
pontos <- pontos[
  !duplicated(
    pontos$ponto
  ),
  ,
  drop = FALSE
]


cat(
  "\nInventários encontrados nos metadados:",
  nrow(pontos),
  "\n"
)


# ============================================================
# 12. IDENTIFICAR INVENTÁRIOS SEM REGISTRO NOS METADADOS
# ============================================================

inventarios_sem_metadados <- setdiff(
  inventarios_matriz,
  pontos$ponto
)


cat(
  "Inventários sem correspondência nos metadados:",
  length(inventarios_sem_metadados),
  "\n"
)


if (length(inventarios_sem_metadados) > 0) {
  
  cat(
    "\nInventários sem metadados:\n"
  )
  
  print(
    inventarios_sem_metadados
  )
}


# ============================================================
# 13. IDENTIFICAR INVENTÁRIOS SEM COORDENADAS
# ============================================================

sem_coordenadas <- pontos[
  is.na(pontos$longitude) |
    is.na(pontos$latitude),
  "ponto"
]


cat(
  "\nInventários sem coordenadas válidas:",
  length(sem_coordenadas),
  "\n"
)


if (length(sem_coordenadas) > 0) {
  
  print(
    sem_coordenadas
  )
}


# ============================================================
# 14. MANTER SOMENTE PONTOS COM COORDENADAS
# ============================================================

pontos_validos <- pontos[
  !is.na(pontos$longitude) &
    !is.na(pontos$latitude),
  ,
  drop = FALSE
]


# ============================================================
# 15. VERIFICAR COORDENADAS IMPOSSÍVEIS
#
# Longitude:
#   -180 a 180
#
# Latitude:
#   -90 a 90
# ============================================================

coordenadas_invalidas <- pontos_validos[
  pontos_validos$longitude < -180 |
    pontos_validos$longitude > 180 |
    pontos_validos$latitude < -90 |
    pontos_validos$latitude > 90,
  ,
  drop = FALSE
]


if (nrow(coordenadas_invalidas) > 0) {
  
  cat(
    "\nATENÇÃO: coordenadas impossíveis encontradas:\n"
  )
  
  print(
    coordenadas_invalidas[
      ,
      c(
        "ponto",
        "longitude",
        "latitude"
      )
    ]
  )
  
  stop(
    "Existem coordenadas fora dos limites geográficos possíveis."
  )
}


# ============================================================
# 16. TRANSFORMAR INVENTÁRIOS EM OBJETO ESPACIAL
#
# Coordenadas geográficas:
# WGS84 / EPSG:4326
# ============================================================

pontos_sf <- st_as_sf(
  pontos_validos,
  coords = c(
    "longitude",
    "latitude"
  ),
  crs = 4326,
  remove = FALSE
)


# ============================================================
# 17. LER SHAPEFILE DO BRASIL
# ============================================================

brasil <- st_read(
  arquivo_brasil,
  quiet = TRUE
)


cat(
  "\nCRS original do shapefile do Brasil:\n"
)

print(
  st_crs(brasil)
)


# ============================================================
# 18. CORRIGIR GEOMETRIAS DO BRASIL
# ============================================================

brasil <- st_make_valid(
  brasil
)


# ============================================================
# 19. TRANSFORMAR O BRASIL PARA O MESMO CRS DOS PONTOS
# ============================================================

brasil <- st_transform(
  brasil,
  4326
)


# ============================================================
# 20. UNIR GEOMETRIAS DO BRASIL
#
# Isso transforma eventuais múltiplos polígonos em
# uma única geometria nacional.
# ============================================================

brasil_unido <- st_union(
  st_geometry(
    brasil
  )
)


# ============================================================
# 21. IDENTIFICAR INVENTÁRIOS DENTRO DO BRASIL
#
# st_intersects inclui também pontos localizados exatamente
# sobre a fronteira.
# ============================================================

dentro_brasil <- lengths(
  st_intersects(
    pontos_sf,
    brasil_unido
  )
) > 0


pontos_sf$dentro_brasil <- dentro_brasil


# ============================================================
# 22. LISTA DE INVENTÁRIOS DENTRO E FORA DO BRASIL
# ============================================================

inventarios_brasil <- pontos_sf$ponto[
  pontos_sf$dentro_brasil
]


inventarios_fora_brasil <- pontos_sf$ponto[
  !pontos_sf$dentro_brasil
]


cat(
  "\n============================================\n"
)

cat(
  "RESULTADO DO FILTRO ESPACIAL\n"
)

cat(
  "============================================\n"
)


cat(
  "Inventários com coordenadas válidas:",
  nrow(pontos_sf),
  "\n"
)


cat(
  "Inventários dentro do Brasil:",
  length(inventarios_brasil),
  "\n"
)


cat(
  "Inventários fora do Brasil:",
  length(inventarios_fora_brasil),
  "\n"
)


if (length(inventarios_fora_brasil) > 0) {
  
  cat(
    "\nInventários identificados FORA do Brasil:\n"
  )
  
  print(
    inventarios_fora_brasil
  )
}


# ============================================================
# 23. DEFINIR INVENTÁRIOS QUE SERÃO MANTIDOS
# ============================================================

inventarios_manter <- intersect(
  inventarios_matriz,
  inventarios_brasil
)


cat(
  "\nInventários que serão mantidos na matriz:",
  length(inventarios_manter),
  "\n"
)


if (length(inventarios_manter) == 0) {
  
  stop(
    "Nenhum inventário foi identificado dentro do Brasil."
  )
}


# ============================================================
# 24. IDENTIFICAR TODOS OS INVENTÁRIOS REMOVIDOS
#
# Inclui:
#   - fora do Brasil
#   - sem coordenadas
#   - sem correspondência nos metadados
# ============================================================

inventarios_removidos <- setdiff(
  inventarios_matriz,
  inventarios_manter
)


cat(
  "Total de inventários removidos:",
  length(inventarios_removidos),
  "\n"
)


# ============================================================
# 25. CRIAR MATRIZ COM:
#
# familia
# genero
# especie
# identificacao
# +
# inventários dentro do Brasil
# ============================================================

dados_brasil <- dados[
  ,
  c(
    "familia",
    "genero",
    "especie",
    "identificacao",
    inventarios_manter
  ),
  drop = FALSE
]


# ============================================================
# 26. EXTRAIR SOMENTE A PARTE NUMÉRICA
# ============================================================

matriz_inventarios <- dados_brasil[
  ,
  inventarios_manter,
  drop = FALSE
]


# ============================================================
# 27. CONVERTER VALORES PARA NÚMERO
# ============================================================

matriz_inventarios[] <- lapply(
  matriz_inventarios,
  function(x) {
    
    x <- gsub(
      ",",
      ".",
      as.character(x),
      fixed = TRUE
    )
    
    suppressWarnings(
      as.numeric(x)
    )
  }
)


matriz_inventarios[
  is.na(matriz_inventarios)
] <- 0


# ============================================================
# 28. REMOVER ESPÉCIES SEM OCORRÊNCIA APÓS O FILTRO
# ============================================================

manter_especie <- rowSums(
  matriz_inventarios > 0,
  na.rm = TRUE
) > 0


numero_especies_removidas <- sum(
  !manter_especie
)


dados_brasil <- dados_brasil[
  manter_especie,
  ,
  drop = FALSE
]


cat(
  "\nEspécies removidas por ficarem sem ocorrência:",
  numero_especies_removidas,
  "\n"
)


# ============================================================
# 29. REMOVER TEMPORARIAMENTE:
#
# familia
# genero
# identificacao
#
# Manter:
# especie + inventários
# ============================================================

colunas_remover <- c(
  "familia",
  "genero",
  "identificacao"
)


dados_final <- dados_brasil[
  ,
  !names(dados_brasil) %in% colunas_remover,
  drop = FALSE
]


# ============================================================
# 30. GARANTIR ESTRUTURA:
#
# especie | t1 | t2 | ...
# ============================================================

dados_final <- dados_final[
  ,
  c(
    "especie",
    inventarios_manter
  ),
  drop = FALSE
]


# ============================================================
# 31. CONFERÊNCIA FINAL
# ============================================================

cat(
  "\n============================================\n"
)

cat(
  "ESTRUTURA DA MATRIZ FINAL\n"
)

cat(
  "============================================\n"
)


cat(
  "Primeiras colunas:\n"
)

print(
  names(dados_final)[
    1:min(
      10,
      ncol(dados_final)
    )
  ]
)


cat(
  "\nNúmero de espécies:",
  nrow(dados_final),
  "\n"
)


cat(
  "Número de inventários:",
  ncol(dados_final) - 1,
  "\n"
)


# ============================================================
# 32. CONFERIR NOMES DE ESPÉCIES REPETIDOS
#
# NÃO SOMAR NESTA ETAPA.
# A união ocorrerá somente após a padronização taxonômica.
# ============================================================

numero_duplicadas <- sum(
  duplicated(
    dados_final$especie
  )
)


cat(
  "Linhas com nomes de espécies repetidos:",
  numero_duplicadas,
  "\n"
)


# ============================================================
# 33. SALVAR MATRIZ FINAL
# ============================================================

write.csv2(
  dados_final,
  arquivo_saida,
  row.names = FALSE,
  fileEncoding = "latin1"
)


# ============================================================
# 34. SALVAR RELATÓRIO DOS INVENTÁRIOS REMOVIDOS
# ============================================================

relatorio_inventarios <- data.frame(
  
  inventario = inventarios_matriz,
  
  status = ifelse(
    inventarios_matriz %in% inventarios_manter,
    "mantido_brasil",
    ifelse(
      inventarios_matriz %in% inventarios_fora_brasil,
      "fora_brasil",
      ifelse(
        inventarios_matriz %in% sem_coordenadas,
        "sem_coordenadas",
        ifelse(
          inventarios_matriz %in% inventarios_sem_metadados,
          "sem_metadados",
          "removido_outro_motivo"
        )
      )
    )
  ),
  
  stringsAsFactors = FALSE
)


write.csv2(
  relatorio_inventarios,
  file.path(
    pasta_caapora,
    "Matrizes_ocorrência",
    "relatorio_filtro_espacial_brasil_ocorrencia.csv"
  ),
  row.names = FALSE,
  fileEncoding = "latin1"
)


# ============================================================
# 35. RESUMO FINAL
# ============================================================

cat(
  "\n\n============================================\n"
)

cat(
  "SCRIPT 01 CONCLUÍDO\n"
)

cat(
  "============================================\n"
)


cat(
  "\nINVENTÁRIOS\n"
)


cat(
  "Inventários na matriz original:",
  length(inventarios_matriz),
  "\n"
)


cat(
  "Inventários dentro do Brasil:",
  length(inventarios_manter),
  "\n"
)


cat(
  "Inventários fora do Brasil:",
  length(inventarios_fora_brasil),
  "\n"
)


cat(
  "Inventários sem coordenadas:",
  length(sem_coordenadas),
  "\n"
)


cat(
  "Inventários sem metadados:",
  length(inventarios_sem_metadados),
  "\n"
)


cat(
  "Total removido:",
  length(inventarios_removidos),
  "\n"
)


cat(
  "\nESPÉCIES\n"
)


cat(
  "Linhas na matriz original:",
  nrow(dados),
  "\n"
)


cat(
  "Linhas removidas por ausência após o filtro:",
  numero_especies_removidas,
  "\n"
)


cat(
  "Linhas restantes:",
  nrow(dados_final),
  "\n"
)


cat(
  "\nESTRUTURA FINAL\n"
)


cat(
  "Matriz final: especie + inventários\n"
)


cat(
  "Colunas removidas temporariamente:",
  paste(
    colunas_remover,
    collapse = ", "
  ),
  "\n"
)


cat(
  "\nArquivo final:\n",
  arquivo_saida,
  "\n"
)


cat(
  "\n============================================\n"
)
