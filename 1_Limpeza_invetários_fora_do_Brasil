# Remover códigos repetidos
inventarios_excluir <- unique(inventarios_excluir)

# As quatro primeiras colunas são informações taxonômicas
colunas_informacao <- colnames(dados)[1:4]

# Os inventários começam na quinta coluna
colunas_inventarios <- colnames(dados)[5:ncol(dados)]

# Verificar os inventários encontrados
inventarios_encontrados <- intersect(
  inventarios_excluir,
  colunas_inventarios
)

inventarios_nao_encontrados <- setdiff(
  inventarios_excluir,
  colunas_inventarios
)

# Mostrar os inventários não encontrados
if (length(inventarios_nao_encontrados) > 0) {
  cat(
    "Inventários não encontrados na matriz:\n",
    paste(inventarios_nao_encontrados, collapse = ", "),
    "\n\n"
  )
}

# Excluir somente as colunas dos inventários indicados
dados_filtrados <- dados[
  ,
  !colnames(dados) %in% inventarios_encontrados,
  drop = FALSE
]

# Selecionar somente as colunas dos inventários restantes
colunas_inventarios_restantes <- setdiff(
  colunas_inventarios,
  inventarios_encontrados
)

matriz_ocorrencia_restante <- dados_filtrados[
  ,
  colunas_inventarios_restantes,
  drop = FALSE
]

# Converter os valores dos inventários para números
matriz_ocorrencia_restante[] <- lapply(
  matriz_ocorrencia_restante,
  function(x) {
    x <- gsub(",", ".", as.character(x), fixed = TRUE)
    as.numeric(x)
  }
)

# Substituir valores vazios ou inválidos por zero
matriz_ocorrencia_restante[is.na(matriz_ocorrencia_restante)] <- 0

# Manter espécies presentes em pelo menos um inventário restante
manter_especie <- rowSums(matriz_ocorrencia_restante > 0) > 0

resultado <- dados_filtrados[
  manter_especie,
  ,
  drop = FALSE
]

# Salvar a matriz de ocorrência filtrada
write.csv2(
  resultado,
  "C:/Users/giuli/OneDrive/Documentos/Caapora/Matrizes_ocorrência/Matriz_original_ocorrencia_brasil.csv",
  row.names = FALSE,
  fileEncoding = "latin1"
)

