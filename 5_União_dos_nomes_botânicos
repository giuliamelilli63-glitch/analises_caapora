# ============================================================
# HARMONIZAÇÃO BOTÂNICA DA MATRIZ DE OCORRÊNCIA
# USANDO TABELA TAXONÔMICA JÁ CONFERIDA
#
# ESTRUTURA DA MATRIZ DE ENTRADA:
#
# especie | identificacao | t1 | t2 | t3 | ...
#
# REGRAS:
#
# 1. Remover linhas sem nome de espécie.
#
# 2. Somente identificações "completa" são harmonizadas.
#
# 3. Familia e genero originais NÃO são usados.
#
# 4. A tabela taxonômica já foi previamente conferida.
#
# 5. A matriz final mantém:
#
#    especie_original
#    especie
#    identificacao
#    inventários
#
# 6. Se diferentes nomes originais virarem a mesma espécie:
#    as linhas são consolidadas.
#
# 7. Para ocorrência:
#       0 e 0 -> 0
#       0 e 1 -> 1
#       1 e 1 -> 1
#
#    Portanto usamos max(), NÃO soma.
# ============================================================


# ============================================================
# 0. PACOTES
# ============================================================

pacotes <- c(
  "dplyr",
  "readxl",
  "stringr",
  "openxlsx"
)

pacotes_faltantes <- pacotes[
  !pacotes %in% rownames(installed.packages())
]

if (length(pacotes_faltantes) > 0) {
  install.packages(pacotes_faltantes)
}

library(dplyr)
library(readxl)
library(stringr)
library(openxlsx)


# ============================================================
# 1. CAMINHOS
# ============================================================

pasta_caapora <-
  "C:/Users/giuli/OneDrive/Documentos/Caapora"


# ------------------------------------------------------------
# MATRIZ DE OCORRÊNCIA
#
# Confira apenas se este é exatamente o nome do arquivo atual.
# ------------------------------------------------------------

arquivo_matriz <- file.path(
  pasta_caapora,
  "Matrizes_ocorrência",
  "Matriz_original_ocorrencia_brasil_filtro_riqueza_area.csv"
)


# ------------------------------------------------------------
# TABELA TAXONÔMICA JÁ CONFERIDA
# ------------------------------------------------------------

arquivo_taxonomia <- file.path(
  pasta_caapora,
  "nomes_botanicos",
  "especies_conferidas_reflora_taxon.xlsx"
)


# ------------------------------------------------------------
# PASTA DE RESULTADOS
# ------------------------------------------------------------

pasta_resultados <- file.path(
  pasta_caapora,
  "Matrizes_ocorrência",
  "harmonizacao_botanica"
)

dir.create(
  pasta_resultados,
  recursive = TRUE,
  showWarnings = FALSE
)


# ============================================================
# 2. CONFERIR ARQUIVOS
# ============================================================

if (!file.exists(arquivo_matriz)) {
  
  stop(
    paste0(
      "Matriz não encontrada:\n",
      arquivo_matriz
    )
  )
}


if (!file.exists(arquivo_taxonomia)) {
  
  stop(
    paste0(
      "Tabela taxonômica não encontrada:\n",
      arquivo_taxonomia
    )
  )
}


# ============================================================
# 3. LER MATRIZ
# ============================================================

matriz <- read.csv2(
  arquivo_matriz,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)


cat(
  "\n============================================\n"
)

cat(
  "MATRIZ DE ENTRADA\n"
)

cat(
  "============================================\n"
)

cat(
  "Linhas lidas:",
  nrow(matriz),
  "\n"
)

cat(
  "Colunas lidas:",
  ncol(matriz),
  "\n"
)


# ============================================================
# 4. CONFERIR COLUNAS OBRIGATÓRIAS
# ============================================================

colunas_obrigatorias <- c(
  "especie",
  "identificacao"
)


colunas_ausentes <- setdiff(
  colunas_obrigatorias,
  names(matriz)
)


if (length(colunas_ausentes) > 0) {
  
  stop(
    paste0(
      "Colunas obrigatórias ausentes:\n",
      paste(
        colunas_ausentes,
        collapse = ", "
      )
    )
  )
}


# ============================================================
# 5. IDENTIFICAR INVENTÁRIOS
# ============================================================

colunas_inventarios <- grep(
  "^t[0-9]+$",
  names(matriz),
  value = TRUE
)


if (length(colunas_inventarios) == 0) {
  
  stop(
    "Nenhuma coluna de inventário com padrão t + número foi encontrada."
  )
}


cat(
  "Número de inventários:",
  length(colunas_inventarios),
  "\n"
)


# ============================================================
# 6. DIAGNÓSTICO DAS LINHAS SEM ESPÉCIE
#
# Não vamos cortar a matriz na primeira linha vazia.
#
# Apenas removemos individualmente as linhas em que
# "especie" esteja vazia ou NA.
#
# Isso remove:
#
# - linhas-resumo de riqueza/área;
# - linhas com vários zeros mas sem espécie;
# - linhas completamente vazias.
# ============================================================

numero_linhas_antes_limpeza <-
  nrow(matriz)


especie_temporaria <-
  trimws(
    as.character(
      matriz$especie
    )
  )


linha_tem_especie <-
  !is.na(
    especie_temporaria
  ) &
  especie_temporaria != ""


linhas_sem_especie <-
  matriz[
    !linha_tem_especie,
    ,
    drop = FALSE
  ]


cat(
  "\n============================================\n"
)

cat(
  "LIMPEZA DE LINHAS SEM ESPÉCIE\n"
)

cat(
  "============================================\n"
)

cat(
  "Linhas sem nome de espécie:",
  nrow(
    linhas_sem_especie
  ),
  "\n"
)


# ------------------------------------------------------------
# Diagnóstico do último nome válido
# ------------------------------------------------------------

if (any(linha_tem_especie)) {
  
  ultima_linha_com_especie <-
    max(
      which(
        linha_tem_especie
      )
    )
  
  
  cat(
    "Última linha com nome de espécie:",
    ultima_linha_com_especie,
    "\n"
  )
  
  
  cat(
    "Última espécie encontrada:",
    matriz$especie[
      ultima_linha_com_especie
    ],
    "\n"
  )
  
  
  cat(
    "\nÚltimas 20 espécies válidas da matriz:\n"
  )
  
  
  print(
    tail(
      matriz[
        linha_tem_especie,
        c(
          "especie",
          "identificacao"
        ),
        drop = FALSE
      ],
      20
    )
  )
}


# ------------------------------------------------------------
# Verificar espécies depois da primeira linha vazia
# ------------------------------------------------------------

indices_vazios <-
  which(
    !linha_tem_especie
  )


if (length(indices_vazios) > 0) {
  
  primeira_linha_vazia <-
    indices_vazios[1]
  
  
  especies_depois_de_vazio <-
    which(
      linha_tem_especie &
        seq_len(
          nrow(matriz)
        ) >
        primeira_linha_vazia
    )
  
  
  cat(
    "\nPrimeira linha sem espécie:",
    primeira_linha_vazia,
    "\n"
  )
  
  
  cat(
    "Linhas com espécie depois da primeira linha vazia:",
    length(
      especies_depois_de_vazio
    ),
    "\n"
  )
}


# ------------------------------------------------------------
# Remover apenas linhas sem espécie
# ------------------------------------------------------------

matriz <-
  matriz[
    linha_tem_especie,
    ,
    drop = FALSE
  ]


cat(
  "\nLinhas antes da limpeza:",
  numero_linhas_antes_limpeza,
  "\n"
)

cat(
  "Linhas depois da limpeza:",
  nrow(matriz),
  "\n"
)

cat(
  "Linhas removidas:",
  numero_linhas_antes_limpeza -
    nrow(matriz),
  "\n"
)


# ============================================================
# 7. SALVAR LINHAS REMOVIDAS
# ============================================================

write.xlsx(
  linhas_sem_especie,
  file.path(
    pasta_resultados,
    "linhas_sem_especie_removidas.xlsx"
  ),
  overwrite = TRUE
)


# ============================================================
# 8. GUARDAR INFORMAÇÕES ORIGINAIS
# ============================================================

matriz <- matriz %>%
  
  mutate(
    
    numero_linha_original =
      row_number(),
    
    especie_original =
      as.character(
        especie
      ),
    
    identificacao_original =
      as.character(
        identificacao
      ),
    
    chave_taxonomica =
      especie_original %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    identificacao_padronizada =
      identificacao_original %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    identificacao_completa =
      identificacao_padronizada ==
      "completa"
    
  )


# ============================================================
# 9. RESUMO DAS IDENTIFICAÇÕES
# ============================================================

cat(
  "\nValores encontrados em identificacao:\n"
)


print(
  matriz %>%
    
    count(
      identificacao_original,
      sort = TRUE
    )
)


numero_completas <-
  sum(
    matriz$identificacao_completa,
    na.rm = TRUE
  )


numero_nao_completas <-
  sum(
    !matriz$identificacao_completa,
    na.rm = TRUE
  )


cat(
  "\nIdentificações completas:",
  numero_completas,
  "\n"
)

cat(
  "Identificações não completas:",
  numero_nao_completas,
  "\n"
)


# ============================================================
# 10. LER TABELA TAXONÔMICA JÁ CONFERIDA
# ============================================================

taxonomia <- read_excel(
  arquivo_taxonomia,
  sheet = 1,
  .name_repair = "unique"
)


taxonomia <- as.data.frame(
  taxonomia,
  stringsAsFactors = FALSE,
  check.names = FALSE
)


cat(
  "\nColunas da tabela taxonômica:\n"
)

print(
  names(taxonomia)
)


# ============================================================
# 11. DEFINIR A COLUNA-CHAVE DA TABELA TAXONÔMICA
#
# A primeira coluna da tabela contém o nome original,
# por exemplo:
#
# abarema_acreana
# abarema_barouriana
# etc.
# ============================================================

nome_primeira_coluna <-
  names(taxonomia)[1]


taxonomia <- taxonomia %>%
  
  rename(
    chave_taxonomica =
      all_of(
        nome_primeira_coluna
      )
  )


# ============================================================
# 12. CONFERIR COLUNA COM NOME ACEITO
# ============================================================

if (
  !"nome_aceito_reflora" %in%
    names(taxonomia)
) {
  
  stop(
    paste0(
      "A coluna 'nome_aceito_reflora' não foi encontrada ",
      "na tabela taxonômica."
    )
  )
}


# ============================================================
# 13. PREPARAR TABELA TAXONÔMICA
# ============================================================

taxonomia <- taxonomia %>%
  
  mutate(
    
    chave_taxonomica =
      chave_taxonomica %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    nome_aceito_reflora =
      nome_aceito_reflora %>%
      as.character() %>%
      str_squish(),
    
    especie_harmonizada =
      case_when(
        
        is.na(
          nome_aceito_reflora
        ) ~
          
          NA_character_,
        
        nome_aceito_reflora ==
          "" ~
          
          NA_character_,
        
        str_to_upper(
          nome_aceito_reflora
        ) ==
          "NA" ~
          
          NA_character_,
        
        TRUE ~
          
          word(
            nome_aceito_reflora,
            start = 1,
            end = 2
          )
      )
    
  )


# ============================================================
# 14. VERIFICAR CHAVES REPETIDAS
# ============================================================

chaves_repetidas <-
  taxonomia %>%
  
  filter(
    !is.na(
      chave_taxonomica
    ),
    chave_taxonomica != ""
  ) %>%
  
  count(
    chave_taxonomica,
    name =
      "numero_registros"
  ) %>%
  
  filter(
    numero_registros > 1
  ) %>%
  
  arrange(
    desc(
      numero_registros
    ),
    chave_taxonomica
  )


cat(
  "\nChaves repetidas na tabela taxonômica:",
  nrow(
    chaves_repetidas
  ),
  "\n"
)


# ============================================================
# 15. VERIFICAR CONFLITOS TAXONÔMICOS
#
# Mesma chave apontando para mais de um nome harmonizado.
# ============================================================

conflitos_taxonomicos <-
  taxonomia %>%
  
  filter(
    !is.na(
      chave_taxonomica
    ),
    chave_taxonomica != ""
  ) %>%
  
  group_by(
    chave_taxonomica
  ) %>%
  
  summarise(
    
    numero_nomes_aceitos =
      n_distinct(
        especie_harmonizada,
        na.rm = TRUE
      ),
    
    nomes_aceitos =
      paste(
        sort(
          unique(
            na.omit(
              especie_harmonizada
            )
          )
        ),
        collapse = " | "
      ),
    
    .groups = "drop"
    
  ) %>%
  
  filter(
    numero_nomes_aceitos > 1
  )


cat(
  "Chaves com mais de um nome aceito:",
  nrow(
    conflitos_taxonomicos
  ),
  "\n"
)


# ============================================================
# 16. CRIAR TABELA TAXONÔMICA ÚNICA
# ============================================================

taxonomia_unica <-
  taxonomia %>%
  
  filter(
    !is.na(
      chave_taxonomica
    ),
    chave_taxonomica != ""
  ) %>%
  
  arrange(
    
    chave_taxonomica,
    
    is.na(
      especie_harmonizada
    ),
    
    especie_harmonizada
    
  ) %>%
  
  distinct(
    chave_taxonomica,
    .keep_all = TRUE
  ) %>%
  
  select(
    
    chave_taxonomica,
    
    nome_aceito_reflora,
    
    especie_harmonizada
    
  )


# ============================================================
# 17. JUNTAR MATRIZ E TABELA CONFERIDA
# ============================================================

matriz_harmonizada <-
  matriz %>%
  
  left_join(
    
    taxonomia_unica,
    
    by =
      "chave_taxonomica"
    
  )


# ============================================================
# 18. IDENTIFICAR CORRESPONDÊNCIA
# ============================================================

matriz_harmonizada <-
  matriz_harmonizada %>%
  
  mutate(
    
    encontrou_correspondencia =
      !is.na(
        especie_harmonizada
      ) &
      especie_harmonizada != "",
    
    harmonizacao_realizada =
      identificacao_completa &
      encontrou_correspondencia
    
  )


# ============================================================
# 19. APLICAR NOME HARMONIZADO
#
# Somente para identificações completas.
#
# Incompletas mantêm o nome original.
# ============================================================

matriz_harmonizada <-
  matriz_harmonizada %>%
  
  mutate(
    
    especie =
      case_when(
        
        harmonizacao_realizada ~
          
          especie_harmonizada,
        
        TRUE ~
          
          especie_original
      ),
    
    identificacao =
      identificacao_original
    
  )


# ============================================================
# 20. COMPLETAS SEM CORRESPONDÊNCIA
#
# Apenas para controle de integridade.
# ============================================================

completas_sem_correspondencia <-
  matriz_harmonizada %>%
  
  filter(
    
    identificacao_completa,
    
    !encontrou_correspondencia
    
  ) %>%
  
  select(
    
    numero_linha_original,
    
    especie_original,
    
    identificacao_original,
    
    chave_taxonomica
    
  ) %>%
  
  arrange(
    especie_original
  )


cat(
  "\nIdentificações completas sem chave na tabela:",
  nrow(
    completas_sem_correspondencia
  ),
  "\n"
)


# ============================================================
# 21. NOMES HARMONIZADOS
# ============================================================

nomes_harmonizados <-
  matriz_harmonizada %>%
  
  filter(
    harmonizacao_realizada
  ) %>%
  
  transmute(
    
    numero_linha_original,
    
    especie_original,
    
    especie_harmonizada =
      especie,
    
    nome_aceito_com_autoria =
      nome_aceito_reflora
    
  ) %>%
  
  arrange(
    especie_original
  )


# ============================================================
# 22. NOMES EFETIVAMENTE ALTERADOS
# ============================================================

nomes_alterados <-
  nomes_harmonizados %>%
  
  filter(
    
    str_to_lower(
      str_squish(
        especie_original
      )
    ) !=
      
      str_to_lower(
        str_squish(
          especie_harmonizada
        )
      )
    
  )


cat(
  "Linhas harmonizadas:",
  nrow(
    nomes_harmonizados
  ),
  "\n"
)

cat(
  "Linhas com nome alterado:",
  nrow(
    nomes_alterados
  ),
  "\n"
)


# ============================================================
# 23. CONVERTER INVENTÁRIOS PARA NUMÉRICO
# ============================================================

matriz_harmonizada <-
  matriz_harmonizada %>%
  
  mutate(
    
    across(
      
      all_of(
        colunas_inventarios
      ),
      
      ~ suppressWarnings(
        
        as.numeric(
          
          str_replace(
            
            as.character(.x),
            
            ",",
            
            "."
            
          )
          
        )
        
      )
      
    )
    
  )


# ============================================================
# 24. CONVERTER VALORES POSITIVOS PARA PRESENÇA
#
# Isso protege contra valores como 2, 1.5 etc.
# que eventualmente tenham aparecido em linhas-resumo
# ou problemas da matriz.
#
# Para ocorrência:
#
# 0   -> 0
# > 0 -> 1
# ============================================================

matriz_harmonizada <-
  matriz_harmonizada %>%
  
  mutate(
    
    across(
      
      all_of(
        colunas_inventarios
      ),
      
      ~ case_when(
        
        is.na(.x) ~
          
          NA_real_,
        
        .x == 0 ~
          
          0,
        
        .x > 0 ~
          
          1,
        
        TRUE ~
          
          .x
        
      )
      
    )
    
  )


# ============================================================
# 25. CONFERIR VALORES INVÁLIDOS
# ============================================================

valores_antes_consolidacao <-
  unlist(
    
    matriz_harmonizada[
      ,
      colunas_inventarios,
      drop = FALSE
    ],
    
    use.names = FALSE
    
  )


valores_invalidos <-
  valores_antes_consolidacao[
    
    !is.na(
      valores_antes_consolidacao
    ) &
      
      !(
        valores_antes_consolidacao %in%
          c(
            0,
            1
          )
      )
    
  ]


cat(
  "\nValores diferentes de 0 ou 1 após ajuste:",
  length(
    valores_invalidos
  ),
  "\n"
)


if (
  length(
    valores_invalidos
  ) > 0
) {
  
  stop(
    "Ainda existem valores inválidos na matriz."
  )
}


# ============================================================
# 26. IDENTIFICAR LINHAS QUE SERÃO CONSOLIDADAS
# ============================================================

resumo_consolidacao <-
  matriz_harmonizada %>%
  
  group_by(
    
    especie,
    
    identificacao
    
  ) %>%
  
  summarise(
    
    numero_linhas_unidas =
      n(),
    
    numeros_linhas_originais =
      paste(
        numero_linha_original,
        collapse = " | "
      ),
    
    nomes_originais =
      paste(
        sort(
          unique(
            especie_original
          )
        ),
        collapse = " | "
      ),
    
    .groups = "drop"
    
  ) %>%
  
  arrange(
    
    desc(
      numero_linhas_unidas
    ),
    
    especie
    
  )


especies_com_linhas_unidas <-
  resumo_consolidacao %>%
  
  filter(
    numero_linhas_unidas > 1
  )


cat(
  "\nTáxons com duas ou mais linhas consolidadas:",
  nrow(
    especies_com_linhas_unidas
  ),
  "\n"
)


# ============================================================
# 27. CONSOLIDAR MATRIZ DE OCORRÊNCIA
#
# A matriz final mantém:
#
# especie_original
# especie
# identificacao
# inventários
#
# Quando há mais de um nome original para a mesma espécie,
# eles são unidos usando " | ".
# ============================================================

matriz_final <-
  matriz_harmonizada %>%
  
  group_by(
    
    especie,
    
    identificacao
    
  ) %>%
  
  summarise(
    
    especie_original =
      paste(
        sort(
          unique(
            especie_original
          )
        ),
        collapse = " | "
      ),
    
    across(
      
      all_of(
        colunas_inventarios
      ),
      
      ~ {
        
        if (
          all(
            is.na(.x)
          )
        ) {
          
          NA_real_
          
        } else {
          
          max(
            .x,
            na.rm = TRUE
          )
          
        }
        
      }
      
    ),
    
    .groups = "drop"
    
  ) %>%
  
  select(
    
    especie_original,
    
    especie,
    
    identificacao,
    
    all_of(
      colunas_inventarios
    )
    
  )


# ============================================================
# 28. CONFERIR DUPLICAÇÕES FINAIS
# ============================================================

duplicacoes_finais <-
  matriz_final %>%
  
  count(
    
    especie,
    
    identificacao,
    
    name =
      "numero_linhas"
    
  ) %>%
  
  filter(
    numero_linhas > 1
  )


cat(
  "Duplicações finais:",
  nrow(
    duplicacoes_finais
  ),
  "\n"
)


if (
  nrow(
    duplicacoes_finais
  ) > 0
) {
  
  stop(
    "Ainda existem duplicações após a consolidação."
  )
}


# ============================================================
# 29. REMOVER LINHAS SEM NENHUMA OCORRÊNCIA
# ============================================================

matriz_numerica_final <-
  matriz_final[
    ,
    colunas_inventarios,
    drop = FALSE
  ]


manter_especie <-
  rowSums(
    matriz_numerica_final > 0,
    na.rm = TRUE
  ) > 0


especies_sem_ocorrencia <-
  matriz_final[
    !manter_especie,
    c(
      "especie_original",
      "especie",
      "identificacao"
    ),
    drop = FALSE
  ]


numero_antes_remocao_zero <-
  nrow(
    matriz_final
  )


matriz_final <-
  matriz_final[
    manter_especie,
    ,
    drop = FALSE
  ]


cat(
  "Espécies removidas por ausência em todos os inventários:",
  nrow(
    especies_sem_ocorrencia
  ),
  "\n"
)


# ============================================================
# 30. CONFERÊNCIA FINAL DOS VALORES
# ============================================================

valores_finais <-
  unlist(
    
    matriz_final[
      ,
      colunas_inventarios,
      drop = FALSE
    ],
    
    use.names = FALSE
    
  )


valores_finais_invalidos <-
  valores_finais[
    
    !is.na(
      valores_finais
    ) &
      
      !(
        valores_finais %in%
          c(
            0,
            1
          )
      )
    
  ]


if (
  length(
    valores_finais_invalidos
  ) > 0
) {
  
  stop(
    "A matriz final contém valores diferentes de 0 ou 1."
  )
}


# ============================================================
# 31. FREQUÊNCIA DAS ESPÉCIES
# ============================================================

frequencia_especies <-
  matriz_final %>%
  
  mutate(
    
    numero_inventarios =
      rowSums(
        
        across(
          all_of(
            colunas_inventarios
          )
        ),
        
        na.rm = TRUE
        
      )
    
  ) %>%
  
  select(
    
    especie_original,
    
    especie,
    
    identificacao,
    
    numero_inventarios
    
  ) %>%
  
  arrange(
    
    desc(
      numero_inventarios
    ),
    
    especie
    
  )


