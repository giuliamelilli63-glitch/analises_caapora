# ============================================================
# HARMONIZAÇÃO TAXONÔMICA DA MATRIZ DE OCORRÊNCIA
# ============================================================

# Instalar somente se necessário:
# install.packages(c("dplyr", "readxl", "stringr", "openxlsx"))

library(dplyr)
library(readxl)
library(stringr)
library(openxlsx)

# ------------------------------------------------------------
# 1. Caminhos
# ------------------------------------------------------------

arquivo_matriz <- file.path("C:/Users/giuli/OneDrive/Documentos/Caapora/Matrizes_ocorrência/Matriz_original_ocorrencia_brasil_identificacao_recorte1ha.csv"
  
)

arquivo_taxonomia <- file.path("C:/Users/giuli/OneDrive/Documentos/Caapora/nomes_botanicos/especies_conferidas_reflora_taxon.xlsx"
)

pasta_resultados <- file.path("C:/Users/giuli/OneDrive/Documentos/Caapora/Matrizes_ocorrência"
)


# ------------------------------------------------------------
# 2. Ler a matriz de ocorrência
# ------------------------------------------------------------

matriz <- read.csv2(
  arquivo_matriz,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)

cat(
  "\nDimensões da matriz original:\n",
  "Linhas:", nrow(matriz), "\n",
  "Colunas:", ncol(matriz), "\n"
)

# ------------------------------------------------------------
# 3. Conferir colunas obrigatórias
# ------------------------------------------------------------

colunas_obrigatorias <- c(
  "familia",
  "genero",
  "especie",
  "identificacao"
)

colunas_ausentes <- setdiff(
  colunas_obrigatorias,
  names(matriz)
)

if (length(colunas_ausentes) > 0) {
  stop(
    paste0(
      "As seguintes colunas não foram encontradas na matriz: ",
      paste(colunas_ausentes, collapse = ", ")
    )
  )
}

# ------------------------------------------------------------
# 4. Identificar as colunas dos inventários
# ------------------------------------------------------------

colunas_inventarios <- grep(
  "^t[0-9]+$",
  names(matriz),
  value = TRUE
)

if (length(colunas_inventarios) == 0) {
  stop(
    "Nenhuma coluna de inventário com padrão t + número foi encontrada."
  )
}

cat(
  "Número de inventários:",
  length(colunas_inventarios),
  "\n"
)

# ------------------------------------------------------------
# 5. Guardar informações originais
# ------------------------------------------------------------

matriz <- matriz %>%
  mutate(
    numero_linha_original = row_number(),
    
    familia_original = as.character(familia),
    
    genero_original = as.character(genero),
    
    especie_original = as.character(especie),
    
    identificacao_original = as.character(identificacao),
    
    # Chave usada para relacionar a espécie à planilha conferida
    chave_taxonomica = especie %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    identificacao_padronizada = identificacao %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower()
  )

# ------------------------------------------------------------
# 6. Conferir os valores da coluna identificacao
# ------------------------------------------------------------

cat("\nValores encontrados na coluna identificacao:\n")

print(
  matriz %>%
    count(
      identificacao_original,
      sort = TRUE
    )
)

# ------------------------------------------------------------
# 7. Ler a planilha taxonômica conferida
# ------------------------------------------------------------

taxonomia <- read_excel(
  arquivo_taxonomia,
  sheet = 1,
  .name_repair = "unique"
)

cat("\nColunas da planilha taxonômica:\n")
print(names(taxonomia))

# A primeira coluna contém o nome original no formato:
# abarema_acreana
# abarema_adenophora
# etc.

nome_primeira_coluna <- names(taxonomia)[1]

taxonomia <- taxonomia %>%
  rename(
    chave_taxonomica = all_of(nome_primeira_coluna)
  )

# ------------------------------------------------------------
# 8. Conferir colunas necessárias na tabela taxonômica
# ------------------------------------------------------------

colunas_taxonomicas_obrigatorias <- c(
  "nome_aceito_reflora",
  "familia_reflora"
)

colunas_taxonomicas_ausentes <- setdiff(
  colunas_taxonomicas_obrigatorias,
  names(taxonomia)
)

if (length(colunas_taxonomicas_ausentes) > 0) {
  stop(
    paste0(
      "As seguintes colunas não foram encontradas na planilha taxonômica: ",
      paste(colunas_taxonomicas_ausentes, collapse = ", ")
    )
  )
}

# ------------------------------------------------------------
# 9. Preparar a tabela taxonômica
# ------------------------------------------------------------

taxonomia <- taxonomia %>%
  mutate(
    chave_taxonomica = chave_taxonomica %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    nome_aceito_reflora = nome_aceito_reflora %>%
      as.character() %>%
      str_squish(),
    
    familia_reflora = familia_reflora %>%
      as.character() %>%
      str_squish()
  )

# ------------------------------------------------------------
# 10. Retirar a autoria do nome aceito
# ------------------------------------------------------------

# Mantém somente os dois primeiros termos:
#
# Abarema acreana (J.F.Macbr.) L.Rico
# passa para:
# Abarema acreana
#
# Jupunba adenophora (Ducke) M.V.B.Soares et al.
# passa para:
# Jupunba adenophora

taxonomia <- taxonomia %>%
  mutate(
    nome_aceito_sem_autoria = case_when(
      is.na(nome_aceito_reflora) ~ NA_character_,
      
      nome_aceito_reflora == "" ~ NA_character_,
      
      str_to_upper(nome_aceito_reflora) == "NA" ~ NA_character_,
      
      TRUE ~ word(
        nome_aceito_reflora,
        start = 1,
        end = 2
      )
    ),
    
    # O gênero harmonizado é retirado diretamente
    # do primeiro termo do nome aceito
    genero_aceito = case_when(
      is.na(nome_aceito_sem_autoria) ~ NA_character_,
      
      nome_aceito_sem_autoria == "" ~ NA_character_,
      
      TRUE ~ word(
        nome_aceito_sem_autoria,
        start = 1,
        end = 1
      )
    )
  )

# ------------------------------------------------------------
# 11. Verificar chaves repetidas na tabela taxonômica
# ------------------------------------------------------------

chaves_repetidas <- taxonomia %>%
  filter(
    !is.na(chave_taxonomica),
    chave_taxonomica != ""
  ) %>%
  count(
    chave_taxonomica,
    name = "numero_registros"
  ) %>%
  filter(numero_registros > 1) %>%
  arrange(
    desc(numero_registros),
    chave_taxonomica
  )

cat(
  "\nChaves repetidas na planilha taxonômica:",
  nrow(chaves_repetidas),
  "\n"
)

write.xlsx(
  chaves_repetidas,
  file.path(
    pasta_resultados,
    "chaves_repetidas_na_planilha_taxonomica.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 12. Verificar chaves com mais de um nome aceito
# ------------------------------------------------------------

conflitos_taxonomicos <- taxonomia %>%
  filter(
    !is.na(chave_taxonomica),
    chave_taxonomica != ""
  ) %>%
  group_by(chave_taxonomica) %>%
  summarise(
    numero_nomes_aceitos = n_distinct(
      nome_aceito_sem_autoria,
      na.rm = TRUE
    ),
    
    nomes_aceitos = paste(
      sort(unique(na.omit(nome_aceito_sem_autoria))),
      collapse = " | "
    ),
    
    familias = paste(
      sort(unique(na.omit(familia_reflora))),
      collapse = " | "
    ),
    
    .groups = "drop"
  ) %>%
  filter(numero_nomes_aceitos > 1)

cat(
  "Chaves com mais de um nome aceito:",
  nrow(conflitos_taxonomicos),
  "\n"
)

write.xlsx(
  conflitos_taxonomicos,
  file.path(
    pasta_resultados,
    "conflitos_de_nomes_aceitos.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 13. Manter uma correspondência por chave
# ------------------------------------------------------------

taxonomia_unica <- taxonomia %>%
  filter(
    !is.na(chave_taxonomica),
    chave_taxonomica != ""
  ) %>%
  arrange(
    chave_taxonomica,
    is.na(nome_aceito_sem_autoria),
    nome_aceito_sem_autoria
  ) %>%
  distinct(
    chave_taxonomica,
    .keep_all = TRUE
  ) %>%
  select(
    chave_taxonomica,
    nome_aceito_reflora,
    nome_aceito_sem_autoria,
    genero_aceito,
    familia_reflora
  )

# ------------------------------------------------------------
# 14. Juntar matriz e tabela taxonômica
# ------------------------------------------------------------

matriz_harmonizada <- matriz %>%
  left_join(
    taxonomia_unica,
    by = "chave_taxonomica"
  )

# ------------------------------------------------------------
# 15. Identificar quais linhas podem ser harmonizadas
# ------------------------------------------------------------

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    identificacao_completa =
      identificacao_padronizada == "completa",
    
    encontrou_correspondencia =
      !is.na(nome_aceito_sem_autoria) &
      nome_aceito_sem_autoria != "",
    
    harmonizacao_realizada =
      identificacao_completa &
      encontrou_correspondencia
  )

# ------------------------------------------------------------
# 16. Substituir nome, gênero e família
# ------------------------------------------------------------

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    # Espécie:
    # usa o nome aceito sem autoria somente nas identificações completas
    especie = case_when(
      harmonizacao_realizada ~ nome_aceito_sem_autoria,
      TRUE ~ especie_original
    ),
    
    # Gênero:
    # retirado diretamente do primeiro termo do nome aceito
    genero = case_when(
      harmonizacao_realizada &
        !is.na(genero_aceito) &
        genero_aceito != "" ~ genero_aceito,
      
      TRUE ~ genero_original
    ),
    
    # Família:
    # usa familia_reflora somente nas identificações completas
    familia = case_when(
      harmonizacao_realizada &
        !is.na(familia_reflora) &
        familia_reflora != "" ~ familia_reflora,
      
      TRUE ~ familia_original
    )
  )

# ------------------------------------------------------------
# 17. Atualizar a coluna identificacao e registrar
#     identificações completas sem correspondência
# ------------------------------------------------------------

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    identificacao = case_when(
      
      identificacao_completa &
        encontrou_correspondencia ~ "completa",
      
      identificacao_completa &
        !encontrou_correspondencia ~ "sem_correspondencia",
      
      TRUE ~ identificacao_original
    )
  )

cat("\nValores finais da coluna identificacao:\n")

print(
  matriz_harmonizada %>%
    count(
      identificacao,
      sort = TRUE
    )
)

completas_sem_correspondencia <- matriz_harmonizada %>%
  filter(
    identificacao == "sem_correspondencia"
  ) %>%
  select(
    numero_linha_original,
    familia_original,
    genero_original,
    especie_original,
    identificacao_original,
    chave_taxonomica
  ) %>%
  arrange(
    especie_original
  )

cat(
  "\nIdentificações completas sem correspondência:",
  nrow(completas_sem_correspondencia),
  "\n"
)

write.xlsx(
  completas_sem_correspondencia,
  file.path(
    pasta_resultados,
    "identificacoes_completas_sem_correspondencia.xlsx"
  ),
  overwrite = TRUE
)
# ------------------------------------------------------------
# 18. Criar tabela de todos os nomes harmonizados
# ------------------------------------------------------------

nomes_harmonizados <- matriz_harmonizada %>%
  filter(harmonizacao_realizada) %>%
  transmute(
    numero_linha_original,
    
    familia_original,
    genero_original,
    especie_original,
    
    familia_harmonizada = familia,
    genero_harmonizado = genero,
    especie_harmonizada = especie,
    
    nome_aceito_com_autoria = nome_aceito_reflora
  ) %>%
  arrange(especie_original)

cat(
  "Linhas harmonizadas:",
  nrow(nomes_harmonizados),
  "\n"
)

write.xlsx(
  nomes_harmonizados,
  file.path(
    pasta_resultados,
    "nomes_botanicos_harmonizados.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 19. Identificar nomes efetivamente alterados
# ------------------------------------------------------------

nomes_alterados <- nomes_harmonizados %>%
  filter(
    str_to_lower(str_squish(especie_original)) !=
      str_to_lower(str_squish(especie_harmonizada)) |
      
      str_to_lower(str_squish(genero_original)) !=
      str_to_lower(str_squish(genero_harmonizado)) |
      
      str_to_lower(str_squish(familia_original)) !=
      str_to_lower(str_squish(familia_harmonizada))
  )

cat(
  "Linhas que tiveram alguma alteração:",
  nrow(nomes_alterados),
  "\n"
)

write.xlsx(
  nomes_alterados,
  file.path(
    pasta_resultados,
    "nomes_que_foram_alterados.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 20. Identificar mudanças de gênero
# ------------------------------------------------------------

mudancas_genero <- nomes_harmonizados %>%
  filter(
    str_to_lower(str_squish(genero_original)) !=
      str_to_lower(str_squish(genero_harmonizado))
  )

cat(
  "Linhas com mudança de gênero:",
  nrow(mudancas_genero),
  "\n"
)

write.xlsx(
  mudancas_genero,
  file.path(
    pasta_resultados,
    "nomes_com_mudanca_de_genero.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 21. Identificar mudanças de família
# ------------------------------------------------------------

mudancas_familia <- nomes_harmonizados %>%
  filter(
    str_to_lower(str_squish(familia_original)) !=
      str_to_lower(str_squish(familia_harmonizada))
  )

cat(
  "Linhas com mudança de família:",
  nrow(mudancas_familia),
  "\n"
)

write.xlsx(
  mudancas_familia,
  file.path(
    pasta_resultados,
    "nomes_com_mudanca_de_familia.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 22. Conferir se as identificações incompletas foram alteradas
# ------------------------------------------------------------

incompletas_alteradas <- matriz_harmonizada %>%
  filter(
    !identificacao_completa,
    (
      as.character(familia) != as.character(familia_original) |
        as.character(genero) != as.character(genero_original) |
        as.character(especie) != as.character(especie_original)
    )
  )

cat(
  "Identificações incompletas alteradas:",
  nrow(incompletas_alteradas),
  "\n"
)

if (nrow(incompletas_alteradas) > 0) {
  write.xlsx(
    incompletas_alteradas,
    file.path(
      pasta_resultados,
      "ATENCAO_identificacoes_incompletas_alteradas.xlsx"
    ),
    overwrite = TRUE
  )
}

# ------------------------------------------------------------
# 23. Converter as colunas dos inventários para números
# ------------------------------------------------------------

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    across(
      all_of(colunas_inventarios),
      ~ suppressWarnings(
        as.numeric(
          str_replace(
            as.character(.x),
            ",",
            "."
          )
        )
      )
    )
  )

# ------------------------------------------------------------
# 24. Conferir valores diferentes de 0, 1 ou NA
# ------------------------------------------------------------

valores_invalidos <- data.frame(
  inventario = character(),
  numero_linha_original = integer(),
  especie = character(),
  valor = numeric(),
  stringsAsFactors = FALSE
)

for (coluna in colunas_inventarios) {
  
  valores <- matriz_harmonizada[[coluna]]
  
  problema <- !is.na(valores) &
    !(valores %in% c(0, 1))
  
  if (any(problema)) {
    
    valores_invalidos <- bind_rows(
      valores_invalidos,
      data.frame(
        inventario = coluna,
        numero_linha_original =
          matriz_harmonizada$numero_linha_original[problema],
        especie =
          matriz_harmonizada$especie[problema],
        valor =
          valores[problema],
        stringsAsFactors = FALSE
      )
    )
  }
}

cat(
  "Células com valores diferentes de 0 ou 1:",
  nrow(valores_invalidos),
  "\n"
)

write.xlsx(
  valores_invalidos,
  file.path(
    pasta_resultados,
    "valores_diferentes_de_zero_ou_um.xlsx"
  ),
  overwrite = TRUE
)

# Interromper se houver valores inválidos
if (nrow(valores_invalidos) > 0) {
  stop(
    paste0(
      "Foram encontrados valores diferentes de 0 ou 1. ",
      "Confira o arquivo valores_diferentes_de_zero_ou_um.xlsx."
    )
  )
}

# ------------------------------------------------------------
# 25. Identificar linhas que passarão a ser consolidadas
# ------------------------------------------------------------

resumo_consolidacao <- matriz_harmonizada %>%
  group_by(
    familia,
    genero,
    especie,
    identificacao
  ) %>%
  summarise(
    numero_linhas_unidas = n(),
    
    numeros_linhas_originais = paste(
      numero_linha_original,
      collapse = " | "
    ),
    
    nomes_originais = paste(
      sort(unique(especie_original)),
      collapse = " | "
    ),
    
    .groups = "drop"
  ) %>%
  arrange(
    desc(numero_linhas_unidas),
    especie
  )

linhas_realmente_unidas <- resumo_consolidacao %>%
  filter(numero_linhas_unidas > 1)

cat(
  "\nTáxons que terão duas ou mais linhas consolidadas:",
  nrow(linhas_realmente_unidas),
  "\n"
)

write.xlsx(
  resumo_consolidacao,
  file.path(
    pasta_resultados,
    "resumo_completo_da_consolidacao.xlsx"
  ),
  overwrite = TRUE
)

write.xlsx(
  linhas_realmente_unidas,
  file.path(
    pasta_resultados,
    "especies_que_tiveram_linhas_unidas.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 26. Consolidar a matriz de presença e ausência
# ------------------------------------------------------------

# IMPORTANTE:
#
# Não ocorre soma.
#
# Para cada espécie e inventário:
#
# 0 e 0 = 0
# 0 e 1 = 1
# 1 e 1 = 1
#
# O uso de max() mantém a matriz como presença e ausência.

matriz_final <- matriz_harmonizada %>%
  select(
    familia,
    genero,
    especie,
    identificacao,
    all_of(colunas_inventarios)
  ) %>%
  group_by(
    familia,
    genero,
    especie,
    identificacao
  ) %>%
  summarise(
    across(
      all_of(colunas_inventarios),
      ~ {
        if (all(is.na(.x))) {
          NA_real_
        } else {
          max(.x, na.rm = TRUE)
        }
      }
    ),
    .groups = "drop"
  )

# ------------------------------------------------------------
# 27. Conferir novamente os valores da matriz final
# ------------------------------------------------------------

valores_finais <- unlist(
  matriz_final[, colunas_inventarios],
  use.names = FALSE
)

valores_finais_invalidos <- valores_finais[
  !is.na(valores_finais) &
    !(valores_finais %in% c(0, 1))
]

if (length(valores_finais_invalidos) > 0) {
  stop(
    "A matriz final contém valores diferentes de 0 ou 1."
  )
}

# ------------------------------------------------------------
# 28. Conferir duplicações na matriz final
# ------------------------------------------------------------

duplicacoes_finais <- matriz_final %>%
  count(
    familia,
    genero,
    especie,
    identificacao,
    name = "numero_linhas"
  ) %>%
  filter(numero_linhas > 1)

cat(
  "Táxons ainda duplicados na matriz final:",
  nrow(duplicacoes_finais),
  "\n"
)

write.xlsx(
  duplicacoes_finais,
  file.path(
    pasta_resultados,
    "duplicacoes_na_matriz_final.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 29. Calcular frequência de ocorrência
# ------------------------------------------------------------

# Como os dados são presença e ausência,
# a soma representa o número de inventários
# em que cada táxon está presente.
#
# Esta soma é feita somente depois da consolidação
# e não é usada para unir as linhas.

frequencia_especies <- matriz_final %>%
  mutate(
    numero_inventarios = rowSums(
      across(all_of(colunas_inventarios)),
      na.rm = TRUE
    )
  ) %>%
  select(
    familia,
    genero,
    especie,
    identificacao,
    numero_inventarios
  ) %>%
  arrange(
    desc(numero_inventarios),
    especie
  )

# ------------------------------------------------------------
# 30. Resumo final
# ------------------------------------------------------------

numero_completas <- sum(
  matriz_harmonizada$identificacao_completa,
  na.rm = TRUE
)

numero_incompletas <- sum(
  !matriz_harmonizada$identificacao_completa,
  na.rm = TRUE
)

numero_harmonizadas <- sum(
  matriz_harmonizada$harmonizacao_realizada,
  na.rm = TRUE
)

numero_linhas_removidas <- nrow(matriz) -
  nrow(matriz_final)

cat(
  "\n==========================================",
  "\nRESUMO DA HARMONIZAÇÃO TAXONÔMICA",
  "\n==========================================",
  "\nLinhas na matriz original:",
  nrow(matriz),
  "\nIdentificações completas:",
  numero_completas,
  "\nIdentificações incompletas:",
  numero_incompletas,
  "\nLinhas completas harmonizadas:",
  numero_harmonizadas,
  "\nCompletas sem correspondência:",
  nrow(completas_sem_correspondencia),
  "\nLinhas com mudança de gênero:",
  nrow(mudancas_genero),
  "\nLinhas com mudança de família:",
  nrow(mudancas_familia),
  "\nTáxons com linhas consolidadas:",
  nrow(linhas_realmente_unidas),
  "\nLinhas removidas pela consolidação:",
  numero_linhas_removidas,
  "\nLinhas na matriz final:",
  nrow(matriz_final),
  "\nInventários na matriz final:",
  length(colunas_inventarios),
  "\nIdentificações incompletas alteradas:",
  nrow(incompletas_alteradas),
  "\nValores inválidos na matriz final:",
  length(valores_finais_invalidos),
  "\nDuplicações na matriz final:",
  nrow(duplicacoes_finais),
  "\n==========================================\n"
)

# ------------------------------------------------------------
# 31. Salvar a matriz antes da consolidação
# ------------------------------------------------------------

write.xlsx(
  matriz_harmonizada,
  file.path(
    pasta_resultados,
    "matriz_harmonizada_antes_da_consolidacao.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 32. Salvar a matriz final em CSV
# ------------------------------------------------------------

write.csv2(
  matriz_final,
  file.path(
    pasta_resultados,
    "Matriz_original_ocorrencia_brasil_identificacao_recorte1ha_padronizacaobotanica.csv"
