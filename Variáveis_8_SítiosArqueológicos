# ============================================================
# PROJETO CAAPORÃ
# VARIÁVEL HUMANA - ARQUEOLOGIA
#
# DENSIDADE DE SÍTIOS ARQUEOLÓGICOS
#
# Matriz: ocorrência
#
# Buffers:
# 10 km
# 25 km
# 50 km
# 100 km
#
# Base arqueológica:
# - polígonos quando disponíveis
# - pontos apenas para sítios sem polígono
# ============================================================


# ------------------------------------------------------------
# 0. Pacotes
# ------------------------------------------------------------

library(sf)
library(dplyr)


# ------------------------------------------------------------
# 1. Conferir objetos
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "DADOS DE ENTRADA\n",
  "========================================\n"
)

cat(
  "\nInventários:",
  nrow(inventarios_m),
  "\n"
)

cat(
  "Sítios com polígono:",
  nrow(sitios_pol_m),
  "\n"
)

cat(
  "Sítios somente como ponto:",
  nrow(sitios_pt_m),
  "\n"
)

cat(
  "Total de sítios:",
  nrow(sitios_pol_m) + nrow(sitios_pt_m),
  "\n"
)


# ------------------------------------------------------------
# 2. Definir buffers
# ------------------------------------------------------------

buffers_km <- c(
  10,
  25,
  50,
  100
)

cat(
  "\nBuffers que serão calculados:",
  paste(buffers_km, collapse = ", "),
  "km\n"
)


# ------------------------------------------------------------
# 3. Criar tabela inicial
# ------------------------------------------------------------

densidade_arqueologica <- inventarios %>%
  select(
    ponto,
    latitude,
    longitude
  )


# ------------------------------------------------------------
# 4. Calcular densidade em cada escala
# ------------------------------------------------------------

for (raio_km in buffers_km) {
  
  
  cat(
    "\n========================================\n",
    "BUFFER:",
    raio_km,
    "km\n",
    "========================================\n"
  )
  
  
  # ----------------------------------------------------------
  # 4.1 Converter raio para metros
  # ----------------------------------------------------------
  
  raio_m <- raio_km * 1000
  
  
  # ----------------------------------------------------------
  # 4.2 Criar buffers
  # ----------------------------------------------------------
  
  cat(
    "\nCriando buffers de",
    raio_km,
    "km...\n"
  )
  
  buffers <- st_buffer(
    inventarios_m,
    dist = raio_m
  )
  
  
  # ----------------------------------------------------------
  # 4.3 Contar sítios representados por polígonos
  # ----------------------------------------------------------
  
  cat(
    "Contando sítios com geometria poligonal...\n"
  )
  
  inter_pol <- st_intersects(
    buffers,
    sitios_pol_m
  )
  
  n_pol <- lengths(
    inter_pol
  )
  
  
  # ----------------------------------------------------------
  # 4.4 Contar sítios representados apenas por pontos
  # ----------------------------------------------------------
  
  cat(
    "Contando sítios representados por pontos...\n"
  )
  
  inter_pt <- st_intersects(
    buffers,
    sitios_pt_m
  )
  
  n_pt <- lengths(
    inter_pt
  )
  
  
  # ----------------------------------------------------------
  # 4.5 Número total de sítios
  # ----------------------------------------------------------
  
  n_total <- n_pol + n_pt
  
  
  # ----------------------------------------------------------
  # 4.6 Área do buffer em km²
  # ----------------------------------------------------------
  
  area_buffer_km2 <- pi * raio_km^2
  
  
  # ----------------------------------------------------------
  # 4.7 Densidade de sítios
  # ----------------------------------------------------------
  
  densidade <- n_total / area_buffer_km2
  
  
  # ----------------------------------------------------------
  # 4.8 Adicionar resultados à tabela
  # ----------------------------------------------------------
  
  densidade_arqueologica[[
    paste0(
      "n_sitios_",
      raio_km,
      "km"
    )
  ]] <- n_total
  
  
  densidade_arqueologica[[
    paste0(
      "densidade_sitios_",
      raio_km,
      "km"
    )
  ]] <- densidade
  
  
  # ----------------------------------------------------------
  # 4.9 Resumo da escala
  # ----------------------------------------------------------
  
  cat(
    "\nResumo do número de sítios:\n"
  )
  
  print(
    summary(
      n_total
    )
  )
  
  cat(
    "\nInventários sem sítios no buffer:",
    sum(
      n_total == 0
    ),
    "\n"
  )
  
  cat(
    "Inventários com pelo menos um sítio:",
    sum(
      n_total > 0
    ),
    "\n"
  )
  
  cat(
    "Máximo de sítios encontrado:",
    max(
      n_total
    ),
    "\n"
  )
  
  
  # ----------------------------------------------------------
  # 4.10 Liberar memória
  # ----------------------------------------------------------
  
  rm(
    buffers,
    inter_pol,
    inter_pt,
    n_pol,
    n_pt,
    n_total,
    densidade
  )
  
  gc()
}


