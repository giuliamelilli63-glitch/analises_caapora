cat(
  "Sítios poligonais:",
  nrow(sitios_pol_m),
  "\n"
)


# ------------------------------------------------------------
# 2. Definir buffers
# ------------------------------------------------------------

buffers_km <- c(
  10,
  25,
  50,
  100
)


# ------------------------------------------------------------
# 3. Criar tabela inicial
# ------------------------------------------------------------

cobertura_arqueologica <- inventarios %>%
  select(
    ponto,
    latitude,
    longitude
  )


# ------------------------------------------------------------
# 4. Loop por escala
# ------------------------------------------------------------

for (raio_km in buffers_km) {
  
  cat(
    "\n========================================\n",
    "BUFFER:",
    raio_km,
    "km\n",
    "========================================\n"
  )
  
  
  # ----------------------------------------------------------
  # 4.1 Criar buffers
  # ----------------------------------------------------------
  
  raio_m <- raio_km * 1000
  
  cat(
    "Criando buffers...\n"
  )
  
  buffers <- st_buffer(
    inventarios_m,
    dist = raio_m
  )
  
  
  # ----------------------------------------------------------
  # 4.2 Área de cada buffer
  # ----------------------------------------------------------
  
  area_buffer_km2 <- as.numeric(
    st_area(
      buffers
    )
  ) / 1e6
  
  
  # ----------------------------------------------------------
  # 4.3 Identificar quais polígonos intersectam cada buffer
  # ----------------------------------------------------------
  
  cat(
    "Identificando interseções...\n"
  )
  
  inter <- st_intersects(
    buffers,
    sitios_pol_m
  )
  
  
  # ----------------------------------------------------------
  # 4.4 Preparar vetores de resultado
  # ----------------------------------------------------------
  
  area_sitios_km2 <- numeric(
    nrow(buffers)
  )
  
  n_poligonos_intersectados <- numeric(
    nrow(buffers)
  )
  
  
  # ----------------------------------------------------------
  # 4.5 Calcular área de sítios dentro de cada buffer
  # ----------------------------------------------------------
  
  cat(
    "Calculando áreas intersectadas...\n"
  )
  
  for (i in seq_len(
    nrow(buffers)
  )) {
    
    ids <- inter[[i]]
    
    if (length(ids) == 0) {
      
      area_sitios_km2[i] <- 0
      
      n_poligonos_intersectados[i] <- 0
      
    } else {
      
      sitios_i <- sitios_pol_m[
        ids,
      ]
      
      intersecao_i <- suppressWarnings(
        st_intersection(
          sitios_i,
          buffers[i, ]
        )
      )
      
      if (nrow(intersecao_i) == 0) {
        
        area_sitios_km2[i] <- 0
        
      } else {
        
        area_sitios_km2[i] <- sum(
          as.numeric(
            st_area(
              intersecao_i
            )
          ),
          na.rm = TRUE
        ) / 1e6
      }
      
      n_poligonos_intersectados[i] <-
        length(ids)
    }
  }
  
  
  # ----------------------------------------------------------
  # 4.6 Porcentagem do buffer coberta por sítios
  # ----------------------------------------------------------
  
  pct_cobertura <- (
    area_sitios_km2 /
      area_buffer_km2
  ) * 100
  
  
  # ----------------------------------------------------------
  # 4.7 Adicionar à tabela
  # ----------------------------------------------------------
  
  cobertura_arqueologica[[
    paste0(
      "area_sitios_km2_",
      raio_km,
      "km"
    )
  ]] <- area_sitios_km2
  
  cobertura_arqueologica[[
    paste0(
      "pct_cobertura_sitios_",
      raio_km,
      "km"
    )
  ]] <- pct_cobertura
  
  cobertura_arqueologica[[
    paste0(
      "n_poligonos_",
      raio_km,
      "km"
    )
  ]] <- n_poligonos_intersectados
  
  
  # ----------------------------------------------------------
  # 4.8 Resumo
  # ----------------------------------------------------------
  
  cat(
    "\nÁrea de sítios (km²):\n"
  )
  
  print(
    summary(
      area_sitios_km2
    )
  )
  
  cat(
    "\n% de cobertura arqueológica:\n"
  )
  
  print(
    summary(
      pct_cobertura
    )
  )
  
  cat(
    "\nInventários sem polígonos arqueológicos no buffer:",
    sum(
      n_poligonos_intersectados == 0
    ),
    "\n"
  )
  
  
  # ----------------------------------------------------------
  # 4.9 Liberar memória
  # ----------------------------------------------------------
  
  rm(
    buffers,
    inter,
    area_sitios_km2,
    pct_cobertura,
    n_poligonos_intersectados
  )
  
  gc()
}


# ------------------------------------------------------------
# 5. Conferir colunas criadas
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "COLUNAS CRIADAS\n",
  "========================================\n"
)

print(
  names(
    cobertura_arqueologica
  )
)


# ------------------------------------------------------------
# 6. Resumo das porcentagens
# ------------------------------------------------------------

colunas_pct <- grep(
  "^pct_cobertura_sitios_",
  names(cobertura_arqueologica),
  value = TRUE
)

cat(
  "\n========================================\n",
  "RESUMO - % COBERTURA ARQUEOLÓGICA\n",
  "========================================\n"
)

print(
  summary(
    cobertura_arqueologica[
      colunas_pct
    ]
  )
)


# ------------------------------------------------------------
# 7. Inventários com zero cobertura
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "INVENTÁRIOS COM 0% DE COBERTURA\n",
  "========================================\n"
)

for (raio_km in buffers_km) {
  
  coluna <- paste0(
    "pct_cobertura_sitios_",
    raio_km,
    "km"
  )
  
  cat(
    raio_km,
    "km:",
    sum(
      cobertura_arqueologica[[coluna]] == 0
    ),
    "de",
    nrow(cobertura_arqueologica),
    "\n"
  )
}


# ------------------------------------------------------------
# 8. Salvar resultado
# ------------------------------------------------------------

arquivo_cobertura <- file.path(
  pasta_variaveis,
  "ocorrencia_cobertura_sitios_arqueologicos_IPHAN.csv"
)

write.csv2(
  cobertura_arqueologica,
  arquivo_cobertura,
  row.names = FALSE
)


# ------------------------------------------------------------
# 9. Final
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "COBERTURA ARQUEOLÓGICA CONCLUÍDA\n",
  "========================================\n",
  "\nArquivo final:\n",
  arquivo_cobertura,
  "\n",
  sep = ""
)
