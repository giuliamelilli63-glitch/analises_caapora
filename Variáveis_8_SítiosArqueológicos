# ============================================================
# PROJETO CAAPORÃ
# VARIÁVEL HUMANA - ARQUEOLOGIA
#
# DISTÂNCIA AO SÍTIO ARQUEOLÓGICO MAIS PRÓXIMO
#
# Matriz: ocorrência
#
# Regra:
# - usar polígono quando disponível
# - usar ponto apenas quando o sítio não possui polígono
# - distância final = menor entre as duas
# ============================================================


# ------------------------------------------------------------
# 0. Pacotes
# ------------------------------------------------------------

library(sf)
library(dplyr)


# ------------------------------------------------------------
# 1. Pastas
# ------------------------------------------------------------

pasta_iphan <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/arqueologia/IPHAN"
)

pasta_processado <- file.path(
  pasta_iphan,
  "02_processado"
)

pasta_variaveis <- file.path(
  pasta_iphan,
  "03_variaveis"
)

dir.create(
  pasta_variaveis,
  recursive = TRUE,
  showWarnings = FALSE
)


# ------------------------------------------------------------
# 2. Abrir inventários de ocorrência
# ------------------------------------------------------------

arquivo_inventarios <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/inventarios/",
  "inventarios_selecionados_coordenadas_validas.csv"
)

inventarios <- read.csv2(
  arquivo_inventarios,
  stringsAsFactors = FALSE
)

cat(
  "\nInventários:",
  nrow(inventarios),
  "\n"
)


# ------------------------------------------------------------
# 3. Transformar inventários em sf
# ------------------------------------------------------------

inventarios_sf <- st_as_sf(
  inventarios,
  coords = c(
    "longitude",
    "latitude"
  ),
  crs = 4326,
  remove = FALSE
)


# ------------------------------------------------------------
# 4. Abrir sítios arqueológicos
# ------------------------------------------------------------

arquivo_poligonos <- file.path(
  pasta_processado,
  "IPHAN_sitios_poligonos.gpkg"
)

arquivo_pontos <- file.path(
  pasta_processado,
  "IPHAN_sitios_pontos_sem_poligono.gpkg"
)

sitios_pol <- st_read(
  arquivo_poligonos,
  quiet = TRUE
)

sitios_pt <- st_read(
  arquivo_pontos,
  quiet = TRUE
)


# ------------------------------------------------------------
# 5. Conferência
# ------------------------------------------------------------

cat(
  "\nPolígonos:",
  nrow(sitios_pol),
  "\n"
)

cat(
  "Pontos:",
  nrow(sitios_pt),
  "\n"
)


# ------------------------------------------------------------
# 6. Remover dimensão Z dos polígonos
# ------------------------------------------------------------
#
# A camada de polígonos veio como XYZ.
# Para distância horizontal, usamos apenas XY.
#
# ------------------------------------------------------------

sitios_pol <- st_zm(
  sitios_pol,
  drop = TRUE,
  what = "ZM"
)


# ------------------------------------------------------------
# 7. Conferir geometrias válidas
# ------------------------------------------------------------

cat(
  "\nGeometrias inválidas nos polígonos:",
  sum(!st_is_valid(sitios_pol)),
  "\n"
)

# corrigir se houver
sitios_pol <- st_make_valid(
  sitios_pol
)


# ------------------------------------------------------------
# 8. Projetar tudo para CRS métrico
# ------------------------------------------------------------
#
# SIRGAS 2000 / Brazil Polyconic
# EPSG:5880
#
# ------------------------------------------------------------

crs_metrico <- 5880

inventarios_m <- st_transform(
  inventarios_sf,
  crs_metrico
)

sitios_pol_m <- st_transform(
  sitios_pol,
  crs_metrico
)

sitios_pt_m <- st_transform(
  sitios_pt,
  crs_metrico
)


# ------------------------------------------------------------
# 9. Distância ao POLÍGONO mais próximo
# ------------------------------------------------------------
#
# st_nearest_feature identifica apenas o objeto mais próximo,
# evitando criar uma matriz gigantesca de distâncias.
#
# ------------------------------------------------------------

cat(
  "\nCalculando sítio poligonal mais próximo...\n"
)

idx_pol <- st_nearest_feature(
  inventarios_m,
  sitios_pol_m
)

dist_pol_m <- st_distance(
  inventarios_m,
  sitios_pol_m[idx_pol, ],
  by_element = TRUE
)

dist_pol_km <- as.numeric(
  dist_pol_m
) / 1000


# ------------------------------------------------------------
# 10. Distância ao PONTO mais próximo
# ------------------------------------------------------------

cat(
  "\nCalculando sítio pontual mais próximo...\n"
)

idx_pt <- st_nearest_feature(
  inventarios_m,
  sitios_pt_m
)

dist_pt_m <- st_distance(
  inventarios_m,
  sitios_pt_m[idx_pt, ],
  by_element = TRUE
)

dist_pt_km <- as.numeric(
  dist_pt_m
) / 1000


# ------------------------------------------------------------
# 11. Distância final
# ------------------------------------------------------------

dist_final_km <- pmin(
  dist_pol_km,
  dist_pt_km,
  na.rm = TRUE
)


# ------------------------------------------------------------
# 12. Identificar qual geometria foi a mais próxima
# ------------------------------------------------------------

tipo_sitio_mais_proximo <- ifelse(
  dist_pol_km <= dist_pt_km,
  "poligono",
  "ponto"
)


# ------------------------------------------------------------
# 13. Identificar o sítio mais próximo
# ------------------------------------------------------------

id_sitio_mais_proximo <- ifelse(
  tipo_sitio_mais_proximo == "poligono",
  sitios_pol_m$id_bem[idx_pol],
  sitios_pt_m$id_bem[idx_pt]
)

nome_sitio_mais_proximo <- ifelse(
  tipo_sitio_mais_proximo == "poligono",
  sitios_pol_m$identificacao_bem[idx_pol],
  sitios_pt_m$identificacao_bem[idx_pt]
)

classificacao_sitio_mais_proximo <- ifelse(
  tipo_sitio_mais_proximo == "poligono",
  sitios_pol_m$ds_classificacao[idx_pol],
  sitios_pt_m$ds_classificacao[idx_pt]
)


# ------------------------------------------------------------
# 14. Adicionar resultados à tabela
# ------------------------------------------------------------

resultado <- inventarios %>%
  mutate(
    distancia_poligono_km = dist_pol_km,
    distancia_ponto_km = dist_pt_km,
    distancia_sitio_arqueologico_km = dist_final_km,
    tipo_geometria_sitio_mais_proximo = tipo_sitio_mais_proximo,
    id_sitio_mais_proximo = id_sitio_mais_proximo,
    nome_sitio_mais_proximo = nome_sitio_mais_proximo,
    classificacao_sitio_mais_proximo =
      classificacao_sitio_mais_proximo
  )


# ------------------------------------------------------------
# 15. Estatísticas
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "DISTÂNCIA AO SÍTIO ARQUEOLÓGICO\n",
  "========================================\n"
