library(readxl)
library(dplyr)


# ------------------------------------------------------------
# 1. Caminhos
# ------------------------------------------------------------

arquivo_matriz <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "Matrizes_ocorrência/",
  "Matriz_original_ocorrencia_brasil_identificacao_recorte1ha_padronizacaobotanica.csv"
)

arquivo_referencias <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "Matriz_refencia/",
  "caapora_base_referencias.xlsx"
)

pasta_saida <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/inventarios"
)

dir.create(
  pasta_saida,
  recursive = TRUE,
  showWarnings = FALSE
)


# ------------------------------------------------------------
# 2. Ler matriz
# ------------------------------------------------------------

matriz <- read.csv2(
  arquivo_matriz,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)


# ------------------------------------------------------------
# 3. Extrair códigos dos inventários selecionados
# ------------------------------------------------------------

inventarios <- names(matriz)[
  grepl(
    "^t[0-9]+$",
    names(matriz),
    ignore.case = TRUE
  )
]

cat(
  "\nInventários selecionados:",
  length(inventarios),
  "\n"
)


# ------------------------------------------------------------
# 4. Ler referências
# ------------------------------------------------------------

referencias <- read_excel(
  arquivo_referencias,
  sheet = "Referencias"
)


# ------------------------------------------------------------
# 5. Padronizar código do ponto
# ------------------------------------------------------------

referencias <- referencias %>%
  mutate(
    ponto = trimws(
      tolower(
        as.character(ponto)
      )
    )
  )

inventarios <- trimws(
  tolower(inventarios)
)


# ------------------------------------------------------------
# 6. Conferir duplicação de códigos na referência
# ------------------------------------------------------------

duplicados <- referencias %>%
  count(ponto) %>%
  filter(n > 1)

cat(
  "\nCódigos duplicados na planilha de referência:",
  nrow(duplicados),
  "\n"
)

if (nrow(duplicados) > 0) {
  print(duplicados)
}


# ------------------------------------------------------------
# 7. Criar tabela dos inventários selecionados
# ------------------------------------------------------------

inventarios_df <- data.frame(
  ponto = inventarios,
  stringsAsFactors = FALSE
)


# ------------------------------------------------------------
# 8. Cruzar com coordenadas
# ------------------------------------------------------------

inventarios_coord <- inventarios_df %>%
  left_join(
    referencias %>%
      select(
        ponto,
        latitude,
        longitude,
        estado,
        municipio,
        nome_do_local,
        dominio,
        `ref-autor`,
        `ref-ano`
      ),
    by = "ponto"
  )


# ------------------------------------------------------------
# 9. Conferir correspondência
# ------------------------------------------------------------

inventarios_coord <- inventarios_coord %>%
  mutate(
    encontrou_referencia =
      !is.na(latitude) |
      !is.na(longitude),
    
    coordenada_completa =
      !is.na(latitude) &
      !is.na(longitude),
    
    coordenada_valida =
      coordenada_completa &
      longitude >= -180 &
      longitude <= 180 &
      latitude >= -90 &
      latitude <= 90
  )


# ------------------------------------------------------------
# 10. Resumo
# ------------------------------------------------------------

