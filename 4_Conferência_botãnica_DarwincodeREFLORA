      indices_incompletas
    ]
  )


# ============================================================
# 38. FUNÇÃO PARA EXTRAIR INFORMAÇÃO DO GÊNERO
# ============================================================

extrair_genero_validado <- function(coluna) {
  
  resultado <-
    coluna[
      rep(
        NA_integer_,
        nrow(especies)
      )
    ]
  
  indices <- which(
    especies$eh_incompleta &
      especies$genero_validado_reflora %in% TRUE
  )
  
  resultado[
    indices
  ] <-
    coluna[
      posicao_genero[
        indices
      ]
    ]
  
  resultado
}


