# ============================================================
# SCRIPT 01B
# CLASSIFICAR IDENTIFICAÇÕES COMPLETAS E INCOMPLETAS
# MATRIZ DE OCORRÊNCIA
#
# Entrada:
#   Matriz_original_ocorrencia_brasil.csv
#
# Estrutura esperada:
#   especie | t1 | t2 | t3 | ...
#
# Saída:
#   especie | identificacao | t1 | t2 | t3 | ...
#
# familia e genero permanecem fora nesta etapa
# ============================================================


# ============================================================
# 1. CAMINHOS
# ============================================================

pasta_caapora <- "C:/Users/giuli/OneDrive/Documentos/Caapora"


arquivo_entrada <- file.path(
  pasta_caapora,
  "Matrizes_ocorrência",
  "Matriz_original_ocorrencia_brasil.csv"
)


arquivo_saida <- file.path(
  pasta_caapora,
  "Matrizes_ocorrência",
  "Matriz_original_ocorrencia_brasil_identificacao.csv"
)


# ============================================================
# 2. CONFERIR SE O ARQUIVO EXISTE
# ============================================================

if (!file.exists(arquivo_entrada)) {
  
  stop(
    paste0(
      "Arquivo de entrada não encontrado:\n",
      arquivo_entrada
    )
  )
}


# ============================================================
# 3. LER A MATRIZ
# ============================================================

dados <- read.csv2(
  arquivo_entrada,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)


names(dados) <- trimws(
  names(dados)
)


cat(
  "\n============================================\n"
)

cat(
  "MATRIZ DE ENTRADA\n"
)

cat(
  "============================================\n"
)


cat(
  "Número de linhas:",
  nrow(dados),
  "\n"
)


cat(
  "Número de colunas:",
  ncol(dados),
  "\n"
)


cat(
  "\nPrimeiras colunas:\n"
)


print(
  names(dados)[
    1:min(
      10,
      ncol(dados)
    )
  ]
)


# ============================================================
# 4. PADRONIZAR TEMPORARIAMENTE OS NOMES DAS COLUNAS
# ============================================================

nomes_colunas <- tolower(
  trimws(
    iconv(
      names(dados),
      from = "",
      to = "ASCII//TRANSLIT",
      sub = ""
    )
  )
)


# ============================================================
# 5. LOCALIZAR A COLUNA especie
# ============================================================

col_especie <- which(
  nomes_colunas == "especie"
)


if (length(col_especie) != 1) {
  
  stop(
    "A coluna 'especie' não foi encontrada ou está duplicada."
  )
}


# ============================================================
# 6. CONFERIR SE familia E genero ESTÃO FORA
# ============================================================

colunas_indesejadas <- nomes_colunas %in% c(
  "familia",
  "genero"
)


if (any(colunas_indesejadas)) {
  
  cat(
    "\nATENÇÃO: foram encontradas as colunas familia/genero.\n"
  )
  
  cat(
    "Elas serão removidas nesta etapa.\n"
  )
  
  dados <- dados[
    ,
    !colunas_indesejadas,
    drop = FALSE
  ]
  
  
  nomes_colunas <- tolower(
    trimws(
      iconv(
        names(dados),
        from = "",
        to = "ASCII//TRANSLIT",
        sub = ""
      )
    )
  )
  
  
  col_especie <- which(
    nomes_colunas == "especie"
  )
}


# ============================================================
# 7. REMOVER identificacao ANTIGA, SE EXISTIR
#
# A classificação será refeita do zero.
# ============================================================

col_identificacao_antiga <- which(
  nomes_colunas == "identificacao"
)


if (length(col_identificacao_antiga) > 0) {
  
  cat(
    "\nColuna 'identificacao' antiga encontrada.\n"
  )
  
  cat(
    "Ela será removida e reconstruída.\n"
  )
  
  
  dados <- dados[
    ,
    -col_identificacao_antiga,
    drop = FALSE
  ]
  
  
  nomes_colunas <- tolower(
    trimws(
      iconv(
        names(dados),
        from = "",
        to = "ASCII//TRANSLIT",
        sub = ""
      )
    )
  )
  
  
  col_especie <- which(
    nomes_colunas == "especie"
  )
}


# ============================================================
# 8. PADRONIZAR TEMPORARIAMENTE OS NOMES DAS ESPÉCIES
#
# IMPORTANTE:
# a coluna especie original NÃO será alterada.
# ============================================================

especie_padronizada <- tolower(
  trimws(
    iconv(
      as.character(
        dados[[col_especie]]
      ),
      from = "",
      to = "ASCII//TRANSLIT",
      sub = ""
    )
  )
)


# ------------------------------------------------------------
# Transformar espaços em underline
#
# Exemplo:
# "inga sp" -> "inga_sp"
# ------------------------------------------------------------

especie_padronizada <- gsub(
  "[[:space:]]+",
  "_",
  especie_padronizada
)


# ------------------------------------------------------------
# Remover underlines repetidos
# ------------------------------------------------------------

especie_padronizada <- gsub(
  "_+",
  "_",
  especie_padronizada
)


# ------------------------------------------------------------
# Remover underline do início/final
# ------------------------------------------------------------

especie_padronizada <- gsub(
  "^_|_$",
  "",
  especie_padronizada
)


# ============================================================
# 9. LISTA MANUAL DE IDENTIFICAÇÕES INCOMPLETAS
#
# Estes nomes foram previamente conferidos como incompletos.
# Esta lista complementa as regras automáticas.
# ============================================================

nomes_incompletos_manuais <- c(
  
  "aspidosperma_pir",
  "blanchetiana",
  "chamaecrista",
  "cnidosculus",
  "hippocratea_sp",
  "meliosma",
  "metrodorea",
  "pilocarpus",
  "schizolobium_sp",
  "salacia_sp",
  "tibouchina_sip",
  "undulata",
  "abarema",
  "caerulescens",
  "dalbergia",
  "dendropanax",
  "eugenia_so",
  "hymenaea",
  "lonchocarpus",
  "outras",
  "strine"
  
)


nomes_incompletos_manuais <- unique(
  nomes_incompletos_manuais
)


# ============================================================
# 10. REGRA AUTOMÁTICA PARA IDENTIFICAÇÕES INCOMPLETAS
#
# Exemplos:
#
# inga_indet
# inga_sp
# inga_ssp
# indet
# indet_indet
# indet_sp
# indet_t
# indet_tt
# ============================================================

incompleta_regra_automatica <-
  
  grepl(
    "_(indet|sp|ssp)$",
    especie_padronizada
  ) |
  
  grepl(
    "^indet($|_)",
    especie_padronizada
  )


# ============================================================
# 11. REGRA DA LISTA MANUAL
# ============================================================

incompleta_lista_manual <-
  especie_padronizada %in%
  nomes_incompletos_manuais


# ============================================================
# 12. CLASSIFICAÇÃO FINAL
#
# Incompleta se:
#
#   - atender à regra automática
# OU
#   - estiver na lista manual
# ============================================================

identificacao_incompleta <-
  incompleta_regra_automatica |
  incompleta_lista_manual


identificacao_nova <- ifelse(
  identificacao_incompleta,
  "incompleta",
  "completa"
)


# ============================================================
# 13. INSERIR COLUNA identificacao
# ============================================================

dados$identificacao <- identificacao_nova


# ============================================================
# 14. REORDENAR AS COLUNAS
#
# Resultado:
#
# especie | identificacao | inventários
# ============================================================

inventarios <- grep(
  "^t[0-9]+$",
  names(dados),
  value = TRUE
)


if (length(inventarios) == 0) {
  
  stop(
    "Nenhuma coluna de inventário foi encontrada."
  )
}


dados <- dados[
  ,
  c(
    "especie",
    "identificacao",
    inventarios
  ),
  drop = FALSE
]


# ============================================================
# 15. CONFERIR SE EXISTEM COLUNAS INESPERADAS
# ============================================================

colunas_esperadas <- c(
  "especie",
  "identificacao",
  inventarios
)


colunas_extras <- setdiff(
  names(dados),
  colunas_esperadas
)


if (length(colunas_extras) > 0) {
  
  warning(
    paste0(
      "Existem colunas adicionais na matriz: ",
      paste(
        colunas_extras,
        collapse = ", "
      )
    )
  )
}


# ============================================================
# 16. CRIAR TABELAS PARA CONFERÊNCIA
# ============================================================

registros_incompletos <- dados[
  identificacao_incompleta,
  ,
  drop = FALSE
]


registros_completos <- dados[
  !identificacao_incompleta,
  ,
  drop = FALSE
]


registros_incompletos_regra_automatica <- dados[
  incompleta_regra_automatica,
  ,
  drop = FALSE
]


registros_incompletos_lista_manual <- dados[
  incompleta_lista_manual,
  ,
  drop = FALSE
]


# ============================================================
# 17. CONFERIR NOMES DA LISTA MANUAL
# ============================================================

nomes_manuais_encontrados <- intersect(
  nomes_incompletos_manuais,
  unique(
    especie_padronizada
  )
)


nomes_manuais_nao_encontrados <- setdiff(
  nomes_incompletos_manuais,
  unique(
    especie_padronizada
  )
)


cat(
  "\n============================================\n"
)

cat(
  "CONFERÊNCIA DA LISTA MANUAL\n"
)

cat(
  "============================================\n"
)


cat(
  "Nomes da lista manual:",
  length(nomes_incompletos_manuais),
  "\n"
)


cat(
  "Nomes encontrados:",
  length(nomes_manuais_encontrados),
  "\n"
)


cat(
  "Nomes não encontrados:",
  length(nomes_manuais_nao_encontrados),
  "\n"
)


if (length(nomes_manuais_nao_encontrados) > 0) {
  
  cat(
    "\nNomes manuais não encontrados:\n"
  )
  
  print(
    nomes_manuais_nao_encontrados
  )
}


# ============================================================
# 18. CONFERIR CASOS CLASSIFICADOS PELAS DUAS REGRAS
#
# Isso evita interpretar a soma das categorias como
# número total de identificações incompletas.
# ============================================================

incompleta_ambas_regras <-
  incompleta_regra_automatica &
  incompleta_lista_manual


cat(
  "\nRegistros reconhecidos simultaneamente ",
  "pela regra automática e pela lista manual:",
  sum(
    incompleta_ambas_regras,
    na.rm = TRUE
  ),
  "\n"
)


# ============================================================
# 19. SALVAR MATRIZ COM identificacao
# ============================================================

write.csv2(
  dados,
  arquivo_saida,
  row.names = FALSE,
  fileEncoding = "latin1"
)


# ============================================================
# 20. SALVAR LISTA DE IDENTIFICAÇÕES INCOMPLETAS
#
# Aqui vamos salvar somente:
# especie + identificacao
#
# Não há necessidade de repetir milhares de colunas de
# inventários apenas para conferir os nomes.
# ============================================================

tabela_incompletos <- registros_incompletos[
  ,
  c(
    "especie",
    "identificacao"
  ),
  drop = FALSE
]


write.csv2(
  tabela_incompletos,
  file.path(
    pasta_caapora,
    "Matrizes_ocorrência",
    "registros_identificacao_incompleta_ocorrencia.csv"
  ),
  row.names = FALSE,
  fileEncoding = "latin1"
)


# ============================================================
# 21. SALVAR LISTA DOS CASOS DA REGRA AUTOMÁTICA
# ============================================================

tabela_regra_automatica <-
  registros_incompletos_regra_automatica[
    ,
    c(
      "especie",
      "identificacao"
    ),
    drop = FALSE
  ]


write.csv2(
  tabela_regra_automatica,
  file.path(
    pasta_caapora,
    "Matrizes_ocorrência",
    "registros_incompletos_regra_automatica_ocorrencia.csv"
  ),
  row.names = FALSE,
  fileEncoding = "latin1"
)


# ============================================================
# 22. SALVAR LISTA DOS CASOS MANUAIS
# ============================================================

tabela_lista_manual <-
  registros_incompletos_lista_manual[
    ,
    c(
      "especie",
      "identificacao"
    ),
    drop = FALSE
  ]


write.csv2(
  tabela_lista_manual,
  file.path(
    pasta_caapora,
    "Matrizes_ocorrência",
    "registros_incompletos_lista_manual_ocorrencia.csv"
  ),
  row.names = FALSE,
  fileEncoding = "latin1"
)


# ============================================================
# 23. RESUMO FINAL
# ============================================================

cat(
  "\n\n============================================\n"
)

cat(
  "SCRIPT 01B CONCLUÍDO\n"
)

cat(
  "CLASSIFICAÇÃO DAS IDENTIFICAÇÕES\n"
)

cat(
  "============================================\n"
)


cat(
  "\nMATRIZ\n"
)


cat(
  "Total de registros:",
  nrow(dados),
  "\n"
)


cat(
  "Número de inventários:",
  length(inventarios),
  "\n"
)


cat(
  "\nIDENTIFICAÇÃO\n"
)


cat(
  "Completas:",
  sum(
    !identificacao_incompleta,
    na.rm = TRUE
  ),
  "\n"
)


cat(
  "Incompletas:",
  sum(
    identificacao_incompleta,
    na.rm = TRUE
  ),
  "\n"
)


cat(
  "Reconhecidas pela regra automática:",
  sum(
    incompleta_regra_automatica,
    na.rm = TRUE
  ),
  "\n"
)


cat(
  "Presentes na lista manual:",
  sum(
    incompleta_lista_manual,
    na.rm = TRUE
  ),
  "\n"
)


cat(
  "Presentes nas duas regras:",
  sum(
    incompleta_ambas_regras,
    na.rm = TRUE
  ),
  "\n"
)


cat(
  "\nESTRUTURA FINAL\n"
)


cat(
  "especie | identificacao | inventários\n"
)


cat(
  "familia: fora da matriz\n"
)

cat(
  "genero: fora da matriz\n"
)


cat(
  "\nPrimeiras colunas:\n"
)


print(
  names(dados)[
    1:min(
      10,
      ncol(dados)
    )
  ]
)


cat(
  "\nNenhuma linha foi excluída nesta etapa.\n"
)


cat(
  "\nArquivo principal salvo em:\n",
  arquivo_saida,
  "\n"
)


cat(
  "\n============================================\n"
)


# ============================================================
# 24. VISUALIZAR IDENTIFICAÇÕES INCOMPLETAS
# ============================================================

View(
  tabela_incompletos
)
