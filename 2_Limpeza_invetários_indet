# Ler a matriz
dados <- read.csv2(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/Matrizes_abundancia/Matriz_original_abundancia_brasil.csv",
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)

# Padronizar temporariamente os nomes das colunas
nomes_colunas <- tolower(
  trimws(
    iconv(
      colnames(dados),
      from = "",
      to = "ASCII//TRANSLIT",
      sub = ""
    )
  )
)

# Localizar as colunas especie e identificacao
col_especie <- which(nomes_colunas == "especie")
col_identificacao <- which(nomes_colunas == "identificacao")

# Conferir se as colunas foram encontradas
if (length(col_especie) != 1) {
  stop("A coluna 'especie' não foi encontrada ou está duplicada.")
}

if (length(col_identificacao) != 1) {
  stop("A coluna 'identificacao' não foi encontrada ou está duplicada.")
}

# Padronizar temporariamente os nomes das espécies
# A coluna original não será alterada
especie_padronizada <- tolower(
  trimws(
    iconv(
      as.character(dados[[col_especie]]),
      from = "",
      to = "ASCII//TRANSLIT",
      sub = ""
    )
  )
)

# Identificar registros com identificação incompleta
#
# Exemplos classificados como incompletos:
# inga_indet
# inga_sp
# inga_ssp
# indet
# indet_indet
# indet_sp
# indet_t_
# indet_tt_

identificacao_incompleta <-
  grepl("_(indet|sp|ssp)_*$", especie_padronizada) |
  grepl("^indet($|_)", especie_padronizada)

# Preencher a coluna identificacao
dados[[col_identificacao]] <- ifelse(
  identificacao_incompleta,
  "incompleta",
  "completa"
)

# Salvar a matriz completa, sem excluir nenhuma espécie
write.csv2(
  dados,
  "Matriz_original_ocorrencia_brasil_identificacao.csv",
  row.names = FALSE,
  fileEncoding = "latin1"
)


# Mostrar resumo
cat("Total de registros na matriz:", nrow(dados), "\n")
cat(
  "Registros com identificação completa:",
  sum(!identificacao_incompleta, na.rm = TRUE),
  "\n"
)
cat(
  "Registros com identificação incompleta:",
  sum(identificacao_incompleta, na.rm = TRUE),
  "\n"
)
cat("Nenhuma linha foi excluída.\n")

