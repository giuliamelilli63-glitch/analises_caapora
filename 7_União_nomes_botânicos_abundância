# ============================================================
# 3. FUNÇÃO PARA NORMALIZAR NOMES
# ============================================================

normalizar_nome <- function(x) {
  
  x <- as.character(x)
  
  x <- iconv(
    x,
    from = "",
    to = "ASCII//TRANSLIT",
    sub = ""
  )
  
  x <- tolower(x)
  
  x <- gsub(
    "_",
    " ",
    x,
    fixed = TRUE
  )
  
  x <- gsub(
    "[[:space:]]+",
    " ",
    x
  )
  
  x <- trimws(x)
  
  x[x == ""] <- NA_character_
  
  x
}


