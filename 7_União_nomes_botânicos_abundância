# 27. FINAL
# ============================================================

cat(
  "\nA2 CONCLUÍDO.\n"
)

cat(
  "\nMatriz consolidada:\n",
  arquivo_saida_csv,
  "\n"
)

cat(
  "\nRelatório:\n",
  arquivo_relatorio,
  "\n"
)

cat(
  "\nIMPORTANTE:\n"
)

cat(
  "- completas com correspondência foram consolidadas por SOMA\n"
)

cat(
  "- completas sem correspondência permaneceram separadas\n"
)

cat(
  "- incompletas permaneceram separadas\n"
)

cat(
  "- abundância total preservada =",
