      identificacao_completa &
      encontrou_correspondencia
    
  )


# ============================================================
# 22. APLICAR NOME CORRIGIDO
#
# Somente às identificações completas com correspondência.
#
# Incompletas permanecem exatamente como estavam.
#
# Completas sem correspondência também permanecem com
# o nome original POR ENQUANTO.
# ============================================================

matriz_harmonizada <- matriz_harmonizada %>%
  
  mutate(
    
    especie =
      case_when(
        
        harmonizacao_realizada ~
          
          especie_harmonizada,
        
        TRUE ~
          
          especie_original
      ),
    
    identificacao =
      identificacao_original
    
  )


# ============================================================
# 23. REGISTRAR COMPLETAS SEM CORRESPONDÊNCIA
#
# NÃO serão excluídas agora.
# ============================================================

completas_sem_correspondencia <- matriz_harmonizada %>%
  
  filter(
    
    identificacao_completa,
    
    !encontrou_correspondencia
    
  ) %>%
  
  select(
    
    numero_linha_original,
    
    especie_original,
    
    identificacao_original,
    
    chave_taxonomica
    
  ) %>%
  
  arrange(
    especie_original
  )


# ============================================================
# 24. NOMES HARMONIZADOS
# ============================================================

nomes_harmonizados <- matriz_harmonizada %>%
  
  filter(
    harmonizacao_realizada
  ) %>%
  
  transmute(
    
    numero_linha_original,
    
    especie_original,
    
    especie_harmonizada =
      especie,
    
    nome_aceito_com_autoria =
      nome_aceito_reflora
    
  ) %>%
  
  arrange(
    especie_original
  )


# ============================================================
# 25. NOMES EFETIVAMENTE ALTERADOS
# ============================================================

nomes_alterados <- nomes_harmonizados %>%
  
  filter(
    
    normalizar_nome(
      especie_original
    ) !=
      normalizar_nome(
        especie_harmonizada
      )
    
  )


# ============================================================
# 26. CRIAR STATUS PARA PRÓXIMAS ETAPAS
#
# Este campo será MUITO importante no A2/A3.
# ============================================================

matriz_harmonizada <- matriz_harmonizada %>%
  
  mutate(
    
    status_harmonizacao =
      case_when(
        
        identificacao_completa &
          encontrou_correspondencia ~
          
          "completa_com_correspondencia",
        
        identificacao_completa &
          !encontrou_correspondencia ~
          
          "completa_sem_correspondencia",
        
        TRUE ~
          
          "incompleta"
        
      )
    
  )


# ============================================================
# 27. MATRIZ DE SAÍDA A1
#
# Mantemos todas as linhas.
# ============================================================

matriz_saida <- matriz_harmonizada %>%
  
  select(
    
    especie_original,
    
    especie,
    
    identificacao,
    
    status_harmonizacao,
    
    all_of(
      colunas_inventarios
