)

numero_sem_correspondencia <- sum(
  matriz_harmonizada$identificacao ==
    "sem_correspondencia",
  na.rm = TRUE
)

numero_linhas_removidas <-
  nrow(matriz) -
  nrow(matriz_final)

numero_completas_finais <- sum(
  matriz_final$identificacao == "completa",
  na.rm = TRUE
)

numero_incompletas_finais <- sum(
  matriz_final$identificacao == "incompleta",
  na.rm = TRUE
)

numero_sem_correspondencia_finais <- sum(
  matriz_final$identificacao ==
    "sem_correspondencia",
  na.rm = TRUE
)

cat(
  "\n==========================================",
  "\nRESUMO DA HARMONIZAÇÃO DA ABUNDÂNCIA",
  "\n==========================================",
  
  "\nLinhas na matriz original:",
  nrow(matriz),
  
  "\nIdentificações completas originais:",
  numero_completas_originais,
  
  "\nIdentificações incompletas originais:",
  numero_incompletas_originais,
  
  "\nLinhas completas harmonizadas:",
  numero_harmonizadas,
  
  "\nCompletas sem correspondência:",
  numero_sem_correspondencia,
  
  "\nLinhas com mudança de gênero:",
  nrow(mudancas_genero),
  
  "\nLinhas com mudança de família:",
  nrow(mudancas_familia),
  
  "\nGrupos completos consolidados:",
  sum(
    linhas_realmente_unidas$identificacao == "completa",
