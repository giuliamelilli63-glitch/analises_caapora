# ============================================================
# HARMONIZAÇÃO TAXONÔMICA DA MATRIZ DE ABUNDÂNCIA
# ============================================================

# Instalar somente se necessário:
# install.packages(c("dplyr", "readxl", "stringr", "openxlsx"))

library(dplyr)
library(readxl)
library(stringr)
library(openxlsx)

# ------------------------------------------------------------
# 1. Caminhos
# ------------------------------------------------------------

arquivo_matriz <- file.path(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/Matrizes_abundancia/",
  "Matriz_original_abundancia_brasil_identificacao.csv"
)

arquivo_taxonomia <- file.path(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/nomes_botanicos/",
  "especies_conferidas_reflora_taxon.xlsx"
)

pasta_resultados <- file.path(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/Matrizes_abundancia"
)


# ------------------------------------------------------------
# 2. Ler a matriz de abundância
# ------------------------------------------------------------

matriz <- read.csv2(
  arquivo_matriz,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)

cat(
  "\nDimensões da matriz original:\n",
  "Linhas:", nrow(matriz), "\n",
  "Colunas:", ncol(matriz), "\n"
)

# ------------------------------------------------------------
# 3. Conferir colunas obrigatórias
# ------------------------------------------------------------

colunas_obrigatorias <- c(
  "familia",
  "genero",
  "especie",
  "identificacao"
)

colunas_ausentes <- setdiff(
  colunas_obrigatorias,
  names(matriz)
)

if (length(colunas_ausentes) > 0) {
  stop(
    paste0(
      "As seguintes colunas não foram encontradas na matriz: ",
      paste(colunas_ausentes, collapse = ", ")
    )
  )
}

# ------------------------------------------------------------
# 4. Identificar as colunas dos inventários
# ------------------------------------------------------------

colunas_inventarios <- grep(
  "^t[0-9]+$",
  names(matriz),
  value = TRUE
)

if (length(colunas_inventarios) == 0) {
  stop(
    "Nenhuma coluna de inventário com padrão t + número foi encontrada."
  )
}

cat(
  "Número de inventários:",
  length(colunas_inventarios),
  "\n"
)

# ------------------------------------------------------------
# 5. Guardar as informações originais
# ------------------------------------------------------------

matriz <- matriz %>%
  mutate(
    numero_linha_original = row_number(),
    
    familia_original = as.character(familia),
    
    genero_original = as.character(genero),
    
    especie_original = as.character(especie),
    
    identificacao_original = as.character(identificacao),
    
    chave_taxonomica = especie %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    identificacao_padronizada = identificacao %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower()
  )

# ------------------------------------------------------------
# 6. Conferir os valores de identificação
# ------------------------------------------------------------

cat("\nValores encontrados na coluna identificacao:\n")

print(
  matriz %>%
    count(
      identificacao_original,
      sort = TRUE
    )
)

# ------------------------------------------------------------
# 7. Ler a planilha taxonômica conferida
# ------------------------------------------------------------

taxonomia <- read_excel(
  arquivo_taxonomia,
  sheet = 1,
  .name_repair = "unique"
)

cat("\nColunas da planilha taxonômica:\n")
print(names(taxonomia))

# A primeira coluna contém o nome usado como chave:
# abarema_acreana
# abarema_adenophora
# etc.

nome_primeira_coluna <- names(taxonomia)[1]

taxonomia <- taxonomia %>%
  rename(
    chave_taxonomica = all_of(nome_primeira_coluna)
  )

# ------------------------------------------------------------
# 8. Conferir as colunas taxonômicas necessárias
# ------------------------------------------------------------

colunas_taxonomicas_obrigatorias <- c(
  "nome_aceito_reflora",
  "familia_reflora"
)

colunas_taxonomicas_ausentes <- setdiff(
  colunas_taxonomicas_obrigatorias,
  names(taxonomia)
)

if (length(colunas_taxonomicas_ausentes) > 0) {
  stop(
    paste0(
      "As seguintes colunas não foram encontradas na planilha taxonômica: ",
      paste(colunas_taxonomicas_ausentes, collapse = ", ")
    )
  )
}

# ------------------------------------------------------------
# 9. Preparar a tabela taxonômica
# ------------------------------------------------------------

taxonomia <- taxonomia %>%
  mutate(
    chave_taxonomica = chave_taxonomica %>%
      as.character() %>%
      str_squish() %>%
      str_to_lower(),
    
    nome_aceito_reflora = nome_aceito_reflora %>%
      as.character() %>%
      str_squish(),
    
    familia_reflora = familia_reflora %>%
      as.character() %>%
      str_squish()
  )

# ------------------------------------------------------------
# 10. Retirar a autoria do nome aceito
# ------------------------------------------------------------

taxonomia <- taxonomia %>%
  mutate(
    nome_aceito_sem_autoria = case_when(
      is.na(nome_aceito_reflora) ~ NA_character_,
      
      nome_aceito_reflora == "" ~ NA_character_,
      
      str_to_upper(nome_aceito_reflora) == "NA" ~ NA_character_,
      
      TRUE ~ word(
        nome_aceito_reflora,
        start = 1,
        end = 2
      )
    ),
    
    # O gênero é obtido diretamente do nome aceito
    genero_aceito = case_when(
      is.na(nome_aceito_sem_autoria) ~ NA_character_,
      
      nome_aceito_sem_autoria == "" ~ NA_character_,
      
      TRUE ~ word(
        nome_aceito_sem_autoria,
        start = 1,
        end = 1
      )
    )
  )

# ------------------------------------------------------------
# 11. Verificar chaves repetidas
# ------------------------------------------------------------

chaves_repetidas <- taxonomia %>%
  filter(
    !is.na(chave_taxonomica),
    chave_taxonomica != ""
  ) %>%
  count(
    chave_taxonomica,
    name = "numero_registros"
  ) %>%
  filter(numero_registros > 1) %>%
  arrange(
    desc(numero_registros),
    chave_taxonomica
  )

cat(
  "\nChaves repetidas na planilha taxonômica:",
  nrow(chaves_repetidas),
  "\n"
)

write.xlsx(
  chaves_repetidas,
  file.path(
    pasta_resultados,
    "abundancia_chaves_repetidas_na_planilha_taxonomica.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 12. Verificar conflitos taxonômicos
# ------------------------------------------------------------

conflitos_taxonomicos <- taxonomia %>%
  filter(
    !is.na(chave_taxonomica),
    chave_taxonomica != ""
  ) %>%
  group_by(chave_taxonomica) %>%
  summarise(
    numero_nomes_aceitos = n_distinct(
      nome_aceito_sem_autoria,
      na.rm = TRUE
    ),
    
    nomes_aceitos = paste(
      sort(unique(na.omit(nome_aceito_sem_autoria))),
      collapse = " | "
    ),
    
    familias = paste(
      sort(unique(na.omit(familia_reflora))),
      collapse = " | "
    ),
    
    .groups = "drop"
  ) %>%
  filter(numero_nomes_aceitos > 1)

cat(
  "Chaves com mais de um nome aceito:",
  nrow(conflitos_taxonomicos),
  "\n"
)

write.xlsx(
  conflitos_taxonomicos,
  file.path(
    pasta_resultados,
    "abundancia_conflitos_de_nomes_aceitos.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 13. Manter uma correspondência por chave
# ------------------------------------------------------------

taxonomia_unica <- taxonomia %>%
  filter(
    !is.na(chave_taxonomica),
    chave_taxonomica != ""
  ) %>%
  arrange(
    chave_taxonomica,
    is.na(nome_aceito_sem_autoria),
    nome_aceito_sem_autoria
  ) %>%
  distinct(
    chave_taxonomica,
    .keep_all = TRUE
  ) %>%
  select(
    chave_taxonomica,
    nome_aceito_reflora,
    nome_aceito_sem_autoria,
    genero_aceito,
    familia_reflora
  )

# ------------------------------------------------------------
# 14. Juntar matriz e tabela taxonômica
# ------------------------------------------------------------

matriz_harmonizada <- matriz %>%
  left_join(
    taxonomia_unica,
    by = "chave_taxonomica"
  )

# ------------------------------------------------------------
# 15. Identificar as linhas que podem ser harmonizadas
# ------------------------------------------------------------

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    identificacao_completa =
      identificacao_padronizada == "completa",
    
    encontrou_correspondencia =
      !is.na(nome_aceito_sem_autoria) &
      nome_aceito_sem_autoria != "",
    
    harmonizacao_realizada =
      identificacao_completa &
      encontrou_correspondencia
  )

# ------------------------------------------------------------
# 16. Substituir espécie, gênero e família
# ------------------------------------------------------------

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    especie = case_when(
      harmonizacao_realizada ~ nome_aceito_sem_autoria,
      TRUE ~ especie_original
    ),
    
    genero = case_when(
      harmonizacao_realizada &
        !is.na(genero_aceito) &
        genero_aceito != "" ~ genero_aceito,
      
      TRUE ~ genero_original
    ),
    
    familia = case_when(
      harmonizacao_realizada &
        !is.na(familia_reflora) &
        familia_reflora != "" ~ familia_reflora,
      
      TRUE ~ familia_original
    )
  )

# ------------------------------------------------------------
# 17. Identificações completas sem correspondência
# ------------------------------------------------------------

completas_sem_correspondencia <- matriz_harmonizada %>%
  filter(
    identificacao_completa,
    !encontrou_correspondencia
  ) %>%
  select(
    numero_linha_original,
    familia_original,
    genero_original,
    especie_original,
    identificacao_original,
    chave_taxonomica
  ) %>%
  arrange(especie_original)

cat(
  "\nIdentificações completas sem correspondência:",
  nrow(completas_sem_correspondencia),
  "\n"
)

write.xlsx(
  completas_sem_correspondencia,
  file.path(
    pasta_resultados,
    "abundancia_identificacoes_completas_sem_correspondencia.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
# 18. Criar tabela dos nomes harmonizados
# ------------------------------------------------------------

nomes_harmonizados <- matriz_harmonizada %>%
  filter(harmonizacao_realizada) %>%
  transmute(
    numero_linha_original,
    
    familia_original,
    genero_original,
    especie_original,
    
    familia_harmonizada = familia,
    genero_harmonizado = genero,
    especie_harmonizada = especie,
    
    nome_aceito_com_autoria = nome_aceito_reflora
  ) %>%
  arrange(especie_original)

cat(
  "Linhas harmonizadas:",
  nrow(nomes_harmonizados),
  "\n"
)

# ------------------------------------------------------------
# 19. Identificar nomes efetivamente alterados
# ------------------------------------------------------------

nomes_alterados <- nomes_harmonizados %>%
  filter(
    str_to_lower(str_squish(especie_original)) !=
      str_to_lower(str_squish(especie_harmonizada)) |
      
      str_to_lower(str_squish(genero_original)) !=
      str_to_lower(str_squish(genero_harmonizado)) |
      
      str_to_lower(str_squish(familia_original)) !=
      str_to_lower(str_squish(familia_harmonizada))
  )

# ------------------------------------------------------------
# 20. Identificar mudanças de gênero
# ------------------------------------------------------------

mudancas_genero <- nomes_harmonizados %>%
  filter(
    str_to_lower(str_squish(genero_original)) !=
      str_to_lower(str_squish(genero_harmonizado))
  )

# ------------------------------------------------------------
# 21. Identificar mudanças de família
# ------------------------------------------------------------

mudancas_familia <- nomes_harmonizados %>%
  filter(
    str_to_lower(str_squish(familia_original)) !=
      str_to_lower(str_squish(familia_harmonizada))
  )

# ------------------------------------------------------------
# 22. Conferir identificações incompletas
# ------------------------------------------------------------

incompletas_alteradas <- matriz_harmonizada %>%
  filter(
    !identificacao_completa,
    (
      as.character(familia) != as.character(familia_original) |
        as.character(genero) != as.character(genero_original) |
        as.character(especie) != as.character(especie_original)
    )
  )

cat(
  "Identificações incompletas alteradas:",
  nrow(incompletas_alteradas),
  "\n"
)

if (nrow(incompletas_alteradas) > 0) {
  write.xlsx(
    incompletas_alteradas,
    file.path(
      pasta_resultados,
      "ATENCAO_abundancia_identificacoes_incompletas_alteradas.xlsx"
    ),
    overwrite = TRUE
  )
}

# ------------------------------------------------------------
# 23. Converter as colunas dos inventários para números
# ------------------------------------------------------------

# Guardar os valores antes da conversão para conferir
# quais células não puderam ser convertidas.

matriz_antes_conversao <- matriz_harmonizada

matriz_harmonizada <- matriz_harmonizada %>%
  mutate(
    across(
      all_of(colunas_inventarios),
      ~ suppressWarnings(
        as.numeric(
          str_replace(
            as.character(.x),
            ",",
            "."
          )
        )
      )
    )
  )

# ------------------------------------------------------------
# 24. Conferir problemas na conversão numérica
# ------------------------------------------------------------

problemas_conversao <- data.frame(
  inventario = character(),
  numero_linha_original = integer(),
  especie = character(),
  valor_original = character(),
  stringsAsFactors = FALSE
)

for (coluna in colunas_inventarios) {
  
  original <- as.character(
    matriz_antes_conversao[[coluna]]
  )
  
  convertido <- matriz_harmonizada[[coluna]]
  
  problema <- !is.na(original) &
    trimws(original) != "" &
    is.na(convertido)
  
  if (any(problema)) {
    
    problemas_conversao <- bind_rows(
      problemas_conversao,
      data.frame(
        inventario = coluna,
        
        numero_linha_original =
          matriz_harmonizada$numero_linha_original[problema],
        
        especie =
          matriz_harmonizada$especie[problema],
        
        valor_original =
          original[problema],
        
        stringsAsFactors = FALSE
      )
    )
  }
}

cat(
  "Células que não puderam ser convertidas em números:",
  nrow(problemas_conversao),
  "\n"
)

write.xlsx(
  problemas_conversao,
  file.path(
    pasta_resultados,
    "abundancia_problemas_na_conversao_numerica.xlsx"
  ),
  overwrite = TRUE
)

if (nrow(problemas_conversao) > 0) {
  stop(
    paste0(
      "Existem valores que não puderam ser convertidos em números. ",
      "Confira abundancia_problemas_na_conversao_numerica.xlsx."
    )
  )
}

# ------------------------------------------------------------
# 25. Conferir abundâncias negativas
# ------------------------------------------------------------

valores_negativos <- data.frame(
  inventario = character(),
  numero_linha_original = integer(),
  especie = character(),
  valor = numeric(),
  stringsAsFactors = FALSE
)

for (coluna in colunas_inventarios) {
  
  valores <- matriz_harmonizada[[coluna]]
  
  problema <- !is.na(valores) &
    valores < 0
  
  if (any(problema)) {
    
    valores_negativos <- bind_rows(
      valores_negativos,
      data.frame(
        inventario = coluna,
        
        numero_linha_original =
          matriz_harmonizada$numero_linha_original[problema],
        
        especie =
          matriz_harmonizada$especie[problema],
        
        valor =
          valores[problema],
        
        stringsAsFactors = FALSE
      )
    )
  }
}

cat(
  "Células com valores negativos:",
  nrow(valores_negativos),
  "\n"
)

write.xlsx(
  valores_negativos,
  file.path(
    pasta_resultados,
    "abundancia_valores_negativos.xlsx"
  ),
  overwrite = TRUE
)

if (nrow(valores_negativos) > 0) {
  stop(
    paste0(
      "Foram encontrados valores negativos de abundância. ",
      "Confira abundancia_valores_negativos.xlsx."
    )
  )
}

# ------------------------------------------------------------
# 26. Identificar linhas que serão consolidadas
# ------------------------------------------------------------

resumo_consolidacao <- matriz_harmonizada %>%
  group_by(
    familia,
    genero,
    especie,
    identificacao
  ) %>%
  summarise(
    numero_linhas_unidas = n(),
    
    numeros_linhas_originais = paste(
      numero_linha_original,
      collapse = " | "
    ),
    
    nomes_originais = paste(
      sort(unique(especie_original)),
      collapse = " | "
    ),
    
    .groups = "drop"
  ) %>%
  arrange(
    desc(numero_linhas_unidas),
    especie
  )

linhas_realmente_unidas <- resumo_consolidacao %>%
  filter(numero_linhas_unidas > 1)

cat(
  "\nTáxons que terão duas ou mais linhas consolidadas:",
  nrow(linhas_realmente_unidas),
  "\n"
)

# ------------------------------------------------------------
# 27. Somar as abundâncias das linhas consolidadas
# ------------------------------------------------------------

# Para a matriz de abundância, os valores devem ser somados.
#
# Exemplo:
#
# espécie A: 3 indivíduos
# sinônimo:  2 indivíduos
# resultado: 5 indivíduos
#
# Quando todas as linhas de uma espécie possuem NA
# em determinado inventário, o resultado permanece NA.

soma_sem_transformar_tudo_em_zero <- function(x) {
  
  if (all(is.na(x))) {
    return(NA_real_)
  }
  
  sum(x, na.rm = TRUE)
}

matriz_final <- matriz_harmonizada %>%
  select(
    familia,
    genero,
    especie,
    identificacao,
    all_of(colunas_inventarios)
  ) %>%
  group_by(
    familia,
    genero,
    especie,
    identificacao
  ) %>%
  summarise(
    across(
      all_of(colunas_inventarios),
      soma_sem_transformar_tudo_em_zero
    ),
    .groups = "drop"
  )

# ------------------------------------------------------------
# 28. Conferir abundâncias negativas na matriz final
# ------------------------------------------------------------

valores_finais <- unlist(
  matriz_final[, colunas_inventarios],
  use.names = FALSE
)

valores_finais_negativos <- valores_finais[
  !is.na(valores_finais) &
    valores_finais < 0
]

if (length(valores_finais_negativos) > 0) {
  stop(
    "A matriz final contém abundâncias negativas."
  )
}

# ------------------------------------------------------------
# 29. Conferir duplicações na matriz final
# ------------------------------------------------------------

duplicacoes_finais <- matriz_final %>%
  count(
    familia,
    genero,
    especie,
    identificacao,
    name = "numero_linhas"
  ) %>%
  filter(numero_linhas > 1)

cat(
  "Táxons ainda duplicados na matriz final:",
  nrow(duplicacoes_finais),
  "\n"
)

# ------------------------------------------------------------
# 30. Calcular abundância total e frequência
# ------------------------------------------------------------

resumo_especies <- matriz_final %>%
  mutate(
    # Soma dos indivíduos em todos os inventários
    abundancia_total = rowSums(
      across(all_of(colunas_inventarios)),
      na.rm = TRUE
    ),
    
    # Número de inventários em que a espécie possui abundância > 0
    numero_inventarios = rowSums(
      across(
        all_of(colunas_inventarios),
        ~ !is.na(.x) & .x > 0
      )
    )
  ) %>%
  select(
    familia,
    genero,
    especie,
    identificacao,
    abundancia_total,
    numero_inventarios
  ) %>%
  arrange(
    desc(abundancia_total),
    especie
  )

# ------------------------------------------------------------
# 31. Comparar abundância antes e depois
# ------------------------------------------------------------

abundancia_total_antes <- sum(
  unlist(
    matriz_harmonizada[, colunas_inventarios],
    use.names = FALSE
  ),
  na.rm = TRUE
)

abundancia_total_depois <- sum(
  unlist(
    matriz_final[, colunas_inventarios],
    use.names = FALSE
  ),
  na.rm = TRUE
)

diferenca_abundancia <- abundancia_total_depois -
  abundancia_total_antes

cat(
  "\nAbundância total antes da consolidação:",
  abundancia_total_antes,
  "\nAbundância total depois da consolidação:",
  abundancia_total_depois,
  "\nDiferença:",
  diferenca_abundancia,
  "\n"
)

if (!isTRUE(all.equal(
  abundancia_total_antes,
  abundancia_total_depois
))) {
  warning(
    "A abundância total antes e depois da consolidação é diferente."
  )
}

# ------------------------------------------------------------
# 32. Resumo final
# ------------------------------------------------------------

numero_completas <- sum(
  matriz_harmonizada$identificacao_completa,
  na.rm = TRUE
)

numero_incompletas <- sum(
  !matriz_harmonizada$identificacao_completa,
  na.rm = TRUE
)

numero_harmonizadas <- sum(
  matriz_harmonizada$harmonizacao_realizada,
  na.rm = TRUE
)

numero_linhas_removidas <- nrow(matriz) -
  nrow(matriz_final)

cat(
  "\n==========================================",
  "\nRESUMO DA HARMONIZAÇÃO DA ABUNDÂNCIA",
  "\n==========================================",
  "\nLinhas na matriz original:",
  nrow(matriz),
  "\nIdentificações completas:",
  numero_completas,
  "\nIdentificações incompletas:",
  numero_incompletas,
  "\nLinhas completas harmonizadas:",
  numero_harmonizadas,
  "\nCompletas sem correspondência:",
  nrow(completas_sem_correspondencia),
  "\nLinhas com mudança de gênero:",
  nrow(mudancas_genero),
  "\nLinhas com mudança de família:",
  nrow(mudancas_familia),
  "\nTáxons com linhas consolidadas:",
  nrow(linhas_realmente_unidas),
  "\nLinhas removidas pela consolidação:",
  numero_linhas_removidas,
  "\nLinhas na matriz final:",
  nrow(matriz_final),
  "\nInventários na matriz final:",
  length(colunas_inventarios),
  "\nIdentificações incompletas alteradas:",
  nrow(incompletas_alteradas),
  "\nProblemas na conversão numérica:",
  nrow(problemas_conversao),
  "\nValores negativos:",
  nrow(valores_negativos),
  "\nDuplicações na matriz final:",
  nrow(duplicacoes_finais),
  "\nAbundância total antes:",
  abundancia_total_antes,
  "\nAbundância total depois:",
  abundancia_total_depois,
  "\nDiferença na abundância total:",
  diferenca_abundancia,
  "\n==========================================\n"
)

# ------------------------------------------------------------
# 33. Salvar a matriz antes da consolidação
# ------------------------------------------------------------

write.xlsx(
  matriz_harmonizada,
  file.path(
    pasta_resultados,
    "abundancia_matriz_harmonizada_antes_da_consolidacao.xlsx"
  ),
  overwrite = TRUE
)

# ------------------------------------------------------------
