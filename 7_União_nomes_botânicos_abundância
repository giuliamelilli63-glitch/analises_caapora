  "Linhas de entrada:",
  nrow(matriz),
  "\n"
)


# ============================================================
# 4. CONFERIR COLUNAS OBRIGATÓRIAS
# ============================================================

colunas_obrigatorias <- c(
  "especie_original",
  "especie",
  "identificacao",
  "status_harmonizacao"
)


faltando <- setdiff(
  colunas_obrigatorias,
  names(matriz)
)


if (length(faltando) > 0) {
  
  stop(
    paste0(
      "Colunas obrigatórias ausentes:\n",
      paste(
        faltando,
        collapse = ", "
      )
    )
  )
}


# ============================================================
# 5. IDENTIFICAR INVENTÁRIOS
# ============================================================

colunas_inventarios <- grep(
  "^t[0-9]+$",
  names(matriz),
  value = TRUE
)


if (length(colunas_inventarios) == 0) {
  
  stop(
    "Nenhuma coluna de inventário foi encontrada."
  )
}


cat(
  "Número de inventários:",
  length(colunas_inventarios),
  "\n"
)


# ============================================================
# 6. CONVERTER INVENTÁRIOS PARA NUMÉRICO
# ============================================================

matriz <- matriz %>%
  
  mutate(
    
    across(
      
      all_of(
        colunas_inventarios
      ),
      
      ~ suppressWarnings(
        
        as.numeric(
          
          str_replace(
            as.character(.x),
            ",",
            "."
          )
          
        )
        
      )
      
    )
    
  )


# ============================================================
# 7. ADICIONAR IDENTIFICADOR ÚNICO DE LINHA
#
# Importante para impedir que incompletas ou
# sem correspondência sejam consolidadas.
# ============================================================

matriz <- matriz %>%
  
  mutate(
    id_linha_original = row_number()
  )


# ============================================================
# 8. ABUNDÂNCIA TOTAL ANTES DA CONSOLIDAÇÃO
# ============================================================

abundancia_total_antes <- sum(
  
  unlist(
    matriz[
      ,
      colunas_inventarios,
      drop = FALSE
    ],
    use.names = FALSE
  ),
  
  na.rm = TRUE
)


cat(
  "\nAbundância total antes da consolidação:",
  abundancia_total_antes,
  "\n"
)


# ============================================================
# 9. TOTAIS POR INVENTÁRIO ANTES DA CONSOLIDAÇÃO
# ============================================================

totais_antes <- data.frame(
  
  inventario =
    colunas_inventarios,
  
  abundancia_antes =
    colSums(
      matriz[
        ,
        colunas_inventarios,
        drop = FALSE
      ],
      na.rm = TRUE
    ),
  
  stringsAsFactors = FALSE
)


# ============================================================
# 10. SEPARAR AS TRÊS CATEGORIAS
# ============================================================

completas_com_correspondencia <- matriz %>%
  
  filter(
    status_harmonizacao ==
      "completa_com_correspondencia"
  )


completas_sem_correspondencia <- matriz %>%
  
  filter(
    status_harmonizacao ==
      "completa_sem_correspondencia"
  )


incompletas <- matriz %>%
  
  filter(
    status_harmonizacao ==
      "incompleta"
  )


cat(
  "\nCompletas com correspondência:",
  nrow(completas_com_correspondencia),
  "\n"
)

cat(
  "Completas sem correspondência:",
  nrow(completas_sem_correspondencia),
  "\n"
)

cat(
  "Incompletas:",
  nrow(incompletas),
  "\n"
)


# ============================================================
# 11. IDENTIFICAR GRUPOS QUE SERÃO CONSOLIDADOS
#
# Somente completas com correspondência.
# ============================================================

grupos_consolidacao <- completas_com_correspondencia %>%
  
  group_by(
    especie
  ) %>%
  
  summarise(
    
    numero_linhas =
      n(),
    
    nomes_originais =
      paste(
        sort(
          unique(
            especie_original
          )
        ),
        collapse = " | "
      ),
    
    ids_originais =
      paste(
        id_linha_original,
        collapse = " | "
      ),
    
    .groups = "drop"
    
  ) %>%
  
  arrange(
    desc(numero_linhas),
    especie
  )


grupos_realmente_consolidados <- grupos_consolidacao %>%
  
  filter(
    numero_linhas > 1
  )


cat(
  "\nGrupos com duas ou mais linhas:",
  nrow(
    grupos_realmente_consolidados
  ),
  "\n"
)


# ============================================================
# 12. CONSOLIDAR COMPLETAS COM CORRESPONDÊNCIA
#
# Aqui SOMAMOS abundâncias.
# ============================================================

completas_consolidadas <- completas_com_correspondencia %>%
  
  group_by(
    especie
  ) %>%
  
  summarise(
    
    especie_original =
      paste(
        sort(
          unique(
            especie_original
          )
        ),
        collapse = " | "
      ),
    
    identificacao =
      "completa",
    
    status_harmonizacao =
      "completa_com_correspondencia",
    
    across(
      
      all_of(
        colunas_inventarios
      ),
      
      ~ sum(
        .x,
        na.rm = TRUE
      )
      
    ),
    
    .groups = "drop"
    
  )


# ============================================================
# 13. PREPARAR COMPLETAS SEM CORRESPONDÊNCIA
#
# NÃO consolidar.
# Cada linha continua independente.
# ============================================================

completas_sem_correspondencia_saida <-
  completas_sem_correspondencia %>%
  
  select(
    
    especie_original,
    
    especie,
    
    identificacao,
    
    status_harmonizacao,
    
    all_of(
      colunas_inventarios
    )
    
  )


# ============================================================
# 14. PREPARAR INCOMPLETAS
#
# NÃO consolidar.
#
# Mesmo que duas linhas tenham exatamente o mesmo nome,
# permanecem separadas.
# ============================================================

incompletas_saida <- incompletas %>%
  
  select(
    
    especie_original,
    
    especie,
    
    identificacao,
    
    status_harmonizacao,
    
    all_of(
      colunas_inventarios
    )
    
  )


# ============================================================
# 15. ORGANIZAR COMPLETAS CONSOLIDADAS
# ============================================================

completas_consolidadas <- completas_consolidadas %>%
  
  select(
    
    especie_original,
    
    especie,
    
    identificacao,
    
    status_harmonizacao,
    
    all_of(
      colunas_inventarios
    )
    
  )


# ============================================================
# 16. REUNIR AS TRÊS PARTES
# ============================================================

matriz_consolidada <- bind_rows(
  
  completas_consolidadas,
  
  completas_sem_correspondencia_saida,
  
  incompletas_saida
  
)


# ============================================================
# 17. ABUNDÂNCIA TOTAL DEPOIS DA CONSOLIDAÇÃO
# ============================================================

abundancia_total_depois <- sum(
  
  unlist(
    matriz_consolidada[
      ,
      colunas_inventarios,
      drop = FALSE
    ],
    use.names = FALSE
  ),
  
  na.rm = TRUE
)


diferenca_abundancia <-
  abundancia_total_depois -
  abundancia_total_antes


cat(
  "\nAbundância total depois da consolidação:",
  abundancia_total_depois,
  "\n"
)

cat(
  "Diferença:",
  diferenca_abundancia,
  "\n"
)


if (
  abs(
    diferenca_abundancia
  ) > 1e-8
) {
  
  stop(
    paste0(
      "ERRO: a abundância total mudou!\n",
      "Antes = ",
      abundancia_total_antes,
      "\nDepois = ",
      abundancia_total_depois
    )
  )
}


# ============================================================
# 18. TOTAIS POR INVENTÁRIO DEPOIS
# ============================================================

totais_depois <- data.frame(
  
  inventario =
    colunas_inventarios,
  
  abundancia_depois =
    colSums(
      matriz_consolidada[
        ,
        colunas_inventarios,
        drop = FALSE
      ],
      na.rm = TRUE
    ),
  
  stringsAsFactors = FALSE
)


# ============================================================
# 19. COMPARAR TOTAIS POR INVENTÁRIO
# ============================================================

comparacao_totais <- totais_antes %>%
  
  left_join(
    totais_depois,
    by = "inventario"
  ) %>%
  
  mutate(
    
    diferenca =
      abundancia_depois -
      abundancia_antes,
    
    preservado =
      abs(
        diferenca
      ) < 1e-8
    
  )


inventarios_com_diferenca <- comparacao_totais %>%
  
  filter(
    !preservado
  )


cat(
  "Inventários com alteração da abundância total:",
  nrow(
    inventarios_com_diferenca
  ),
  "\n"
)


if (
  nrow(
    inventarios_com_diferenca
  ) > 0
) {
  
  stop(
    "A abundância não foi preservada em todos os inventários."
  )
}


# ============================================================
# 20. CONFERIR SE COMPLETAS FORAM CONSOLIDADAS
# ============================================================

duplicacoes_completas <- matriz_consolidada %>%
  
  filter(
    status_harmonizacao ==
      "completa_com_correspondencia"
  ) %>%
  
  count(
    especie,
    name = "numero_linhas"
  ) %>%
  
  filter(
    numero_linhas > 1
  )


if (
  nrow(
    duplicacoes_completas
  ) > 0
) {
  
  stop(
    paste0(
      "Ainda existem espécies completas com correspondência ",
      "duplicadas após a consolidação."
    )
  )
}


# ============================================================
# 21. CONFERIR INCOMPLETAS REPETIDAS
#
# Isso NÃO é erro.
#
# Serve apenas para documentar quantos nomes incompletos
# continuam repetidos intencionalmente.
# ============================================================

incompletas_repetidas <- matriz_consolidada %>%
  
  filter(
    status_harmonizacao ==
      "incompleta"
  ) %>%
  
  count(
    especie,
    name =
      "numero_linhas"
  ) %>%
  
  filter(
    numero_linhas > 1
  ) %>%
  
  arrange(
    desc(
      numero_linhas
    ),
    especie
  )


cat(
  "Nomes incompletos repetidos mantidos separadamente:",
  nrow(
    incompletas_repetidas
  ),
  "\n"
)


# ============================================================
# 22. NÚMERO DE LINHAS REMOVIDAS PELA CONSOLIDAÇÃO
# ============================================================

linhas_antes <-
  nrow(
    matriz
  )


linhas_depois <-
  nrow(
    matriz_consolidada
  )


linhas_removidas <-
  linhas_antes -
  linhas_depois


cat(
  "\nLinhas antes:",
  linhas_antes,
  "\n"
)

cat(
  "Linhas depois:",
  linhas_depois,
  "\n"
)

cat(
  "Linhas removidas pela consolidação:",
  linhas_removidas,
  "\n"
)


# ============================================================
# 23. CONTAGENS FINAIS POR STATUS
# ============================================================

contagem_status_final <- matriz_consolidada %>%
  
  count(
    status_harmonizacao,
    sort = TRUE
  )


cat(
  "\nStatus finais:\n"
)

print(
  contagem_status_final
)


# ============================================================
# 24. RESUMO FINAL
# ============================================================

resumo <- data.frame(
  
  Indicador = c(
    
    "Linhas antes da consolidação",
    
    "Completas com correspondência antes da consolidação",
    
    "Completas sem correspondência",
    
    "Identificações incompletas",
    
    "Grupos de completas realmente consolidados",
    
    "Linhas removidas pela consolidação",
    
    "Linhas depois da consolidação",
    
    "Completas com correspondência após consolidação",
    
    "Completas sem correspondência após consolidação",
    
    "Incompletas após consolidação",
    
    "Nomes incompletos repetidos mantidos separadamente",
    
    "Abundância total antes",
    
    "Abundância total depois",
    
    "Diferença na abundância",
    
    "Inventários com alteração no total",
    
    "Número de inventários"
    
  ),
  
  Quantidade = c(
    
    linhas_antes,
    
    nrow(
      completas_com_correspondencia
    ),
    
    nrow(
      completas_sem_correspondencia
    ),
    
    nrow(
      incompletas
    ),
    
    nrow(
      grupos_realmente_consolidados
    ),
    
    linhas_removidas,
    
    linhas_depois,
    
    sum(
      matriz_consolidada$
        status_harmonizacao ==
        "completa_com_correspondencia"
    ),
    
    sum(
      matriz_consolidada$
        status_harmonizacao ==
        "completa_sem_correspondencia"
    ),
    
    sum(
      matriz_consolidada$
        status_harmonizacao ==
        "incompleta"
    ),
    
    nrow(
      incompletas_repetidas
    ),
    
    abundancia_total_antes,
    
    abundancia_total_depois,
    
    diferenca_abundancia,
    
    nrow(
      inventarios_com_diferenca
    ),
    
    length(
      colunas_inventarios
    )
    
  ),
  
  stringsAsFactors = FALSE
)


cat(
  "\n============================================\n"
)

cat(
  "RESUMO - A2 CONSOLIDAÇÃO DA ABUNDÂNCIA\n"
)

cat(
  "============================================\n"
)

print(
  resumo
)

cat(
  "============================================\n"
)


# ============================================================
# 25. SALVAR MATRIZ CONSOLIDADA
# ============================================================

write.csv2(
  
  matriz_consolidada,
  
  arquivo_saida_csv,
  
  row.names = FALSE,
  
  fileEncoding =
    "latin1"
  
)


write.xlsx(
  
  matriz_consolidada,
  
  arquivo_saida_xlsx,
  
  overwrite = TRUE
  
)


# ============================================================
# 26. SALVAR RELATÓRIO
# ============================================================

write.xlsx(
  
  list(
    
    resumo =
      resumo,
    
    status_final =
      contagem_status_final,
    
    grupos_consolidados =
      grupos_realmente_consolidados,
    
    incompletas_repetidas =
      incompletas_repetidas,
    
    totais_por_inventario =
      comparacao_totais,
    
    inventarios_com_diferenca =
      inventarios_com_diferenca,
    
    duplicacoes_completas =
      duplicacoes_completas
    
  ),
  
  arquivo_relatorio,
  
  overwrite = TRUE
  
)


