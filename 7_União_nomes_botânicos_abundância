  ),
  
  "\nGrupos sem correspondência consolidados:",
  sum(
    linhas_realmente_unidas$identificacao ==
      "sem_correspondencia",
    na.rm = TRUE
  ),
  
  "\nIdentificações incompletas consolidadas:",
  sum(
    linhas_realmente_unidas$identificacao == "incompleta",
    na.rm = TRUE
  ),
  
  "\nTotal de grupos com linhas consolidadas:",
  nrow(linhas_realmente_unidas),
  
  "\nLinhas removidas pela consolidação:",
  numero_linhas_removidas,
  
  "\nLinhas na matriz final:",
  nrow(matriz_final),
  
  "\nInventários na matriz final:",
  length(colunas_inventarios),
  
  "\nIdentificações completas na matriz final:",
  numero_completas_finais,
  
  "\nIdentificações incompletas na matriz final:",
  numero_incompletas_finais,
  
  "\nSem correspondência na matriz final:",
  numero_sem_correspondencia_finais,
  
  "\nIdentificações incompletas alteradas:",
  nrow(incompletas_alteradas),
  
  "\nProblemas na conversão numérica:",
  nrow(problemas_conversao),
  
  "\nValores negativos:",
  nrow(valores_negativos),
  
  "\nDuplicações completas na matriz final:",
  nrow(duplicacoes_completas_finais),
  
  "\nDuplicações sem correspondência na matriz final:",
  nrow(duplicacoes_sem_correspondencia_finais),
  
  "\nNomes incompletos repetidos mantidos separadamente:",
  nrow(duplicacoes_incompletas_finais),
  
  "\nAbundância total antes:",
  abundancia_total_antes,
  
  "\nAbundância total depois:",
  abundancia_total_depois,
  
  "\nDiferença na abundância total:",
  diferenca_abundancia,
  
  "\n==========================================\n"
)


