    completude =
      
      as.integer(
        !is.na(
          familia
        )
      ) +
      
      as.integer(
        !is.na(
          genero
        )
      ) +
      
      as.integer(
        !is.na(
          LifeForm
        )
      ),
    
    prioridade_fonte =
      case_when(
        
        fonte_cruzamento ==
          "REFLORA" ~
          
          1L,
        
        fonte_cruzamento ==
          "POWO_nome_aceito" ~
          
          2L,
        
        fonte_cruzamento ==
          "POWO_nome_encontrado" ~
          
          3L,
        
        TRUE ~
          
          4L
        
      )
    
  )


