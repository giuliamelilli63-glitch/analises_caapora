# ============================================================
# PROJETO CAAPORÃ
# TERRAS INDÍGENAS - FUNAI
#
# ETAPA 4
# COBERTURA POR TERRAS INDÍGENAS
#
# Matriz: ocorrência
# Buffers: 10, 25, 50 e 100 km
#
# Métrica principal:
# % da área do buffer ocupada por Terras Indígenas
# ============================================================


# ------------------------------------------------------------
# 0. Pacotes
# ------------------------------------------------------------

library(sf)
library(dplyr)


# ------------------------------------------------------------
# 1. Pastas
# ------------------------------------------------------------

pasta_funai <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/terras_indigenas/FUNAI"
)

pasta_processado <- file.path(
  pasta_funai,
  "02_processado"
)

pasta_variaveis <- file.path(
  pasta_funai,
  "03_variaveis"
)


# ------------------------------------------------------------
# 2. Abrir TIs corrigidas
# ------------------------------------------------------------

arquivo_tis <- file.path(
  pasta_processado,
  "FUNAI_terras_indigenas_geometrias_corrigidas.gpkg"
)

tis <- st_read(
  arquivo_tis,
  quiet = TRUE
)

cat(
  "\nTIs carregadas:",
  nrow(tis),
  "\n"
)


# ------------------------------------------------------------
# 3. Abrir inventários
# ------------------------------------------------------------

arquivo_inventarios <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/inventarios/",
  "inventarios_selecionados_coordenadas_validas.csv"
)

inventarios <- read.csv2(
  arquivo_inventarios,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)

cat(
  "Inventários carregados:",
  nrow(inventarios),
  "\n"
)


# ------------------------------------------------------------
# 4. Transformar inventários em sf
# ------------------------------------------------------------

inventarios_sf <- st_as_sf(
  inventarios,
  coords = c(
    "longitude",
    "latitude"
  ),
  crs = 4326,
  remove = FALSE
)


# ------------------------------------------------------------
# 5. Projetar para CRS métrico
# ------------------------------------------------------------
#
# SIRGAS 2000 / Brazil Polyconic
# EPSG:5880
#
# ------------------------------------------------------------

inventarios_m <- st_transform(
  inventarios_sf,
  5880
)

tis_m <- st_transform(
  tis,
  5880
)


# ------------------------------------------------------------
# 6. Unir geometrias das TIs
# ------------------------------------------------------------
# ------------------------------------------------------------
# 6. Ajustar precisão das geometrias projetadas
# ------------------------------------------------------------

cat(
  "\nPreparando geometrias das TIs...\n"
)

tis_m <- st_make_valid(
  tis_m
)

# precisão de 1 metro
tis_m <- st_set_precision(
  tis_m,
  1
)

tis_m <- st_make_valid(
  tis_m
)

cat(
  "Geometrias inválidas após projeção:",
  sum(
    !st_is_valid(tis_m)
  ),
  "\n"
)


# ------------------------------------------------------------
# 7. Definir buffers
# ------------------------------------------------------------

buffers_km <- c(
  10,
  25,
  50,
  100
)


# ------------------------------------------------------------
# 8. Criar tabela de resultado
# ------------------------------------------------------------

cobertura_tis <- inventarios %>%
  select(
    ponto,
    latitude,
    longitude
  )


# ------------------------------------------------------------
# 9. Calcular cobertura para cada escala
# ------------------------------------------------------------

for (raio_km in buffers_km) {
  
  cat(
    "\n========================================\n",
    "BUFFER:",
    raio_km,
    "km\n",
    "========================================\n"
  )
  
  
  # ----------------------------------------------------------
  # 9.1 Criar buffers
  # ----------------------------------------------------------
  
  raio_m <- raio_km * 1000
  
  cat(
    "Criando buffers...\n"
  )
  
  buffers <- st_buffer(
    inventarios_m,
    dist = raio_m
  )
  
  
  # ----------------------------------------------------------
  # 9.2 Área dos buffers
  # ----------------------------------------------------------
  
  area_buffer_km2 <- as.numeric(
    st_area(
      buffers
    )
  ) / 1e6
  
  
  # ----------------------------------------------------------
  # 9.3 Identificar TIs que intersectam cada buffer
  # ----------------------------------------------------------
  
  cat(
    "Identificando TIs no entorno dos inventários...\n"
  )
  
  inter_ti <- st_intersects(
    buffers,
    tis_m
  )
  
  
  # ----------------------------------------------------------
  # 9.4 Vetores de resultado
  # ----------------------------------------------------------
  
  area_ti_km2 <- numeric(
    nrow(buffers)
  )
  
  n_tis_buffer <- integer(
    nrow(buffers)
  )
  
  
  # ----------------------------------------------------------
  # 9.5 Calcular área ocupada por TIs
  # ----------------------------------------------------------
  
  cat(
    "Calculando cobertura territorial indígena...\n"
  )
  
  for (i in seq_len(
    nrow(buffers)
  )) {
    
    ids <- inter_ti[[i]]
    
    n_tis_buffer[i] <- length(ids)
    
    
    # nenhuma TI no buffer
    if (length(ids) == 0) {
      
      area_ti_km2[i] <- 0
      
      next
    }
    
    
    # --------------------------------------------------------
    # Selecionar apenas TIs relevantes para este inventário
    # --------------------------------------------------------
    
    tis_i <- tis_m[
      ids,
    ]
    
    
    # --------------------------------------------------------
    # Recortar as TIs pelo buffer
    # --------------------------------------------------------
    
    partes <- suppressWarnings(
      st_intersection(
        st_geometry(tis_i),
        st_geometry(buffers[i, ])
      )
    )
    
    
    if (length(partes) == 0) {
      
      area_ti_km2[i] <- 0
      
      next
    }
    
    
    # --------------------------------------------------------
    # Corrigir novamente as partes resultantes
    # --------------------------------------------------------
    
    partes <- st_make_valid(
      partes
    )
    
    
    # --------------------------------------------------------
    # Evitar dupla contagem quando houver TIs sobrepostas
    # --------------------------------------------------------
    
    if (length(partes) == 1) {
      
      area_ti_km2[i] <- as.numeric(
        st_area(
          partes
        )
      ) / 1e6
      
    } else {
      
      partes_unidas <- tryCatch(
        
        st_union(
          partes
        ),
        
        error = function(e) {
          
          # nova tentativa com precisão ajustada
          partes2 <- st_set_precision(
            partes,
            1
          )
          
          partes2 <- st_make_valid(
            partes2
          )
          
          st_union(
            partes2
          )
        }
      )
      
      
      area_ti_km2[i] <- sum(
        as.numeric(
          st_area(
            partes_unidas
          )
        ),
        na.rm = TRUE
      ) / 1e6
    }
  }
  
  
  # ----------------------------------------------------------
  # 9.6 Porcentagem de cobertura
  # ----------------------------------------------------------
  
  pct_ti <- (
    area_ti_km2 /
      area_buffer_km2
  ) * 100
  
  
  # ----------------------------------------------------------
  # 9.7 Adicionar à tabela
  # ----------------------------------------------------------
  
  cobertura_tis[[
    paste0(
      "area_ti_km2_",
      raio_km,
      "km"
    )
  ]] <- area_ti_km2
  
  
  cobertura_tis[[
    paste0(
      "pct_cobertura_ti_",
      raio_km,
      "km"
    )
  ]] <- pct_ti
  
  
  cobertura_tis[[
    paste0(
      "n_tis_",
      raio_km,
      "km"
    )
  ]] <- n_tis_buffer
  
  
  # ----------------------------------------------------------
  # 9.8 Resumo
  # ----------------------------------------------------------
  
  cat(
    "\nÁrea coberta por TIs (km²):\n"
  )
  
  print(
    summary(
      area_ti_km2
    )
  )
  
  
  cat(
    "\n% de cobertura por TIs:\n"
  )
  
  print(
    summary(
      pct_ti
    )
  )
  
  
  cat(
    "\nInventários sem TI no buffer:",
    sum(
      n_tis_buffer == 0
    ),
    "\n"
  )
  
  
  cat(
    "Número máximo de TIs em um buffer:",
    max(
      n_tis_buffer
    ),
    "\n"
  )
  
  
  # ----------------------------------------------------------
  # 9.9 Liberar memória
  # ----------------------------------------------------------
  
  rm(
    buffers,
    inter_ti,
    area_buffer_km2,
    area_ti_km2,
    pct_ti,
    n_tis_buffer
  )
  
  gc()
}


