# ------------------------------------------------------------
# 0. Pacotes
# ------------------------------------------------------------

library(sf)
library(dplyr)


# ------------------------------------------------------------
# 1. Pastas
# ------------------------------------------------------------

pasta_funai <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/terras_indigenas/FUNAI"
)

pasta_processado <- file.path(
  pasta_funai,
  "02_processado"
)

pasta_variaveis <- file.path(
  pasta_funai,
  "03_variaveis"
)

dir.create(
  pasta_variaveis,
  recursive = TRUE,
  showWarnings = FALSE
)


# ------------------------------------------------------------
# 2. Arquivo das TIs corrigidas
# ------------------------------------------------------------

arquivo_tis <- file.path(
  pasta_processado,
  "FUNAI_terras_indigenas_geometrias_corrigidas.gpkg"
)

tis <- st_read(
  arquivo_tis,
  quiet = TRUE
)

cat(
  "\nTIs carregadas:",
  nrow(tis),
  "\n"
)


# ------------------------------------------------------------
# 3. Abrir coordenadas dos inventários selecionados
# ------------------------------------------------------------

arquivo_inventarios <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis_humanas/inventarios/",
  "inventarios_selecionados_coordenadas_validas.csv"
)

inventarios <- read.csv2(
  arquivo_inventarios,
  header = TRUE,
  stringsAsFactors = FALSE,
  check.names = FALSE,
  fileEncoding = "latin1"
)

cat(
  "\nInventários carregados:",
  nrow(inventarios),
  "\n"
)


# ------------------------------------------------------------
# 4. Conferir coordenadas
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "CONFERÊNCIA DOS INVENTÁRIOS\n",
  "========================================\n"
)

cat(
  "\nTotal:",
  nrow(inventarios),
  "\n"
)

cat(
  "Latitude ausente:",
  sum(is.na(inventarios$latitude)),
  "\n"
)

cat(
  "Longitude ausente:",
  sum(is.na(inventarios$longitude)),
  "\n"
)

cat(
  "Códigos duplicados:",
  sum(duplicated(inventarios$ponto)),
  "\n"
)


# ------------------------------------------------------------
# 5. Transformar inventários em pontos
# ------------------------------------------------------------

inventarios_sf <- st_as_sf(
  inventarios,
  coords = c(
    "longitude",
    "latitude"
  ),
  crs = 4326,
  remove = FALSE
)


# ------------------------------------------------------------
# 6. Padronizar CRS geográfico
# ------------------------------------------------------------
#
# As TIs estão originalmente em SIRGAS 2000.
# Os inventários estão em WGS84.
#
# Primeiro colocamos ambos em SIRGAS 2000.
# ------------------------------------------------------------

inventarios_sf <- st_transform(
  inventarios_sf,
  4674
)

tis <- st_transform(
  tis,
  4674
)


# ------------------------------------------------------------
# 7. Identificar inventários que estão dentro de TIs
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "INVENTÁRIOS DENTRO DE TIs\n",
  "========================================\n"
)

dentro_ti <- lengths(
  st_intersects(
    inventarios_sf,
    tis
  )
) > 0

cat(
  "\nInventários dentro de alguma TI:",
  sum(dentro_ti),
  "\n"
)

cat(
  "Inventários fora de TIs:",
  sum(!dentro_ti),
  "\n"
)


# ------------------------------------------------------------
# 8. Projeção métrica para cálculo das distâncias
# ------------------------------------------------------------
#
# EPSG:5880 = SIRGAS 2000 / Brazil Polyconic
#
# Usaremos a projeção métrica para que as distâncias
# sejam calculadas em metros.
# ------------------------------------------------------------

inventarios_m <- st_transform(
  inventarios_sf,
  5880
)

tis_m <- st_transform(
  tis,
  5880
)


# ------------------------------------------------------------
# 9. Encontrar a TI mais próxima
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "CALCULANDO TI MAIS PRÓXIMA\n",
  "========================================\n"
)

indice_ti_proxima <- st_nearest_feature(
  inventarios_m,
  tis_m
)

cat(
  "\nTIs mais próximas identificadas.\n"
)


# ------------------------------------------------------------
# 10. Calcular distância até a TI mais próxima
# ------------------------------------------------------------

cat(
  "\nCalculando distâncias...\n"
)

distancia_m <- st_distance(
  inventarios_m,
  tis_m[indice_ti_proxima, ],
  by_element = TRUE
)

distancia_km <- as.numeric(
  distancia_m
) / 1000


# ------------------------------------------------------------
# 11. Garantir distância zero para inventários dentro de TI
# ------------------------------------------------------------

distancia_km[
  dentro_ti
] <- 0


# ------------------------------------------------------------
# 12. Recuperar informações da TI mais próxima
# ------------------------------------------------------------

ti_proxima <- st_drop_geometry(
  tis[
    indice_ti_proxima,
  ]
)


# ------------------------------------------------------------
# 13. Criar tabela final
# ------------------------------------------------------------

resultado_ti <- inventarios %>%
  mutate(
    
    dentro_terra_indigena =
      dentro_ti,
    
    distancia_ti_mais_proxima_km =
      distancia_km,
    
    codigo_ti_mais_proxima =
      ti_proxima$terrai_cod,
    
    nome_ti_mais_proxima =
      ti_proxima$terrai_nom,
    
    etnia_ti_mais_proxima =
      ti_proxima$etnia_nome,
    
    fase_ti_mais_proxima =
      ti_proxima$fase_ti,
    
    modalidade_ti_mais_proxima =
      ti_proxima$modalidade
  )


# ------------------------------------------------------------
# 14. Estatísticas das distâncias
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "DISTÂNCIA À TI MAIS PRÓXIMA\n",
  "========================================\n"
)

print(
  summary(
    resultado_ti$distancia_ti_mais_proxima_km
  )
)


# ------------------------------------------------------------
# 15. Número de inventários dentro de TIs
# ------------------------------------------------------------

cat(
