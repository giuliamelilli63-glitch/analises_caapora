# ------------------------------------------------------------
# 9. Função para baixar uma camada
# ------------------------------------------------------------

baixar_soilgrids <- function(
    propriedade,
  profundidade
) {
  
  nome_camada <- paste(
    propriedade,
    profundidade,
    "mean",
    sep = "_"
  )
  
  
  cat(
    "\n========================================\n",
    nome_camada,
    "\n========================================\n"
  )
  
  
  # URL VRT remota
  
  url_vrt <- paste0(
    webdav,
    propriedade,
    "/",
    nome_camada,
    ".vrt"
  )
  
  
  # arquivo final
  
  arquivo_saida <- file.path(
    pasta_brasil,
    paste0(
      nome_camada,
      "_Brasil_250m.tif"
    )
  )
  
  
  # não baixar novamente se já existir
  
  if (file.exists(arquivo_saida)) {
    
    cat(
      "Arquivo já existe. Pulando:\n",
      arquivo_saida,
      "\n"
    )
    
    return(
      arquivo_saida
    )
  }
  
  
  cat(
    "Abrindo VRT remoto...\n"
  )
  
  
  r <- rast(
    url_vrt
  )
  
  
  cat(
    "Raster remoto acessado.\n"
  )
  
  
  # ----------------------------------------------------------
  # Recortar usando extensão do Brasil em Homolosine
  # ----------------------------------------------------------
  
  ext_brasil <- ext(
    bbox["xmin"],
    bbox["xmax"],
    bbox["ymin"],
    bbox["ymax"]
  )
  
  
  cat(
    "Recortando para o Brasil...\n"
  )
  
  
  r_brasil <- crop(
    r,
    ext_brasil
  )
  
  
  # ----------------------------------------------------------
  # Máscara territorial
  # ----------------------------------------------------------
  
  brasil_vect_igh <- vect(
    brasil_igh
  )
  
  
  r_brasil <- mask(
    r_brasil,
    brasil_vect_igh
  )
  
  
  # ----------------------------------------------------------
  # Salvar
  # ----------------------------------------------------------
  
  cat(
    "Salvando GeoTIFF...\n"
  )
  
  
  writeRaster(
    r_brasil,
    arquivo_saida,
    overwrite = TRUE,
    gdal = c(
      "COMPRESS=DEFLATE"
    )
  )
  
  
  cat(
    "Salvo:\n",
    arquivo_saida,
    "\n"
  )
  
  
  rm(
    r,
    r_brasil
  )
  
  gc()
  
  
  return(
    arquivo_saida
  )
}


# ------------------------------------------------------------
# 10. Baixar as 21 camadas
# ------------------------------------------------------------

arquivos_baixados <- character()


for (prop in propriedades) {
  
  for (prof in profundidades) {
    
    resultado <- tryCatch(
      
      {
        
        baixar_soilgrids(
          propriedade = prop,
          profundidade = prof
        )
        
      },
      
      error = function(e) {
        
        cat(
          "\nERRO:\n",
          prop,
          prof,
          "\n",
          conditionMessage(e),
