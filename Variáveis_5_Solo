# ------------------------------------------------------------
# 4. Fatores de conversão
# ------------------------------------------------------------
#
# SoilGrids armazena valores inteiros escalados.
#
# bdod  -> cg/cm3       dividir por 100
# cec   -> mmol(c)/kg   dividir por 10 para cmol(c)/kg
# clay  -> g/kg         dividir por 10 para %
# silt  -> g/kg         dividir por 10 para %
# sand  -> g/kg         dividir por 10 para %
# phh2o -> pH x 10      dividir por 10
# soc   -> dg/kg        dividir por 10 para g/kg
#
# ------------------------------------------------------------

fatores <- c(
  bdod  = 100,
  cec   = 10,
  clay  = 10,
  silt  = 10,
  sand  = 10,
  phh2o = 10,
  soc   = 10
)


# ------------------------------------------------------------
# 5. Função para gerar 0-30 cm
# ------------------------------------------------------------

gerar_030 <- function(propriedade) {
  
  cat(
    "\n========================================\n",
    "Processando:",
    propriedade,
    "\n========================================\n"
  )
  
  
  # ----------------------------------------------------------
  # Arquivos das três profundidades
  # ----------------------------------------------------------
  
  arquivo_05 <- file.path(
    pasta_entrada,
    paste0(
      propriedade,
      "_0-5cm_mean_Brasil_250m.tif"
    )
  )
  
  arquivo_515 <- file.path(
    pasta_entrada,
    paste0(
      propriedade,
      "_5-15cm_mean_Brasil_250m.tif"
    )
  )
  
  arquivo_1530 <- file.path(
    pasta_entrada,
    paste0(
      propriedade,
      "_15-30cm_mean_Brasil_250m.tif"
    )
  )
  
  
  # ----------------------------------------------------------
  # Conferir arquivos
  # ----------------------------------------------------------
  
  arquivos <- c(
    arquivo_05,
    arquivo_515,
    arquivo_1530
  )
  
  if (!all(file.exists(arquivos))) {
    
    stop(
      paste(
        "Faltam arquivos para:",
        propriedade
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Abrir rasters
  # ----------------------------------------------------------
  
  r05 <- rast(
    arquivo_05
  )
  
  r515 <- rast(
    arquivo_515
  )
  
  r1530 <- rast(
    arquivo_1530
  )
  
  
  # ----------------------------------------------------------
  # Conferir geometria
  # ----------------------------------------------------------
  
  geometria_ok <- compareGeom(
    r05,
    r515,
    r1530,
    stopOnError = FALSE
  )
  
  if (!geometria_ok) {
    
    stop(
      paste(
        "As profundidades de",
        propriedade,
        "não possuem a mesma geometria."
      )
    )
  }
  
  
  # ----------------------------------------------------------
  # Média ponderada 0-30 cm
  #
  # 0-5   = 5 cm
  # 5-15  = 10 cm
  # 15-30 = 15 cm
  # ----------------------------------------------------------
  
  cat(
    "Calculando média ponderada 0-30 cm...\n"
  )
  
  r030 <- (
    r05 * 5 +
      r515 * 10 +
      r1530 * 15
  ) / 30
  
  
  # ----------------------------------------------------------
  # Converter unidade
  # ----------------------------------------------------------
  
  r030 <- r030 / fatores[
    propriedade
  ]
  
  
  # ----------------------------------------------------------
  # Nome da camada
  # ----------------------------------------------------------
  
  names(
    r030
  ) <- paste0(
    propriedade,
    "_0_30cm"
  )
  
  
  # ----------------------------------------------------------
  # Arquivo de saída
  # ----------------------------------------------------------
  
  arquivo_saida <- file.path(
    pasta_saida,
    paste0(
      "SoilGrids_",
      propriedade,
      "_0-30cm_Brasil_250m.tif"
    )
  )
  
  
  # ----------------------------------------------------------
  # Salvar
  # ----------------------------------------------------------
  
  writeRaster(
    r030,
    arquivo_saida,
    overwrite = TRUE,
    gdal = c(
      "COMPRESS=DEFLATE"
    )
  )
  
  
  cat(
    "Salvo:\n",
    arquivo_saida,
    "\n"
  )
  
  
  # ----------------------------------------------------------
  # Estatísticas
  # ----------------------------------------------------------
  
  estatisticas <- global(
    r030,
    fun = c(
      "min",
      "max",
      "mean"
    ),
    na.rm = TRUE
  )
  
  
  print(
    estatisticas
  )
  
  
  rm(
    r05,
    r515,
    r1530,
    r030
  )
  
  gc()
  
  
  return(
    arquivo_saida
  )
}


# ------------------------------------------------------------
# 6. Processar as 7 propriedades
# ------------------------------------------------------------

arquivos_030 <- character()

for (prop in propriedades) {
  
  resultado <- tryCatch(
    
    {
      
