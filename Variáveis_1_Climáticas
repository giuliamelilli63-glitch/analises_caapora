# ------------------------------------------------------------
# 8. Baixar BIO1-BIO19
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "INICIANDO DOWNLOAD BIO1-BIO19\n",
  "========================================\n"
)

for (i in 1:19) {
  
  destino <- arquivos_globais[i]
  
  cat(
    "\n----------------------------------------\n",
    "BIO", i, " de 19\n",
    "----------------------------------------\n",
    sep = ""
  )
  
  if (file.exists(destino)) {
    
    cat(
      "Arquivo já existe:",
      basename(destino),
      "\n"
    )
    
  } else {
    
    cat(
      "Baixando:",
      basename(destino),
      "\n"
    )
    
    download.file(
      url = urls[i],
      destfile = destino,
      mode = "wb",
      method = "libcurl",
      quiet = FALSE
    )
    
  }
  
}


# ------------------------------------------------------------
# 9. Conferir se os 19 arquivos existem
# ------------------------------------------------------------

existem <- file.exists(
  arquivos_globais
)

cat(
  "\n========================================\n",
  "ARQUIVOS ENCONTRADOS\n",
  "========================================\n"
)

print(
  data.frame(
    BIO = paste0("BIO", 1:19),
    existe = existem
  )
)

if (!all(existem)) {
  
  stop(
    "Nem todos os arquivos foram baixados."
  )
  
}


# ------------------------------------------------------------
# 10. Conferência individual dos arquivos
# ------------------------------------------------------------
#
# Aqui conferimos:
# - tamanho
# - extensão
# - resolução
# - CRS
#
# ------------------------------------------------------------

resultado_teste <- data.frame(
  BIO = paste0("BIO", 1:19),
  arquivo = basename(arquivos_globais),
  tamanho_MB = NA_real_,
  valido = FALSE,
  xmin = NA_real_,
  xmax = NA_real_,
  ymin = NA_real_,
  ymax = NA_real_,
  res_x = NA_real_,
  res_y = NA_real_
)


for (i in 1:19) {
  
  arquivo <- arquivos_globais[i]
  
  resultado_teste$tamanho_MB[i] <-
    file.info(arquivo)$size / 1024^2
  
  teste <- tryCatch({
    
    r <- rast(
      arquivo
    )
    
    e <- ext(
      r
    )
    
    resultado_teste$valido[i] <- TRUE
    
    resultado_teste$xmin[i] <- xmin(e)
    resultado_teste$xmax[i] <- xmax(e)
    
    resultado_teste$ymin[i] <- ymin(e)
    resultado_teste$ymax[i] <- ymax(e)
    
    resultado_teste$res_x[i] <- res(r)[1]
    resultado_teste$res_y[i] <- res(r)[2]
    
    TRUE
    
  }, error = function(e) {
    
    cat(
      "\nERRO em BIO",
      i,
      ":\n",
      conditionMessage(e),
      "\n"
    )
    
    FALSE
    
  })
  
}


print(
  resultado_teste
)


# ------------------------------------------------------------
# 11. Conferir geometria esperada
# ------------------------------------------------------------

resultado_teste$geometria_ok <-
  resultado_teste$valido &
  abs(resultado_teste$res_x - 0.008333333) < 0.000001 &
  abs(resultado_teste$res_y - 0.008333333) < 0.000001 &
  resultado_teste$xmin < -179 &
  resultado_teste$xmax > 179 &
  resultado_teste$ymin < -89 &
  resultado_teste$ymax > 83


print(
  resultado_teste[
    ,
    c(
      "BIO",
      "tamanho_MB",
      "valido",
      "geometria_ok"
    )
  ]
)


if (!all(resultado_teste$geometria_ok)) {
  
  cat(
    "\nATENÇÃO:\n",
    "Existem arquivos com geometria inesperada.\n"
  )
  
  print(
    resultado_teste[
      !resultado_teste$geometria_ok,
    ]
  )
  
  stop(
    "Corrija os arquivos problemáticos antes de continuar."
  )
  
}


# ------------------------------------------------------------
# 12. Baixar limite do Brasil
# ------------------------------------------------------------

cat(
  "\nBaixando/carregando limite do Brasil...\n"
)

brasil <- geodata::gadm(
  country = "BRA",
  level = 0,
  path = pasta_limite
)


# ------------------------------------------------------------
# 13. Usar BIO1 como referência espacial
# ------------------------------------------------------------

bio_referencia <- rast(
  arquivos_globais[1]
)

brasil_chelsa <- project(
  brasil,
  crs(bio_referencia)
)


# ------------------------------------------------------------
# 14. Extensão aproximada do Brasil para teste de leitura
# ------------------------------------------------------------
#
# Esse teste força a leitura dos pixels do GeoTIFF.
# Assim conseguimos detectar arquivos parcialmente
# corrompidos antes do processamento completo.
# ------------------------------------------------------------

ext_teste <- ext(
  -75,
  -30,
  -35,
  6
)


# ------------------------------------------------------------
# 15. Testar leitura real dos 19 arquivos
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "TESTANDO LEITURA DOS RASTERS\n",
  "========================================\n"
)

leitura_ok <- logical(
  19
)

for (i in 1:19) {
  
  cat(
    "Testando BIO",
    i,
    "...\n"
  )
  
  leitura_ok[i] <- tryCatch({
    
    r <- rast(
      arquivos_globais[i]
    )
    
    teste <- crop(
      r,
      ext_teste
    )
    
    # Forçar leitura dos valores
    global(
      teste,
      "mean",
      na.rm = TRUE
    )
    
    TRUE
    
  }, error = function(e) {
    
    cat(
      "ERRO BIO",
      i,
      ":",
      conditionMessage(e),
      "\n"
    )
    
    FALSE
    
  })
  
}


teste_leitura <- data.frame(
  BIO = paste0("BIO", 1:19),
  leitura_ok = leitura_ok
)

print(
  teste_leitura
)


if (!all(leitura_ok)) {
  
  cat(
    "\nArquivos problemáticos:\n"
  )
  
  print(
    teste_leitura[
      !teste_leitura$leitura_ok,
    ]
  )
  
  stop(
    "Alguns arquivos parecem corrompidos. Baixe-os novamente."
  )
  
}


# ------------------------------------------------------------
# 16. Recortar BIO1-BIO19 individualmente
# ------------------------------------------------------------

cat(
  "\n========================================\n",
  "RECORTANDO PARA O BRASIL\n",
  "========================================\n"
)

falhas <- integer()


for (i in 1:19) {
  
  cat(
    "\n----------------------------------------\n",
    "Processando BIO",
    i,
    " de 19\n",
    "----------------------------------------\n",
    sep = ""
  )
  
  
  arquivo_saida <- file.path(
    pasta_brasil,
    paste0(
      "CHELSA_bio",
      i,
      "_Brasil_",
      periodo_chelsa,
      "_V",
      versao_chelsa,
      ".tif"
    )
  )
  
  
  resultado <- tryCatch({
    
    bio <- rast(
      arquivos_globais[i]
    )
    
    names(bio) <- paste0(
      "bio",
      i
    )
    
    
    # Recortar pela extensão
    
    bio_crop <- crop(
      bio,
      brasil_chelsa
    )
    
    
    # Aplicar máscara
    
    bio_brasil <- mask(
      bio_crop,
      brasil_chelsa
    )
    
    
    # Salvar
    
    writeRaster(
      bio_brasil,
      arquivo_saida,
      overwrite = TRUE,
      gdal = c(
        "COMPRESS=DEFLATE",
        "PREDICTOR=2"
      )
    )
    
    
    cat(
      "Salvo:",
      basename(arquivo_saida),
      "\n"
    )
    
    
    rm(
      bio,
      bio_crop,
      bio_brasil
    )
    
    gc()
    
    TRUE
    
  }, error = function(e) {
    
    cat(
      "\nERRO NO BIO",
      i,
      ":\n",
      conditionMessage(e),
      "\n"
    )
    
    FALSE
    
  })
  
  
  if (!resultado) {
    
    falhas <- c(
      falhas,
      i
    )
    
  }
  
}


# ------------------------------------------------------------
# 17. Conferir falhas
# ------------------------------------------------------------

if (length(falhas) > 0) {
  
  cat(
    "\n========================================\n",
    "ATENÇÃO\n",
    "========================================\n",
    "BIOs que falharam:",
    paste(
      falhas,
      collapse = ", "
    ),
    "\n"
  )
  
} else {
  
  cat(
    "\nTodos os BIOs foram recortados com sucesso.\n"
  )
  
}


