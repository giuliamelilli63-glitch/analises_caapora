# ============================================================
# PROJETO CAAPORÃ
# VARIÁVEIS CLIMÁTICAS - CHELSA BIO1-BIO19
#
# Objetivos:
# 1. Baixar novamente BIO1-BIO19 do CHELSA v2.1
# 2. Conferir se todos os arquivos são válidos
# 3. Recortar cada BIO individualmente para o Brasil
# 4. Salvar os 19 rasters recortados
# 5. Criar um SpatRaster final BIO1-BIO19
#
# CHELSA v2.1
# Climatologia: 1981-2010
# Resolução: ~1 km / 30 arc-seconds
# ============================================================


# ------------------------------------------------------------
# 0. Pacotes
# ------------------------------------------------------------

pacotes <- c(
  "terra",
  "geodata"
)

instalar <- pacotes[
  !pacotes %in% installed.packages()[, "Package"]
]

if (length(instalar) > 0) {
  install.packages(instalar)
}

library(terra)
library(geodata)


# ------------------------------------------------------------
# 1. Pastas
# ------------------------------------------------------------

pasta_base <- paste0(
  "C:/Users/giuli/OneDrive/Documentos/Caapora/",
  "variaveis/clima/CHELSA"
)

pasta_bruto <- file.path(
  pasta_base,
  "01_bruto_global"
)

pasta_brasil <- file.path(
  pasta_base,
  "02_recortado_brasil"
)

pasta_limite <- file.path(
  pasta_base,
  "limite_brasil"
)

dir.create(
  pasta_bruto,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  pasta_brasil,
  recursive = TRUE,
  showWarnings = FALSE
)

dir.create(
  pasta_limite,
  recursive = TRUE,
  showWarnings = FALSE
)


# ------------------------------------------------------------
# 2. Pasta temporária do terra
# ------------------------------------------------------------
#
# IMPORTANTE:
# Evitar OneDrive para arquivos temporários grandes.
# ------------------------------------------------------------

pasta_temp <- "C:/temp_terra"

dir.create(
  pasta_temp,
  recursive = TRUE,
  showWarnings = FALSE
)

terraOptions(
  tempdir = pasta_temp,
  memfrac = 0.6,
  progress = 1
)

terraOptions()


# ------------------------------------------------------------
# 3. Informações do CHELSA
# ------------------------------------------------------------

versao_chelsa <- "2.1"
periodo_chelsa <- "1981-2010"

cat(
  "\n========================================\n",
  "CHELSA BIOCLIM\n",
  "========================================\n",
  "Versão: ", versao_chelsa, "\n",
  "Período: ", periodo_chelsa, "\n",
  "BIO1-BIO19\n",
  "========================================\n\n",
  sep = ""
)


# ------------------------------------------------------------
# 4. Criar nomes dos arquivos
# ------------------------------------------------------------

bios <- 1:19

nomes_arquivos <- paste0(
  "CHELSA_bio",
  bios,
  "_",
  periodo_chelsa,
  "_V.",
  versao_chelsa,
  ".tif"
)


# ------------------------------------------------------------
# 5. URLs
# ------------------------------------------------------------

url_base <- paste0(
  "https://os.zhdk.cloud.switch.ch/",
  "chelsav2/GLOBAL/climatologies/",
  periodo_chelsa,
  "/bio/"
)

urls <- paste0(
  url_base,
  nomes_arquivos
)


# ------------------------------------------------------------
# 6. Arquivos de destino
# ------------------------------------------------------------

arquivos_globais <- file.path(
  pasta_bruto,
  nomes_arquivos
)


